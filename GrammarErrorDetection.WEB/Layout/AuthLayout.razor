@inherits LayoutComponentBase

<main class="auth-shell grid lg:grid-cols-[1.03fr_1fr]">
    <section class="auth-brand relative isolate overflow-hidden px-7 py-8 text-white sm:px-12 lg:px-[8%] lg:py-14" aria-label="CETI La Paz">
        <div class="auth-brand-identity relative z-10 flex items-center gap-5 sm:gap-7">
            <img src="images/ceti-logo.png" alt="CETI · LIN – UMSA" width="144" height="144" class="size-20 rounded-full bg-white object-contain p-1 sm:size-28 xl:size-36" />
            <span class="h-14 w-px bg-white/60 sm:h-20" aria-hidden="true"></span>
            <p class="text-sm font-semibold tracking-[0.24em] sm:text-lg xl:text-xl">CETI <span class="text-brand-red">·</span> LA PAZ</p>
        </div>
        <div class="auth-brand-message relative z-10 mt-10 max-w-2xl pb-3 lg:mt-12 xl:mt-14">
            <h1 class="auth-heading font-bold">Conecta con nuevas posibilidades<span class="text-brand-red">.</span></h1>
            <p class="mt-5 max-w-lg text-base leading-relaxed text-blue-50/95 sm:text-xl xl:text-2xl">Tu espacio de aprendizaje, en un solo lugar.</p>
        </div>
    </section>

    <section class="auth-panel flex flex-col bg-white" aria-labelledby="auth-title">
        <div class="auth-content mx-auto my-auto w-full max-w-lg">
            @Body
        </div>
        <footer class="auth-footer text-center text-xs text-muted sm:text-sm">
            <p class="font-semibold tracking-[0.2em]">CETI · LIN – UMSA</p>
            <p class="mt-2">La Paz, Bolivia</p>
        </footer>
    </section>
</main>
