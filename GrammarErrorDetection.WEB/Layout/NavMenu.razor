@implements IDisposable
@inject NavigationManager Navigation
@inject GrammarErrorDetection.Services.Services.Auth.AuthSessionState Session
@using GrammarErrorDetection.WEB.Navigation
@using System.Globalization
@using System.Text

@* Celular: el menú queda oculto y solo se muestra este botón; al abrirlo, el menú completo se desliza encima del contenido. *@
<button type="button" class="gp-mobile-toggle" @onclick="Toggle" aria-label="@(expanded ? L["Cerrar menú"] : L["Abrir menú"])"
        aria-expanded="@(expanded ? "true" : "false")" aria-controls="gp-navigation">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(expanded ? L["M6 6l12 12M18 6 6 18"] : L["M4 6h16M4 12h16M4 18h16"])" /></svg>
</button>
@if (expanded)
{
    <button type="button" class="gp-nav-backdrop" @onclick="Collapse" aria-label="@L["Cerrar navegación"]"></button>
}
<aside class="gp-sidebar @(expanded ? "is-expanded" : "")" aria-label="@L["Menú principal"]" @onkeydown="HandleKey">
    <a class="gp-brand" href="home" aria-label="@L["Grammar Practice · Inicio"]">
        <img src="images/gp-logo.png" width="34" height="34" alt="" />
        <span>@L["Grammar"]<span class="gp-brand-dot">.</span></span>
    </a>
    <div class="gp-nav-main" id="gp-navigation">
        @if (expanded)
        {
            <div class="gp-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
                <label class="gp-sr-only" for="gp-menu-search">@L["Buscar opciones"]</label>
                <input id="gp-menu-search" type="search" placeholder="@L["Buscar opciones…"]" autocomplete="off" @bind="search" @bind:event="oninput" />
            </div>
        }
        else
        {
            <button type="button" class="gp-rail-button" @onclick="Expand" aria-label="@L["Buscar opciones"]" title="@L["Buscar opciones"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
            </button>
        }
        @if (Session.Current is not null)
        {
                <nav aria-label="@L["Navegación principal"]">
                    @foreach (var group in VisibleSections())
                    {
                        <section class="gp-menu-section" aria-labelledby="@($"nav-section-{group.Section.Id}")" @key="group.Section.Id">
                            <h2 id="@($"nav-section-{group.Section.Id}")" class="gp-section-heading">
                                <span class="@(expanded ? "gp-section-title" : "gp-sr-only")">@group.Section.Label</span>
                                <span class="gp-section-line" aria-hidden="true"></span>
                            </h2>
                            @foreach (var option in group.Options)
                            {
                                <NavLink class="gp-menu-link" href="@option.Path" Match="NavLinkMatch.All" @onclick="Collapse" title="@option.Label" aria-label="@option.Label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)option.Icon)</svg>
                                    <span class="gp-option-title">@option.Label</span>
                                </NavLink>
                            }
                        </section>
                    }
                </nav>
                @if (expanded && !VisibleSections().Any())
                {
                    <p class="gp-menu-empty" role="status">@L["No se encontraron opciones."]</p>
                }
        }
    </div>
    <button type="button" class="gp-nav-toggle" @onclick="Toggle" aria-label="@(expanded ? L["Contraer navegación"] : L["Expandir navegación"])"
            aria-expanded="@(expanded ? "true" : "false")" aria-controls="gp-navigation" title="@(expanded ? L["Contraer menú"] : L["Expandir menú"])">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <span class="gp-option-title">@L["Contraer menú"]</span>
    </button>
    <AccountMenu Expanded="expanded" />
</aside>

@using GrammarErrorDetection.Services.Services.Auth
@inject AuthSessionState Session

@code {
    private bool expanded;
    private string search = string.Empty;
    private IEnumerable<(PortalMenuSection Section, PortalMenuOption[] Options)> VisibleSections()
    {
        var query = Normalize(search);
        foreach (var section in PortalNavigation.Sections.Where(section => PortalNavigation.CanViewSection(section, Session.Roles)))
        {
            var options = section.Paths.Select(path => PortalNavigation.Options.Single(option => option.Path == path))
                .Where(option => PortalNavigation.CanAccess(option.Path, Session.Roles) &&
                    Normalize($"{section.Label} {option.Label} {option.Path} {option.Keywords}").Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            if (options.Length > 0) yield return (section, options);
        }
    }
    private static string Normalize(string value) => new string(value.Trim().Normalize(NormalizationForm.FormD)
        .Where(character => CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark).ToArray());

    protected override void OnInitialized() { Navigation.LocationChanged += LocationChanged; Session.Changed += SessionChanged; }
    private void Toggle() { expanded = !expanded; search = string.Empty; }
    private void Expand() => expanded = true;
    private void Collapse() { expanded = false; search = string.Empty; }
    private void HandleKey(KeyboardEventArgs args) { if (args.Key == "Escape") Collapse(); }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        Collapse();
        _ = InvokeAsync(StateHasChanged);
    }
    private void SessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Navigation.LocationChanged -= LocationChanged; Session.Changed -= SessionChanged; }
}
