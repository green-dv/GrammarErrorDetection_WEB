@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="gp-shell">
    <a class="gp-skip-link" href="@(Navigation.Uri.Split('#')[0] + "#gp-content")">@L["Saltar al contenido"]</a>
    <NavMenu />
    <div class="gp-workspace">
        <header class="gp-topbar">
            <span class="gp-topbar-caption">@L["Portal académico"]</span>
            <span class="profile-portal-label">@L["Grammar Practice"]</span>
        </header>
        <main id="gp-content" class="gp-content" tabindex="-1">@Body</main>
    </div>
</div>
