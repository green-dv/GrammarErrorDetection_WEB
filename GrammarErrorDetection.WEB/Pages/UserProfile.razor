@page "/users/{UserId:guid}"
@page "/profile/{UserId:guid}"
@using GrammarErrorDetection.Services.Services.Auth
@inject AuthSessionState Session
@inject NavigationManager Navigation
@using GrammarErrorDetection.WEB.Views.Profiles

<PageTitle>Perfil de usuario | CETI La Paz</PageTitle>

@if (Session.Current is not null)
{
        <header class="portal-heading"><p class="portal-eyebrow">CETI · COMUNIDAD ACADÉMICA</p><h1>Perfil de usuario</h1>
            @if (Session.IsInRole("Coordinator")) { <a href="/users" class="data-table-text-button">← Volver a usuarios</a> }
            else { <a href="/home" class="data-table-text-button">← Volver al inicio</a> }
        </header>
        <ProfileSections @key="UserId" UserId="UserId" />
}

@code {
    [Parameter] public Guid UserId { get; set; }
    protected override void OnParametersSet()
    {
        if (Session.Current is null) Navigation.NavigateTo("/auth/login", replace: true);
    }
}
