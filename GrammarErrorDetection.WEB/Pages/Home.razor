@page "/home"
@using GrammarErrorDetection.Services.Services.Auth
@using GrammarErrorDetection.WEB.Views.Auth.Components
@inject AuthSessionState Session
@inject LoginFlowState LoginFlow
@inject RegistrationFlowState RegistrationFlow
@inject NavigationManager Navigation

<PageTitle>Inicio | CETI La Paz</PageTitle>

@if (Session.Current is { User: { } user })
{
    <h1>Bienvenido, @user.Name</h1>
    <p>Tu sesión está iniciada.</p>
    <SessionRolePreview />
    <button type="button" class="btn btn-primary" @onclick="SignOut">Cerrar sesión</button>
}

@code {
    protected override void OnInitialized()
    {
        if (Session.Current is null) Navigation.NavigateTo("/auth/login", replace: true);
    }

    private void SignOut()
    {
        Session.Clear();
        LoginFlow.Clear();
        RegistrationFlow.Clear();
        Navigation.NavigateTo("/auth/login", replace: true);
    }
}
