@using GrammarErrorDetection.WEB.Navigation
@inject NavigationManager Navigation

<PageTitle>@Title | Grammar Practice</PageTitle>
<header class="portal-heading"><p class="portal-eyebrow">@L["PORTAL ACADÉMICO"]</p><h1>@Title</h1></header>
<p class="portal-empty">@L["Esta sección aún no está disponible."]</p>

@code {
    private string Title => PortalNavigation.Options.FirstOrDefault(option => option.Path == Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'))?.Label ?? I18n.T("Portal académico");
}
