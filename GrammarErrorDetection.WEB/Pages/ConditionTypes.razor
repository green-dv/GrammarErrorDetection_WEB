@page "/condition-types"
@using GrammarErrorDetection.Services.Services.Auth
@using GrammarErrorDetection.WEB.Views.ConditionTypes
@inject AuthSessionState Session
@inject NavigationManager Navigation

<PageTitle>@L["Tipos de condición | CETI La Paz"]</PageTitle>

@if (Session.Current is not null)
{
    @if (Session.Roles.Contains("Coordinator", StringComparer.Ordinal))
    {
        <ConditionTypeList />
    }
    else
    {
        <h1>@L["Acceso restringido"]</h1>
        <p>@L["La gestión de tipos de condición está disponible para coordinadores."]</p>
        <a href="home">@L["Volver al inicio"]</a>
    }
}

@code {
    protected override void OnInitialized()
    {
        if (Session.Current is null) Navigation.NavigateTo("/auth/login", replace: true);
    }
}
