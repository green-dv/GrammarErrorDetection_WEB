@page "/materials"
@using Microsoft.AspNetCore.Components.Forms
@using GrammarErrorDetection.Models.Materials
@using GrammarErrorDetection.WEB.Components.Dialogs
@using GrammarErrorDetection.WEB.Views.Materials
@using GrammarErrorDetection.WEB.Components.Materials

<PageTitle>@L["Material de apoyo | CETI La Paz"]</PageTitle>

<section class="users-page materials-page" aria-labelledby="materials-title" aria-busy="@(loading ? "true" : "false")">
    <header class="users-heading">
        <div><p class="users-eyebrow">@L["CETI · RECURSOS DE APRENDIZAJE"]</p><h1 id="materials-title">@L["Material de apoyo"]</h1><p>@L["Encuentra guías, imágenes y enlaces para acompañar tu aprendizaje."]</p></div>
        @if (CanManage)
        {
            <button type="button" class="material-upload-button" disabled="@ActionBusy" @onclick="OpenCreate" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6"/></svg>@L["Agregar material"]</button>
        }
    </header>

    <div class="data-table-card materials-catalog">
    <header class="data-table-heading"><div><h2>@L["Listado de materiales"]</h2><p>@L["Consulta los recursos y combina los filtros para encontrar lo que necesitas."]</p></div></header>
    <form class="materials-toolbar data-filter-panel data-filter-panel-inset" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="data-filter-heading"><span>@L["Filtrar materiales"]</span><span>@L["Combina los campos que necesites"]</span></div>
        <div class="materials-filters">
            <label class="data-table-field materials-search"><span>@L["Nombre"]</span><input type="search" placeholder="@L["Buscar material…"]" maxlength="255" @bind="name" @bind:event="oninput" /></label>
            <label class="data-table-field"><span>@L["Clasificación del error"]</span><select @bind="categoryId" disabled="@loadingCategories"><option value="">@(loadingCategories ? L["Cargando clasificaciones…"] : L["Todas las clasificaciones"])</option>@foreach (var option in categories) { <option value="@option.Id">@option.Name</option> }</select></label>
            <label class="data-table-field"><span>@L["Tipo de archivo"]</span><select @bind="fileTypeId" disabled="@loadingFileTypes"><option value="">@(loadingFileTypes ? L["Cargando tipos…"] : L["Todos los tipos"])</option>@foreach (var option in fileTypes) { <option value="@option.Id">@option.Name</option> }</select></label>
            @if (IsStudent)
            {
                <label class="materials-helpful-toggle" title="@L["Muestra solo los materiales que marcaste como útiles"]">
                    <input type="checkbox" @bind="onlyHelpful" @bind:after="SearchAsync" disabled="@(loading || ActionBusy)" />
                    <span class="switch" aria-hidden="true"></span>@L["Solo mis útiles"]
                </label>
            }
            @if (CanManage)
            {
                <label class="data-table-field"><span>@L["Estado"]</span><select @bind="activeFilter"><option value="true">@L["Activos"]</option><option value="false">@L["Inactivos"]</option><option value="">@L["Todos"]</option></select></label>
            }
        </div>
        <div class="data-filter-actions"><button type="submit" class="data-table-button data-table-button-primary" disabled="@(loading || ActionBusy)">@L["Buscar"]</button><button type="button" class="data-table-button" disabled="@(loading || ActionBusy)" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></div>
        <span class="materials-count" role="status">@(loading ? L["Cargando materiales…"] : I18n.T(total is null ? "{0} recursos en esta página" : "{0} recursos en total", total ?? materials.Count))</span>
    </form>

    @if (categoryError is not null) { <div class="materials-notice is-error" role="alert"><p>@categoryError</p><button type="button" class="data-table-button" disabled="@loadingCategories" @onclick="LoadCategoriesAsync">@L["Reintentar clasificaciones"]</button></div> }
    @if (fileTypeError is not null) { <div class="materials-notice is-error" role="alert"><p>@fileTypeError</p><button type="button" class="data-table-button" disabled="@loadingFileTypes" @onclick="LoadFileTypesAsync">@L["Reintentar tipos de archivo"]</button></div> }
    @if (validationError is not null) { <p class="materials-notice is-error" role="alert">@validationError</p> }
    @if (status is not null) { <p class="materials-notice" role="status">@status</p> }
    @if (error is not null)
    {
        <div class="materials-notice is-error" role="alert"><p>@error</p><button type="button" class="data-table-button" disabled="@(loading || ActionBusy)" @onclick="RetryAsync">@L["Reintentar"]</button></div>
    }

    <ListPager Top="true" Label="@L["Paginación de materiales"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="10,20,30" PageSizeLabel="@L["Por página"]" PageSizeDisabled="@(loading || ActionBusy)" Page="page" PageOf="@PageOf" Info="@ResultRange" PreviousDisabled="@(loading || ActionBusy || page <= 1)" NextDisabled="@(loading || ActionBusy || !hasNext)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />

    <div class="materials-grid">
        @foreach (var material in materials)
        {
            var kind = MaterialPresentation.Kind(material, FileType(material));
            var format = MaterialPresentation.Format(material, FileType(material));
            var link = ResolveLink(material);
            <article class="material-card @(!material.Active ? "is-inactive" : "")" @key="material.Id">
                <div class="material-preview @kind.ToLowerInvariant()">
                    @if (kind == "Imagen" && link is not null)
                    {
                        <img src="@link" alt="@material.Name" loading="lazy" referrerpolicy="no-referrer" width="640" height="360" />
                    }
                    else if (kind is "PDF" or "Documento")
                    {
                        <div class="material-pdf-icon" aria-hidden="true"><svg viewBox="0 0 64 76"><path d="M10 2h29l15 15v55H10Z"/><path d="M39 2v17h15"/><path d="M20 31h23M20 38h18"/></svg><span>@format</span></div>
                    }
                    else
                    {
                        <div class="material-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m10 13 4-4m-6 5-2 2a3 3 0 0 0 4 4l4-4a3 3 0 0 0 0-4M10 10a3 3 0 0 1 0-4l4-4a3 3 0 0 1 4 4l-2 2"/></svg></div>
                    }
                    <span class="material-file-badge">@format</span>
                    @if (!material.Active) { <span class="material-inactive-badge">@L["Inactivo"]</span> }
                </div>
                <div class="material-card-body">
                    <span class="material-category">@CategoryName(material)</span>
                    <h2>@material.Name</h2>
                    <p class="material-file-kind">@kind · @format</p>
                    <dl class="material-metadata"><div><dt>@L["Fecha de subida"]</dt><dd>@material.UploadDate.ToString("dd/MM/yyyy")</dd></div><div><dt>@L["Peso"]</dt><dd>@MaterialPresentation.Size(material.FileSize)</dd></div></dl>
                    <p class="material-author">Subido por @(string.IsNullOrWhiteSpace(material.UploadedByName) ? L["Usuario"] : material.UploadedByName)</p>
                    <div class="material-actions">
                        @if (CanManage)
                        {
                            <button type="button" class="data-table-icon-button data-table-icon-danger material-trash" disabled="@ActionBusy" title="@(material.Active ? L["Desactivar"] : L["Reactivar"])" aria-label="@(material.Active ? I18n.T("Desactivar {0}", material.Name) : I18n.T("Reactivar {0}", material.Name))" @onclick="() => OpenStatus(material)"><svg viewBox="0 0 24 24" aria-hidden="true">@if (material.Active) { <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/> } else { <path d="M3 11a9 9 0 1 1 3 8M3 4v7h7"/> }</svg></button>
                            <button type="button" class="data-table-icon-button" disabled="@ActionBusy" title="@L["Editar"]" aria-label="@L["Editar {0}", material.Name]" @onclick="() => OpenDetailAsync(material, true)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14z"/></svg></button>
                        }
                        @if (IsStudent && material.Active)
                        {
                            var marked = material.ViewerHelpful == true;
                            <button type="button" class="helpful-button @(marked ? "is-marked" : "")" aria-pressed="@(marked ? "true" : "false")"
                                    disabled="@(marked || voting.Contains(material.Id))" title="@(marked ? L["Marcaste este material como útil"] : L["Marcar como útil"])"
                                    @onclick="() => VoteAsync(material, true)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-9-8.5C1.6 8.3 3.6 5 7 5c2 0 3.2 1.2 5 3 1.8-1.8 3-3 5-3 3.4 0 5.4 3.3 4 6.5-2 4.1-9 8.5-9 8.5Z"/></svg>
                                @(marked ? L["Útil"] : L["Marcar útil"])
                            </button>
                        }
                        <button type="button" class="data-table-icon-button" disabled="@ActionBusy" title="@L["Ver material"]" aria-label="@L["Ver {0}", material.Name]" @onclick="() => OpenDetailAsync(material, false)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        @if (link is not null)
                        {
                            <a class="data-table-icon-button" href="@MaterialPresentation.DownloadLink(link)" download target="_blank" rel="noopener noreferrer" title="@(MaterialPresentation.IsFileServerLink(link) ? L["Descargar archivo"] : L["Abrir enlace"])" aria-label="@(MaterialPresentation.IsFileServerLink(link) ? L["Descargar"] : L["Abrir"]) @material.Name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg></a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
    @if (!loading && error is null && materials.Count == 0)
    {
        <div class="materials-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h7l2 2h9v11H3ZM3 7V4h7l2 3h9v2"/></svg><h2>@EmptyTitle</h2><p>@EmptyHint</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></div>
    }
    <ListPager Label="@L["Paginación de materiales"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="10,20,30" PageSizeLabel="@L["Por página"]" PageSizeDisabled="@(loading || ActionBusy)" Page="page" PageOf="@PageOf" Info="@ResultRange" PreviousDisabled="@(loading || ActionBusy || page <= 1)" NextDisabled="@(loading || ActionBusy || !hasNext)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (dialogMode is not null)
{
    <ModalDialog Title="@DialogTitle" Subtitle="@DialogSubtitle" Class="@DialogClass" Busy="@(saving || loadingDetail)" OnClose="CloseDialog">
        @if (loadingDetail) { <p class="ceti-modal-description" role="status">@L["Cargando material…"]</p> }
        @if (dialogError is not null) { <div class="ceti-modal-body materials-dialog-error" role="alert">@dialogError</div> }
        @if (!loadingDetail && (dialogMode is "create" or "edit") && CanManage && editForm is { } model)
        {
            <p class="ceti-modal-description">@L["Sube un archivo o comparte el enlace de un recurso."]</p>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
                <fieldset class="material-upload-fields ceti-modal-body @(!useLink ? "has-preview" : "")" disabled="@saving">
                    @if (!useLink)
                    {
                        <aside class="material-form-preview" aria-label="@L["Vista previa del archivo"]">
                            <span class="material-form-preview-label">@L["Vista previa"]</span>
                            <FilePreview File="pendingFile" Input="fileInput?.Element" ExistingLink="@(selected is not null && IsUploadedFile(model.FileLink) ? MaterialPresentation.ResolveLink(model.FileLink, ApiBaseUrl) : null)" ExistingExtension="@(selected is null ? null : FileType(selected)?.Extension)" />
                        </aside>
                    }
                    <div class="material-form-fields">
                    <label class="data-table-field"><span>@L["Nombre del material"]</span><input maxlength="255" placeholder="@L["Ej. Guía de concordancia"]" @bind="model.Name" @bind:event="oninput" autofocus required /></label>
                    <div class="material-source-toggle" role="group" aria-label="@L["Origen del material"]">
                        <button type="button" class="@(!useLink ? "is-selected" : "")" aria-pressed="@(!useLink ? "true" : "false")" @onclick="() => ChangeSource(false)">@L["Archivo"]</button>
                        <button type="button" class="@(useLink ? "is-selected" : "")" aria-pressed="@(useLink ? "true" : "false")" @onclick="() => ChangeSource(true)">@L["Enlace"]</button>
                    </div>
                    @if (useLink)
                    {
                        <label class="data-table-field"><span>@L["Enlace del material"]</span><input type="url" placeholder="https://…" @bind="model.FileLink" @bind:event="oninput" @bind:after="UpdateLinkType" required /></label>
                        <p class="material-field-help">@L["El enlace se guarda directamente; no se subirá ningún archivo."]</p>
                    }
                    else
                    {
                        <div class="material-file-picker">
                            <label class="data-table-field"><span>@(dialogMode == "edit" ? L["Reemplazar archivo (opcional)"] : L["Archivo del material"])</span><InputFile @ref="fileInput" OnChange="SelectFile" disabled="@saving" /></label>
                            <p>@L["Máximo 25 MiB. El enlace y el tamaño se generan al subir el archivo."]</p>
                            @if (pendingFile is { } file) { <p role="status">@file.Name · @MaterialPresentation.Size(file.Size)</p> }
                            else if (!string.IsNullOrWhiteSpace(model.FileLink)) { <p class="material-field-help">@L["Archivo guardado: {0}", model.FileLink]</p> }
                        </div>
                    }
                    <label class="data-table-field"><span>@L["Clasificación del error"]</span><select @bind="model.ErrorClassificationId" disabled="@loadingCategories" required><option value="">@(loadingCategories ? L["Cargando clasificaciones…"] : L["Selecciona una clasificación"])</option>@if (selected is { } currentCategory && !categories.Any(item => item.Id == currentCategory.ErrorClassificationId)) { <option value="@currentCategory.ErrorClassificationId">@CategoryName(currentCategory) (actual)</option> }@foreach (var option in categories) { <option value="@option.Id">@option.Name</option> }</select></label>
                    @if (categoryError is not null) { <div class="materials-dialog-error" role="alert">@categoryError <button type="button" class="data-table-text-button" disabled="@loadingCategories" @onclick="LoadCategoriesAsync">@L["Reintentar"]</button></div> }
                    <p class="material-field-help" role="status">@L["Tipo de material:"] <strong>@(useLink ? L["Enlace"] : DetectedType)</strong> @L["· Asignado automáticamente"]</p>
                    @if (fileTypeError is not null) { <div class="materials-dialog-error" role="alert">@fileTypeError <button type="button" class="data-table-text-button" disabled="@loadingFileTypes" @onclick="LoadFileTypesAsync">@L["Reintentar"]</button></div> }
                    <p class="material-field-help">@(useLink ? L["La fecha de registro se asigna automáticamente."] : L["La fecha de subida y el tamaño se registran automáticamente."])</p>
                    @if (!loadingCategories && categoryError is null && categories.Count == 0) { <p class="material-field-help">@L["No hay clasificaciones activas disponibles para nuevos materiales."]</p> }
                    @if (!loadingFileTypes && fileTypeError is null && fileTypes.Count == 0) { <p class="material-field-help">@L["No hay tipos de archivo activos disponibles para nuevos materiales."]</p> }
                    </div>
                </fieldset>
                <footer class="ceti-modal-footer"><span role="status">@(saving ? useLink ? L["Guardando enlace…"] : L["Subiendo archivo y guardando material…"] : loadingCategories || loadingFileTypes ? L["Cargando opciones…"] : "")</span><div><button type="button" class="data-table-button" disabled="@saving" @onclick="CloseDialog">@L["Cancelar"]</button><button type="submit" class="material-upload-button" disabled="@(saving || loadingCategories || loadingFileTypes || !HasChanges)">@(dialogMode == "create" ? L["Agregar material"] : L["Guardar cambios"])</button></div></footer>
            </form>
        }
        else if (!loadingDetail && dialogMode == "preview" && selected is { } detail)
        {
            <div class="ceti-modal-body">
                <MaterialViewer Material="ViewOf(detail)">
                    <Feedback>
                        @if (IsStudent)
                        {
                            <MaterialFeedback Helpful="detail.ViewerHelpful" Busy="@voting.Contains(detail.Id)" Error="@feedbackError"
                                              OnVote="helpful => VoteAsync(detail, helpful)"
                                              @bind-Comment="commentDraft" OnSendComment="() => VoteAsync(detail, false, commentDraft)" CommentSent="commentSent" />
                        }
                    </Feedback>
                    <Actions>
                        @if (CanManage)
                        {
                            <button type="button" class="mv-button mv-button-outline" @onclick="() => OpenDetailAsync(detail, true)">@L["Editar material"]</button>
                        }
                    </Actions>
                </MaterialViewer>
            </div>
        }
        else if (dialogMode == "status" && selected is { } statusMaterial && CanManage)
        {
            <div class="ceti-modal-body"><p>¿Deseas @(statusMaterial.Active ? "desactivar" : "reactivar") <strong>@statusMaterial.Name</strong>?</p>@if (statusMaterial.Active) { <p>@L["Dejará de aparecer en el listado de materiales activos."]</p> }</div>
            <footer class="ceti-modal-footer"><span role="status">@(saving ? L["Guardando…"] : "")</span><div><button type="button" class="data-table-button" disabled="@saving" @onclick="CloseDialog">@L["Cancelar"]</button><button type="button" class="data-table-button @(statusMaterial.Active ? "data-table-button-danger" : "data-table-button-primary")" disabled="@saving" @onclick="ConfirmStatusAsync">@(statusMaterial.Active ? L["Desactivar"] : L["Reactivar"])</button></div></footer>
        }
        else if (!loadingDetail)
        {
            <footer class="ceti-modal-footer"><div><button type="button" class="data-table-button" @onclick="CloseDialog">@L["Cerrar"]</button></div></footer>
        }
    </ModalDialog>
}
