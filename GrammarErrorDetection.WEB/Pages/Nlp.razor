@using GrammarErrorDetection.WEB.Components.Dialogs
@page "/process"
@page "/nlp"
@using GrammarErrorDetection.WEB.Components.Analysis

<PageTitle>@L["Procesar | CETI La Paz"]</PageTitle>

<section class="users-page nlp-page" aria-labelledby="nlp-title">
    <header class="users-heading"><div><p class="users-eyebrow">@L["CETI · PRÁCTICA DE ESCRITURA"]</p><h1 id="nlp-title">@L["Procesar"]</h1><p>@L["Escribe en inglés y revisa los errores de cada oración."]</p></div></header>
    <div class="nlp-layout">
        <aside class="nlp-history" aria-labelledby="nlp-history-title" aria-busy="@(loading ? "true" : "false")">
            <header><h2 id="nlp-history-title">@(allTexts ? L["Todos los párrafos"] : L["Mis párrafos"])</h2><button type="button" class="data-table-text-button" disabled="@EditorBusy" @onclick="NewParagraph">@L["Nuevo"]</button></header>
            @if (CanReadAll)
            {
                <label class="data-table-field nlp-history-search"><span>@L["Mostrar"]</span><select @bind="allTexts" @bind:after="ChangeScopeAsync" disabled="@(loading || EditorBusy)"><option value="false">@L["Mis párrafos"]</option><option value="true">@L["Todos los usuarios"]</option></select></label>
            }
            <form class="nlp-history-search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="data-table-field"><span class="ceti-sr-only">@L["Buscar por contenido"]</span><input type="search" placeholder="@L["Buscar por contenido…"]" maxlength="5000" @bind="search" @bind:event="oninput" /></label>
                <button type="submit" class="data-table-button" disabled="@(loading || EditorBusy)">@L["Buscar"]</button>
            </form>
            <p class="nlp-history-count" role="status">@(loading ? L["Cargando párrafos…"] : I18n.T("{0} párrafos en esta página", paragraphs.Count))</p>
            @if (historyError is not null)
            {
                <div class="nlp-history-error" role="alert"><p>@historyError</p><button type="button" class="data-table-text-button" disabled="@(loading || EditorBusy)" @onclick="RetryHistoryAsync">@L["Reintentar historial"]</button></div>
            }
            <ul class="nlp-history-list">
                @foreach (var paragraph in paragraphs)
                {
                    <li @key="paragraph.Id"><button type="button" class="nlp-history-entry @(selected?.Id == paragraph.Id ? "is-selected" : "")" disabled="@EditorBusy" aria-pressed="@(selected?.Id == paragraph.Id ? "true" : "false")" @onclick="() => SelectParagraph(paragraph)"><span class="nlp-history-item-heading"><strong>@Title(paragraph)</strong><span>@(IsProcessed(paragraph) ? "✓" : "◷")</span></span><span class="nlp-history-excerpt">@paragraph.OriginalContent</span><span class="nlp-history-date">@paragraph.SubmissionDate.ToString("dd/MM/yyyy HH:mm") · @paragraph.Status</span></button></li>
                }
            </ul>
            @if (!loading && paragraphs.Count == 0 && historyError is null) { <p class="nlp-history-empty">@L["No se encontraron párrafos."]</p> }
            <footer class="nlp-history-pagination">
                <label>@L["Por página"] <select @bind="pageSize" @bind:after="ChangePageSizeAsync" disabled="@(loading || EditorBusy)"><option value="3">3</option><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></label>
                <nav aria-label="@L["Paginación de párrafos"]"><button type="button" @onclick="PreviousPageAsync" disabled="@(loading || EditorBusy || currentPage <= 1)" aria-label="@L["Página anterior"]">‹</button><span>@L["Página {0}", currentPage]</span><button type="button" @onclick="NextPageAsync" disabled="@(loading || EditorBusy || !hasNext)" aria-label="@L["Página siguiente"]">›</button></nav>
            </footer>
        </aside>

        <div class="nlp-main">
            <article class="nlp-editor" aria-labelledby="nlp-editor-title" aria-busy="@(EditorBusy ? "true" : "false")">
                <header><h2 id="nlp-editor-title">@L["Tu párrafo"]</h2><span class="nlp-language">@L["EN · Inglés"]</span></header>
                @if (Session.IsInRole("Student"))
                {
                    @if (Session.IsInRole("Student"))
                    {
                    <label class="data-table-field nlp-upload-course"><span>@L["Asociar al curso"]</span><select @bind="registrationId" disabled="@(EditorBusy || loadingCourses)"><option value="">@L["Texto personal · Sin curso"]</option>@foreach (var course in uploadCourses) { <option value="@course.RegistrationId">@course.ModuleName · @course.Year / Bimestre @course.Bimester · @course.Parallel</option> }</select></label>
                    }
                    else
                    {
                    <p class="nlp-staff-note">@L["Tus párrafos son de consulta y prueba: no se asocian a cursos ni cuentan en los reportes ni en la gamificación."]</p>
                    }
                    @if (loadingCourses) { <p class="nlp-feedback" role="status">@L["Consultando tus cursos…"]</p> }
                    @if (coursesError is not null) { <p class="nlp-upload-error" role="alert">@coursesError <button type="button" class="data-table-text-button" disabled="@loadingCourses" @onclick="LoadUploadCoursesAsync">@L["Reintentar cursos"]</button></p> }
                }
                <label class="ceti-sr-only" for="nlp-paragraph">@L["Párrafo en inglés"]</label>
                <textarea id="nlp-paragraph" rows="4" lang="en" spellcheck="false" maxlength="5000" placeholder="@L["Write your paragraph here…"]" disabled="@EditorBusy" @bind="text" @bind:event="oninput"></textarea>
                <p class="nlp-character-count">@text.Length / 5000 caracteres</p>
                <div class="nlp-editor-actions">
                    <div class="nlp-photo-picker">
                        <button type="button" class="nlp-photo-button" disabled="@EditorBusy" aria-haspopup="menu" aria-expanded="@photoMenuOpen" aria-controls="nlp-photo-menu" @onclick="TogglePhotoMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="8" cy="10" r="1.5"/><path d="m3 17 5-4 4 3 4-5 5 6"/></svg>@(recognizingPhoto ? L["Extrayendo texto…"] : L["Extraer texto de una imagen"])<svg class="nlp-photo-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg></button>
                        @if (photoMenuOpen)
                        {
                            <div id="nlp-photo-menu" class="nlp-photo-menu" role="menu" aria-label="@L["Origen de la imagen"]">
                                <label for="nlp-photo-device" role="menuitem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5"/></svg><span><strong>@L["Desde este dispositivo"]</strong><small>@L["Selecciona una imagen guardada"]</small></span></label>
                                <label for="nlp-photo-camera" role="menuitem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h4l2-2h4l2 2h4v12H4z"/><circle cx="12" cy="13" r="3"/></svg><span><strong>@L["Tomar una foto"]</strong><small>@L["Abre la cámara del dispositivo"]</small></span></label>
                            </div>
                        }
                        <InputFile @key="devicePhotoInputKey" id="nlp-photo-device" class="nlp-photo-input" accept="image/*" OnChange="SelectPhotoAsync" disabled="@EditorBusy" aria-label="@L["Subir imagen desde este dispositivo"]" />
                        <InputFile @key="cameraPhotoInputKey" id="nlp-photo-camera" class="nlp-photo-input" accept="image/*" capture="environment" OnChange="SelectPhotoAsync" disabled="@EditorBusy" aria-label="@L["Tomar una foto"]" />
                    </div>
                    <button type="button" class="nlp-upload-button" disabled="@(EditorBusy || loading || string.IsNullOrWhiteSpace(text))" @onclick="UploadAsync"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6"/></svg>@(uploading ? L["Analizando…"] : L["Subir párrafo"])</button>
                </div>
                @if (photoMessage is not null) { <p class="nlp-feedback" role="status">@photoMessage</p> }
                @if (reviewLines.Count > 0)
                {
                    <div class="nlp-ocr-review" role="status">
                        <strong>@L["Líneas que el OCR leyó con poca seguridad. Compáralas con tu foto y corrige el texto:"]</strong>
                        <ul>@foreach (var line in reviewLines) { <li>@line</li> }</ul>
                    </div>
                }
                @if (photoError is not null) { <p class="nlp-upload-error" role="alert">@photoError</p> }
                @if (status is not null) { <p class="nlp-feedback" role="status">@status</p> }
                @if (uploadError is not null) { <p class="nlp-upload-error" role="alert">@uploadError</p> }
            </article>

            <section class="nlp-analysis" aria-labelledby="nlp-analysis-title">
                @if (CurrentAnalysis is not { } analysis)
                {
                    <header class="nlp-analysis-heading"><h2 id="nlp-analysis-title">@L["Análisis"]</h2></header>
                    <p class="nlp-analysis-empty">@L["Sube tu párrafo para analizarlo o selecciona uno del historial. Si editas un texto, vuelve a subirlo para obtener su nuevo análisis."]</p>
                }
                else if (analysis.Sentences.Count == 0)
                {
                    <header class="nlp-analysis-heading"><h2 id="nlp-analysis-title">@L["Análisis"]</h2><span>@analysis.Status</span></header>
                    <p class="nlp-analysis-empty">@(IsProcessed(analysis) ? L["No se recibieron oraciones para este análisis."] : I18n.T("Estado del párrafo: {0}.", analysis.Status))</p>
                    <button type="button" class="data-table-text-button" disabled="@(loading || EditorBusy)" @onclick="RefreshAnalysisAsync">@L["Actualizar análisis"]</button>
                }
                else
                {
                    <AnalysisPanel @key="analysis.Id" Analysis="analysis" View="analysisView" ViewChanged="ChangeView"
                                   Vocabulary="@VocabularyFor(analysis)" VocabularyLoading="@VocabularyPending(analysis)"
                                   VocabularyError="@VocabularyErrorFor(analysis)" VocabularyUnavailable="@VocabularyUnavailableFor(analysis)" OnRetryVocabulary="ReloadVocabularyAsync"
                                   ShowReinforcement="@Session.IsInRole("Student")" />
                }            </section>
        </div>
    </div>
</section>

@if (previewOpen && pendingPhoto is not null)
{
    <ModalDialog Title="@L["Vista previa de la foto"]" Subtitle="@L["Revisa que el texto se vea nítido y completo antes de leerlo."]" Class="nlp-photo-preview-dialog" Busy="recognizingPhoto" OnClose="CancelPhoto">
        <div class="ceti-modal-body">
            @if (previewUrl is not null)
            {
                <img class="nlp-photo-preview-image" src="@previewUrl" alt="@L["Vista previa de la foto seleccionada"]" />
            }
            else
            {
                <p class="nlp-photo-preview-missing">@L["Tu navegador no puede mostrar esta imagen, pero se enviará igualmente."]</p>
            }
            <p class="nlp-photo-preview-meta">@pendingPhoto.Name · @FormatSize(pendingPhoto.Size)</p>
        </div>
        <footer class="ceti-modal-footer">
            <span role="status">@(recognizingPhoto ? L["Leyendo el texto de la foto…"] : "")</span>
            <div>
                <button type="button" class="data-table-button" disabled="@recognizingPhoto" @onclick="CancelPhoto">@L["Elegir otra"]</button>
                <button type="button" class="data-table-button data-table-button-primary" disabled="@recognizingPhoto" @onclick="RecognizePhotoAsync">@L["Leer texto"]</button>
            </div>
        </footer>
    </ModalDialog>
}
