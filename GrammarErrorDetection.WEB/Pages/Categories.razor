@page "/categories"
@using GrammarErrorDetection.Services.Services.Auth
@using GrammarErrorDetection.WEB.Views.Categories
@inject AuthSessionState Session
@inject NavigationManager Navigation

<PageTitle>@L["Categorías de error | Grammar Practice"]</PageTitle>

@if (Session.Current is not null)
{
    @if (Session.IsStaff)
    {
        <CategoryList />
    }
    else
    {
        <h1>@L["Acceso restringido"]</h1>
        <p>@L["La gestión de categorías de error está disponible para coordinadores."]</p>
        <a href="home">@L["Volver al inicio"]</a>
    }
}

@code {
    protected override void OnInitialized()
    {
        if (Session.Current is null) Navigation.NavigateTo("/auth/login", replace: true);
    }
}
