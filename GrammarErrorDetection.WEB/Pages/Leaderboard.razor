@page "/leaderboard"

<PageTitle>Leaderboard | CETI La Paz</PageTitle>

<section class="users-page leaderboard-page" aria-labelledby="leaderboard-title">
    <header class="users-heading">
        <div><p class="users-eyebrow">CETI · COMUNIDAD QUE APRENDE</p><h1 id="leaderboard-title">Leaderboard</h1><p>Celebra el esfuerzo y descubre quiénes lideran el aprendizaje.</p></div>
    </header>
    <form class="leaderboard-toolbar data-filter-panel" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="leaderboard-filters">
            <label class="data-table-field"><span>Módulo</span>
                <select @bind="moduleId" disabled="@(loading || loadingModules)">
                    <option value="">Todos los módulos</option>
                    @foreach (var module in modules) { <option value="@module.Id">@module.Name</option> }
                </select>
            </label>
            <label class="data-table-field"><span>Bimestre</span>
                <select @bind="bimester" disabled="@loading">
                    <option value="">Todos los bimestres</option>
                    @for (var number = 1; number <= 6; number++) { <option value="@number">Bimestre @number</option> }
                </select>
            </label>
            <label class="data-table-field"><span>Año</span><input type="number" min="1" step="1" placeholder="Todos los años" @bind="year" disabled="@loading" /></label>
        </div>
        <div class="data-filter-actions">
            <button type="submit" class="data-table-button data-table-button-primary" disabled="@loading">Aplicar filtros</button>
            <button type="button" class="data-table-button" @onclick="ClearAsync" disabled="@loading">Todos los tiempos</button>
        </div>
    </form>
    @if (moduleError is not null)
    {
        <div class="data-table-error" role="alert"><p>@moduleError</p><button class="data-table-text-button" @onclick="LoadModulesAsync" disabled="@loadingModules">Reintentar módulos</button></div>
    }
    @if (validationError is not null) { <p class="data-table-error" role="alert">@validationError</p> }

    <div aria-live="polite" role="status" class="leaderboard-results">
        @(loading ? "Cargando clasificación…" : error is not null ? "Clasificación no disponible" : $"{entries.Count(item => item.IsTop10)} participantes en el top 10 · {periodLabel}")
    </div>
    @if (error is not null)
    {
        <div class="data-table-error" role="alert"><p>@error</p><button class="data-table-text-button" @onclick="LoadAsync">Reintentar</button></div>
    }
    else if (!loading)
    {
        @if (entries.Any(item => item.IsTop10 && item.Position is >= 1 and <= 3))
        {
            <section class="leaderboard-podium-section" aria-labelledby="podium-title">
                <header class="leaderboard-section-heading"><div><h2 id="podium-title">Los primeros del ranking</h2><p>@moduleLabel · @periodLabel</p></div><span class="leaderboard-top-label">TOP 3</span></header>
                <ol class="leaderboard-podium" aria-label="Podio de los tres primeros participantes">
                    @foreach (var place in new[] { 2, 1, 3 })
                    {
                        @foreach (var student in entries.Where(item => item.IsTop10 && item.Position == place))
                        {
                            <li class="leaderboard-podium-place place-@place" value="@place" aria-label="Puesto @place: @Name(student), @student.TotalPoints puntos">
                                <div class="leaderboard-podium-person">
                                    @if (place == 1) { <svg class="leaderboard-crown" viewBox="0 0 40 30" aria-hidden="true"><path d="m4 7 9 8 7-12 7 12 9-8-4 20H8Z" /></svg> }
                                    <div class="leaderboard-podium-avatar" aria-hidden="true">@Initials(student)<span>@place</span></div>
                                    <h3>@Name(student) @(student.IsCurrentUser ? "(Tú)" : "")</h3><p>@Module(student)</p><strong>@student.TotalPoints.ToString("N0")<small> puntos</small></strong>
                                </div>
                                <div class="leaderboard-podium-step"><span>@place</span><small>@(place == 1 ? "Oro" : place == 2 ? "Plata" : "Bronce")</small></div>
                            </li>
                        }
                    }
                </ol>
            </section>
        }
        <section class="data-table-card leaderboard-ranking" aria-labelledby="ranking-title">
            <header class="data-table-heading"><div><h2 id="ranking-title">Clasificación de participantes</h2><p>Top 10 por puntos · @moduleLabel · @periodLabel</p></div><span class="data-table-badge">TOP 10</span></header>
            <div class="data-table-scroll" role="region" aria-label="Clasificación por puntos" tabindex="0">
                <table class="data-table leaderboard-table">
                    <caption class="data-table-sr-only">Top 10 y tu resultado, si la API lo incluye, según los filtros seleccionados.</caption>
                    <thead><tr><th scope="col">Puesto</th><th scope="col">Participante</th><th scope="col">Módulo</th><th scope="col">Puntos</th></tr></thead>
                    <tbody>
                        @if (entries.Count == 0)
                        {
                            <tr><td colspan="4" class="data-table-empty"><strong>No hay resultados</strong><p>No se encontraron participantes con los filtros seleccionados.</p></td></tr>
                        }
                        @foreach (var student in entries.OrderByDescending(item => item.IsTop10).ThenBy(item => item.Position ?? int.MaxValue))
                        {
                            <tr class="@(student.IsTop10 ? $"leaderboard-top-row rank-{student.Position}" : "")">
                                <td><span class="leaderboard-rank-number">@(student.IsTop10 ? student.Position?.ToString() ?? "--" : "--")</span></td>
                                <th scope="row"><div class="data-table-identity"><span class="data-table-avatar" aria-hidden="true">@Initials(student)</span><div><span class="data-table-primary">@Name(student) @if (student.IsCurrentUser) { <span class="data-table-chip">Tú</span> }</span>@if (!student.IsTop10) { <span class="data-table-secondary">Fuera del top 10</span> }</div></div></th>
                                <td><span class="data-table-chip">@Module(student)</span></td>
                                <td><strong class="leaderboard-points">@student.TotalPoints.ToString("N0")</strong><span class="leaderboard-points-unit"> pts</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="data-table-footer"><span>@entries.Count resultados</span><span>La posición y los puntos corresponden al ranking de la API.</span></footer>
        </section>
    }
</section>
