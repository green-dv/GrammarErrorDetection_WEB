@using System.Globalization
@using GrammarErrorDetection.Models.Dashboards
@using GrammarErrorDetection.Services.Interfaces
@implements IDisposable
@inject IDashboardService Dashboard

@* Panel institucional del coordinador: resumen del periodo (Dashboard_Coordinator) y listas paginadas.
   Las tendencias comparan con el periodo anterior; con "Todo el historial" no hay contra qué comparar. *@
<section class="student-dashboard sh-dashboard @(loading && summary is not null ? "is-refreshing" : "")" aria-labelledby="cd-title" aria-busy="@(loading ? "true" : "false")">
    <header class="sh-identity">
        <div class="sh-avatar" style="--level:@StudentDashboard.Number(summary?.Kpis?.CoveragePercentage)" title="Cobertura del analizador en el periodo">
            <span aria-hidden="true"><svg viewBox="0 0 24 24" class="cd-emblem"><path d="M3 10 12 4l9 6M5 10v8m4-8v8m6-8v8m4-8v8M3 21h18" /></svg></span>
        </div>
        <div class="sh-who">
            <h2 id="cd-title">Panel institucional</h2>
            <p>Notas y errores de @PeriodLabel.ToLower(StudentDashboard.Culture)@(summary?.Kpis is { } scope ? $": {scope.EnrolledStudents} estudiantes en {scope.CourseCount} clases con {scope.ActiveTeachers} docentes y {scope.AnalyzedTexts} textos analizados" : "").
                @if (summary?.Kpis is { PendingRegistrations: > 0 } pending)
                {
                    <a class="sh-level cd-pending" href="enrollments">@pending.PendingRegistrations @(pending.PendingRegistrations == 1 ? "inscripción pendiente" : "inscripciones pendientes")</a>
                }
            </p>
        </div>
        <div class="sh-identity-actions">
            <label class="sh-course">
                <span class="data-table-sr-only">Periodo</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4m8-4v4" /></svg>
                <select value="@PeriodValue" disabled="@loading" @onchange="ChangePeriodAsync">
                    <option value="">Todo el historial</option>
                    @foreach (var option in Years)
                    {
                        <option value="@option">@option, todo el año</option>
                        @for (var b = 6; b >= 1; b--) { <option value="@($"{option}-{b}")">@option, bimestre @b</option> }
                    }
                </select>
            </label>
        </div>
    </header>

    @if (loading && summary is null) { <p class="data-table-message" role="status">Cargando el resumen…</p> }
    else if (error is not null && summary is null) { <div class="data-table-error" role="alert">@error <button type="button" class="data-table-text-button" @onclick="LoadAsync">Reintentar</button></div> }
    else if (summary?.Kpis is { } kpis)
    {
        @if (error is not null) { <div class="data-table-error" role="alert">@error</div> }
        var game = summary.Gamification;

        <DashboardSectionNav Items="CoordinatorSections" />

        <div class="sh-kpis" id="cd-sec-grades">
            <article class="sh-kpi" style="--tone:var(--sh-blue);--tone-soft:var(--sh-blue-soft)">
                <span class="sh-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 21V9l8-6 8 6v12" /><path d="M9 21v-6h6v6" /></svg></span>
                <div><strong>@(kpis.AverageFinalScore?.ToString("0.#", StudentDashboard.Culture) ?? "—")</strong><span>Nota final promedio</span></div>
                <Trend Now="kpis.AverageFinalScore" Before="kpis.PreviousAverageFinalScore" Points="true" Title="@CompareTitle" />
            </article>
            <article class="sh-kpi" style="--tone:var(--sh-violet);--tone-soft:var(--sh-violet-soft)">
                <span class="sh-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg></span>
                <div><strong>@StudentDashboard.Percent(kpis.PassRatePercentage)</strong><span>Aprobación · @kpis.GradedStudents con nota</span></div>
                <Trend Now="kpis.PassRatePercentage" Before="kpis.PreviousPassRatePercentage" Points="true" Title="@CompareTitle" />
            </article>
            <article class="sh-kpi" style="--tone:var(--sh-green);--tone-soft:var(--sh-green-soft)">
                <span class="sh-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" /></svg></span>
                <div><strong>@StudentDashboard.Percent(kpis.AccuracyPercentage)</strong><span>Precisión general</span></div>
                <Trend Now="kpis.AccuracyPercentage" Before="kpis.PreviousAccuracyPercentage" Points="true" Title="@CompareTitle" />
            </article>
            <article class="sh-kpi" style="--tone:var(--sh-red);--tone-soft:var(--sh-red-soft)">
                <span class="sh-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m9 9 6 6m0-6-6 6" /></svg></span>
                <div><strong>@(kpis.ErrorsPerText?.ToString("0.##", StudentDashboard.Culture) ?? "—")</strong><span>Errores por texto</span></div>
                <Trend Now="kpis.ErrorsPerText" Before="kpis.PreviousErrorsPerText" LowerIsBetter="true" Title="@CompareTitle" />
            </article>
            <article class="sh-kpi" style="--tone:var(--sh-flame);--tone-soft:var(--sh-flame-soft)">
                <span class="sh-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6Z" /><path d="M12 8v5m0 3v.01" /></svg></span>
                <div><strong>@StudentDashboard.Percent(kpis.AtRiskPercentage)</strong><span>En riesgo · @kpis.AtRiskStudents estudiantes</span></div>
                <Trend Now="kpis.AtRiskPercentage" Before="kpis.PreviousAtRiskPercentage" Points="true" LowerIsBetter="true" Title="@CompareTitle" />
            </article>
        </div>

        <ModulePerformanceTable AnchorId="cd-sec-modules" Items="summary.ModulePerformance" Title="Rendimiento por tipo de módulo"
                                Subtitle="@($"Notas y errores de cada módulo en {PeriodLabel.ToLower(StudentDashboard.Culture)}.")"
                                Empty="No hay cursos en este periodo." />

        <TeacherRankingCard AnchorId="cd-sec-teachers" Year="year" Bimester="bimester" PeriodLabel="@PeriodLabel" />

        <div class="sh-row cd-row-bottom">
            <section class="sh-card" id="cd-sec-errors" aria-labelledby="cd-errors-title">
                <header class="sh-card-head">
                    <h3 id="cd-errors-title">Errores más frecuentes</h3>
                    <div class="cd-toggle" role="group" aria-label="Mostrar como">
                        <button type="button" aria-pressed="@(!showCounts ? "true" : "false")" @onclick="() => showCounts = false">Porcentaje</button>
                        <button type="button" aria-pressed="@(showCounts ? "true" : "false")" @onclick="() => showCounts = true">Cantidad</button>
                    </div>
                </header>
                @if (slices.Count == 0) { <p class="sh-empty">No hay errores registrados en el periodo.</p> }
                else
                {
                    <div class="sh-donut-wrap">
                        <div class="sh-donut" style="background:@Donut()" role="img" aria-label="@string.Join(", ", slices.Select(s => $"{s.Name} {s.Percent:0} %, {s.Count} errores"))">
                            <div><strong>@TotalErrors.ToString("N0", StudentDashboard.Culture)</strong><span>errores</span></div>
                        </div>
                        <ul class="sh-donut-legend">
                            @foreach (var slice in slices)
                            {
                                <li style="--swatch:@slice.Color"><span>@slice.Name</span><b>@(showCounts ? slice.Count.ToString("N0", StudentDashboard.Culture) : slice.Percent.ToString("0.#", StudentDashboard.Culture) + " %")</b></li>
                            }
                        </ul>
                    </div>
                    @if (Modules.Count > 0)
                    {
                        <ul class="cd-modules" aria-label="Error principal por módulo">
                            @foreach (var module in Modules)
                            {
                                <li @key="module.ModuleNameId"><span>@module.ModuleName</span><b>@CategoryBars.Label(module.ErrorClassificationName)</b><small>@StudentDashboard.Percent(module.ErrorPercentage)</small></li>
                            }
                        </ul>
                    }
                }
            </section>
            <TeacherAtRiskCard AnchorId="cd-sec-risk" Year="year" Bimester="bimester" ShowCourse="true" NoTextsCount="kpis.AtRiskNoTexts" LowScoreCount="kpis.AtRiskLowScore" />
        </div>

        <div class="sh-row cd-row-top">
            <CoordinatorCoverageCard AnchorId="cd-sec-coverage" Year="year" Bimester="bimester" CourseCount="kpis.CourseCount" ClassesWithActivity="kpis.ClassesWithActivity" PeriodLabel="@PeriodLabel" />
            <section class="sh-card" id="cd-sec-game" aria-labelledby="cd-game-title">
                <header class="sh-card-head">
                    <h3 id="cd-game-title">Gamificación</h3>
                    <a class="sh-link" href="gamification">Ver detalles</a>
                </header>
                @if (game is not null)
                {
                    <div class="cd-game">
                        <div style="--tone:var(--sh-amber);--tone-soft:var(--sh-amber-soft)">
                            <span class="cd-game-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v4c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 10v4c0 1.7 3.1 3 7 3s7-1.3 7-3v-4M5 14v4c0 1.7 3.1 3 7 3s7-1.3 7-3v-4" /></svg></span>
                            <strong>@game.PointsAwarded.ToString("N0", StudentDashboard.Culture)</strong>
                            <span>Puntos otorgados</span>
                            <small>a @game.StudentsWithPoints @(game.StudentsWithPoints == 1 ? "estudiante" : "estudiantes")</small>
                            <Trend Now="game.PointsAwarded" Before="game.PreviousPointsAwarded" Title="@CompareTitle" />
                        </div>
                        <div style="--tone:var(--sh-blue);--tone-soft:var(--sh-blue-soft)">
                            <span class="cd-game-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="6" /><path d="m9 14-2 7 5-3 5 3-2-7" /></svg></span>
                            <strong>@game.AchievementsAwarded.ToString("N0", StudentDashboard.Culture)</strong>
                            <span>Logros desbloqueados</span>
                            <small>de @game.ActiveAchievements logros activos</small>
                            <Trend Now="game.AchievementsAwarded" Before="game.PreviousAchievementsAwarded" Title="@CompareTitle" />
                        </div>
                        <div style="--tone:var(--sh-violet);--tone-soft:var(--sh-violet-soft)">
                            <span class="cd-game-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20 9.5 8l4 6 2.5-3.5L21 20ZM9.5 8V3l4 1.5-4 1.5" /></svg></span>
                            <strong>@game.ChallengesCompleted.ToString("N0", StudentDashboard.Culture)</strong>
                            <span>Desafíos completados</span>
                            <small>@game.ActiveChallenges @(game.ActiveChallenges == 1 ? "desafío activo hoy" : "desafíos activos hoy")</small>
                            <Trend Now="game.ChallengesCompleted" Before="game.PreviousChallengesCompleted" Title="@CompareTitle" />
                        </div>
                    </div>
                }
            </section>

        </div>
    }
</section>

@code {
    private static readonly int[] Years = Enumerable.Range(2025, DateTime.Today.Year - 2025 + 2).Reverse().ToArray();
    private static readonly string[] Palette = ["#176b9f", "#c53736", "#c98210", "#1f8a5b", "#6a5acd", "#9aa6bd"];
    private static readonly (string, string)[] CoordinatorSections =
        [("cd-sec-grades", "Notas"), ("cd-sec-modules", "Módulos"), ("cd-sec-teachers", "Docentes"), ("cd-sec-errors", "Errores"),
         ("cd-sec-risk", "Riesgo"), ("cd-sec-coverage", "Cobertura"), ("cd-sec-game", "Gamificación")];
    private readonly CancellationTokenSource lifetime = new();
    private CoordinatorDashboardResponse? summary;
    private List<(string Name, decimal Percent, long Count, string Color)> slices = [];
    private int? year = DateTime.Today.Year;
    private int? bimester;
    private bool showCounts;
    private bool loading;
    private string? error;

    private string PeriodValue => year is null ? "" : bimester is null ? year.Value.ToString(CultureInfo.InvariantCulture) : $"{year}-{bimester}";

    private string PeriodLabel => year is null ? "Todo el historial" : bimester is null ? $"El año {year}" : $"El bimestre {bimester} de {year}";

    private string CompareTitle => bimester is null ? "Frente al año anterior" : "Frente al bimestre anterior";

    // Total del periodo deducido de la primera categoría (conteo / porcentaje): el cursor solo trae las 6 principales.
    private long TotalErrors => summary?.TopCategories.FirstOrDefault() is { ErrorPercentage: > 0 } first
        ? (long)Math.Round(first.ErrorCount * 100m / first.ErrorPercentage!.Value)
        : 0;

    // Error principal (rango 1) de cada módulo.
    private List<ModuleErrorCategory> Modules => summary?.ErrorsByModule.Where(m => m.Rank == 1).ToList() ?? [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ChangePeriodAsync(ChangeEventArgs args)
    {
        var parts = (args.Value?.ToString() ?? "").Split('-');
        year = int.TryParse(parts[0], out var y) ? y : null;
        bimester = year is not null && parts.Length > 1 && int.TryParse(parts[1], out var b) && b is >= 1 and <= 6 ? b : null;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true;
        error = null;
        try
        {
            summary = await Dashboard.GetCoordinatorAsync(year, bimester, lifetime.Token);
            var top = summary.TopCategories.Take(5).Select((c, i) => (CategoryBars.Label(c.ErrorClassificationName), c.ErrorPercentage ?? 0, c.ErrorCount, Palette[i])).ToList();
            var restPercent = 100 - top.Sum(s => s.Item2);
            if (restPercent > 0.5m)
                top.Add(("Otras", restPercent, Math.Max(TotalErrors - top.Sum(t => t.Item3), 0), Palette[^1]));
            slices = top;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            error = summary is null ? "No se pudo cargar el resumen institucional." : "No se pudo cambiar de periodo. Se muestran los datos anteriores.";
        }
        finally { loading = false; }
    }

    private string Donut()
    {
        decimal start = 0;
        var stops = slices.Select(s => { var from = start; start += s.Percent; return $"{s.Color} {Inv(from)}% {Inv(start)}%"; });
        return $"conic-gradient({string.Join(", ", stops)}, var(--sh-track) 0)";
    }

    private static string Inv(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
