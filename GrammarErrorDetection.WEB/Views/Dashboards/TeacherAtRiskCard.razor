@using GrammarErrorDetection.Models.Dashboards
@using GrammarErrorDetection.Services.Interfaces
@implements IDisposable
@inject IDashboardService Dashboard

@* Estudiantes en riesgo (Dashboard_AtRisk_List) separados por motivo y paginados en el servidor.
   Docente: sus cursos (ClassId opcional). Coordinador: toda la institución en el periodo (Year/Bimester). *@
<section class="sh-card td-risk" id="@AnchorId" aria-labelledby="td-risk-title" aria-busy="@(loading ? "true" : "false")">
    <header class="sh-card-head">
        <h3 id="td-risk-title"><span class="td-risk-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2 21h20ZM12 10v5m0 3v.01" /></svg></span>@L["Estudiantes en riesgo"]</h3>
    </header>
    <div class="td-pills" role="tablist" aria-label="@L["Motivo"]">
        <button type="button" role="tab" aria-selected="@(reason == "NoTexts" ? "true" : "false")" @onclick='() => ChangeReasonAsync("NoTexts")'>@L["Sin textos ({0})", NoTextsCount]</button>
        <button type="button" role="tab" aria-selected="@(reason == "LowScore" ? "true" : "false")" @onclick='() => ChangeReasonAsync("LowScore")'>@L["Nota baja ({0})", LowScoreCount]</button>
    </div>
    @if (error is not null) { <div class="data-table-error" role="alert">@error <button type="button" class="data-table-text-button" @onclick="() => LoadAsync(pageNumber)">@L["Reintentar"]</button></div> }
    else if (results is null) { <p class="data-table-message" role="status">@L["Cargando estudiantes…"]</p> }
    else if (results.Items.Count == 0)
    {
        <p class="sh-empty">@(reason == "NoTexts" ? L["Todos tus estudiantes ya analizaron al menos un texto."] : L["Ningún estudiante tiene nota menor a 70."])</p>
    }
    else
    {
        <ul class="m-cards">
            @foreach (var student in results.Items)
            {
                <li @key="(student.UserId, student.ClassId)">
                    <div class="m-card-head">
                        <div><strong>@student.StudentName</strong>@if (ShowCourse) { <small>@student.ModuleName · @(student.Parallel is { Length: > 0 } p ? p + " · " : "")B@(student.Bimester)</small> }</div>
                    </div>
                    <dl class="m-facts">
                        <div><dt>@L["Motivo"]</dt><dd>@Reason(student)</dd></div>
                        <div><dt>@L["Última actividad"]</dt><dd>@LastActivity(student.LastTextAt)</dd></div>
                    </dl>
                    <div class="m-actions">
                        @if (WhatsAppLink(student.Phone) is { } whatsApp)
                        {
                            <a class="td-action" href="@whatsApp" target="_blank" rel="noopener noreferrer" aria-label="@L["Escribir a {0} por WhatsApp", student.StudentName]"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.7 7.1L4 20l.9-4.2A8 8 0 1 1 20 12Z" /><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .5c-.8-.4-1.6-1.2-2-2l.5-1-1-2Z" /></svg>@L["Contactar"]</a>
                        }
                        <a class="td-action" href="@($"users/{student.UserId:D}")" aria-label="@L["Ver detalle de {0}", student.StudentName]"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>@L["Ver detalle"]</a>
                    </div>
                </li>
            }
        </ul>
        <div class="data-table-scroll m-table" role="region" aria-label="@L["Estudiantes en riesgo"]" tabindex="0">
            <table class="td-table">
                <thead><tr><th scope="col">@L["Estudiante"]</th>@if (ShowCourse) { <th scope="col">@L["Curso"]</th> }<th scope="col">@L["Motivo"]</th><th scope="col">@L["Última actividad"]</th><th scope="col"><span class="data-table-sr-only">@L["Acciones"]</span></th></tr></thead>
                <tbody>
                    @foreach (var student in results.Items)
                    {
                        <tr @key="(student.UserId, student.ClassId)">
                            <th scope="row">@student.StudentName</th>
                            @if (ShowCourse) { <td>@student.ModuleName <small>@(student.Parallel is { Length: > 0 } p ? p + " · " : "")B@(student.Bimester)</small></td> }
                            <td>@Reason(student)</td>
                            <td>@LastActivity(student.LastTextAt)</td>
                            <td class="td-actions">
                                @if (WhatsAppLink(student.Phone) is { } whatsApp)
                                {
                                    <a class="td-action" href="@whatsApp" target="_blank" rel="noopener noreferrer" aria-label="@L["Escribir a {0} por WhatsApp", student.StudentName]"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.7 7.1L4 20l.9-4.2A8 8 0 1 1 20 12Z" /><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .5c-.8-.4-1.6-1.2-2-2l.5-1-1-2Z" /></svg>@L["Contactar"]</a>
                                }
                                <a class="td-action" href="@($"users/{student.UserId:D}")" aria-label="@L["Ver detalle de {0}", student.StudentName]"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>@L["Ver detalle"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="sh-pager" aria-label="@L["Páginas de estudiantes en riesgo"]">
            <span>@L["Mostrando {0}–{1} de {2}", (pageNumber - 1) * PageSize + 1, (pageNumber - 1) * PageSize + results.Items.Count, results.TotalCount]</span>
            @if (Pages > 1)
            {
                <div>
                    <button type="button" aria-label="@L["Página anterior"]" disabled="@(loading || pageNumber == 1)" @onclick="() => LoadAsync(pageNumber - 1)">‹</button>
                    @foreach (var number in PageWindow())
                    {
                        <button type="button" aria-current="@(number == pageNumber ? "page" : null)" disabled="@loading" @onclick="() => LoadAsync(number)">@number</button>
                    }
                    <button type="button" aria-label="@L["Página siguiente"]" disabled="@(loading || pageNumber >= Pages)" @onclick="() => LoadAsync(pageNumber + 1)">›</button>
                </div>
            }
        </nav>
    }
</section>

@code {
    [Parameter] public string? AnchorId { get; set; }
    [Parameter] public Guid? ClassId { get; set; }
    [Parameter] public long NoTextsCount { get; set; }
    [Parameter] public long LowScoreCount { get; set; }
    [Parameter] public bool ShowCourse { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Bimester { get; set; }
    private const int PageSize = 5;
    private readonly CancellationTokenSource lifetime = new();
    private DashboardPage<AtRiskStudent>? results;
    private (Guid?, int?, int?) loadedScope;
    private bool initialized;
    private string reason = "NoTexts";
    private int pageNumber = 1;
    private bool loading;
    private string? error;

    private int Pages => results is null ? 0 : (int)((results.TotalCount + PageSize - 1) / PageSize);

    protected override async Task OnParametersSetAsync()
    {
        if (initialized && loadedScope == (ClassId, Year, Bimester)) return;
        // Abre la pestaña con estudiantes; si no hay sin textos pero sí con nota baja, empieza por esa.
        if (NoTextsCount == 0 && LowScoreCount > 0) reason = "LowScore";
        else if (LowScoreCount == 0 && NoTextsCount > 0) reason = "NoTexts";
        initialized = true;
        loadedScope = (ClassId, Year, Bimester);
        await LoadAsync(1);
    }

    private Task ChangeReasonAsync(string value)
    {
        if (reason == value) return Task.CompletedTask;
        reason = value;
        return LoadAsync(1);
    }

    private IEnumerable<int> PageWindow()
    {
        var first = Math.Max(1, Math.Min(pageNumber - 2, Pages - 4));
        return Enumerable.Range(first, Math.Min(5, Pages));
    }

    private async Task LoadAsync(int number)
    {
        if (loading || number < 1) return;
        loading = true;
        error = null;
        try
        {
            results = await Dashboard.GetAtRiskAsync(number, PageSize, ClassId, reason, cancellationToken: lifetime.Token, year: Year, bimester: Bimester);
            pageNumber = number;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { error = I18n.T("No se pudo cargar la lista de estudiantes en riesgo."); }
        finally { loading = false; }
    }

    /// <summary>Enlace wa.me con el teléfono en formato internacional (sin prefijo se asume Bolivia, 591); null si no hay un número usable.</summary>
    private static string? WhatsAppLink(string? phone)
    {
        var digits = new string((phone ?? "").Where(char.IsAsciiDigit).ToArray());
        if (digits.StartsWith("00")) digits = digits[2..];
        else if (!(phone ?? "").TrimStart().StartsWith('+') && digits.Length <= 8) digits = "591" + digits;
        return digits.Length is >= 8 and <= 15 ? $"https://wa.me/{digits}" : null;
    }

    private static string Reason(AtRiskStudent student)
    {
        var score = student.FinalScore ?? new[] { student.Exam1Score, student.Exam2Score }.Where(s => s is not null).Min();
        var low = score is { } s ? I18n.T("Nota baja ({0})", s.ToString("0.#", StudentDashboard.Culture)) : I18n.T("Nota baja");
        return student.Reason switch
        {
            "LowScoreNoTexts" => I18n.T("{0} y sin textos", low),
            "LowScore" => low,
            "NoTexts" => I18n.T("Sin textos analizados"),
            _ => student.Reason
        };
    }

    private static string LastActivity(DateTime? at)
    {
        if (at is not { } value) return "—";
        var days = (DateTime.Today - value.Date).Days;
        return days switch { <= 0 => I18n.T("Hoy"), 1 => I18n.T("Ayer"), < 30 => I18n.T("Hace {0} días", days), _ => value.ToString("dd/MM/yyyy", StudentDashboard.Culture) };
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
