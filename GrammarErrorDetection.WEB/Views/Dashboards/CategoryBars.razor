@using GrammarErrorDetection.Models.Dashboards

@* Barras horizontales de las categorías de error más frecuentes. *@
@if (Categories.Count == 0)
{
    <p class="sd-empty">Sin errores registrados. ¡Buen trabajo!</p>
}
else
{
    <ol class="sd-category-bars">
        @foreach (var category in Categories)
        {
            <li @key="category.ErrorClassificationId">
                <div class="sd-progress-head">
                    <span>@Label(category.ErrorClassificationName)</span>
                    <span>@category.ErrorCount @(ShowPrevious ? $"(antes {category.PreviousErrorCount ?? 0})" : "") · @StudentDashboard.Percent(category.ErrorPercentage)</span>
                </div>
                <div class="sd-meter sd-meter-warm" aria-hidden="true"><span style="width:@StudentDashboard.Width(category.ErrorPercentage)"></span></div>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public List<DashboardErrorCategory> Categories { get; set; } = [];
    [Parameter] public bool ShowPrevious { get; set; }

    // Las etiquetas del modelo llegan como simple_present; se muestran como "Simple present".
    internal static string Label(string name)
    {
        var text = name.Replace('_', ' ').Trim();
        return text.Length == 0 ? "Sin categoría" : char.ToUpperInvariant(text[0]) + text[1..];
    }
}
