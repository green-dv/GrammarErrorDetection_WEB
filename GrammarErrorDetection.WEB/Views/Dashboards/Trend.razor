@using System.Globalization

@* Tendencia de una tarjeta: últimos 30 días frente a los 30 anteriores. *@
@if (Text is { } text)
{
    <span class="sh-trend @(Good ? "is-good" : "is-bad")" title="@Title">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(Up ? "M12 19V5m-6 6 6-6 6 6" : "M12 5v14m-6-6 6 6 6-6")" /></svg>@text
    </span>
}

@code {
    [Parameter] public decimal? Now { get; set; }
    [Parameter] public decimal? Before { get; set; }
    /// <summary>Muestra la diferencia en puntos porcentuales (precisión) en lugar de la variación relativa.</summary>
    [Parameter] public bool Points { get; set; }
    [Parameter] public bool LowerIsBetter { get; set; }
    [Parameter] public string Title { get; set; } = "Últimos 30 días frente a los 30 anteriores";

    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("es-BO");
    private decimal Delta => (Now ?? 0) - (Before ?? 0);
    private bool Up => Delta > 0;
    private bool Good => LowerIsBetter ? Delta < 0 : Delta > 0;

    private string? Text
    {
        get
        {
            if (Now is null || Before is null || Delta == 0) return null;
            if (Points) return $"{(Up ? "+" : "−")}{Math.Abs(Delta).ToString("0.#", Culture)} pts";
            if (Before == 0) return Up ? "Aumentó" : "Se redujo";
            return $"{(Up ? "+" : "−")}{Math.Abs(Delta * 100 / Before.Value).ToString("0", Culture)} %";
        }
    }
}
