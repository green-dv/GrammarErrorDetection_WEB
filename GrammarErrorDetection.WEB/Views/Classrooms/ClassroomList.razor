@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory classrooms-page" aria-labelledby="classrooms-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">@L["CETI · GESTIÓN ACADÉMICA"]</p>
            <h1 id="classrooms-title">@L["Aulas"]</h1>
            <p>@L["Espacios donde se dictan los cursos y la capacidad de cada uno."]</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">@L["+ Nueva aula"]</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@L["Listado de aulas"]</h2><p>@L["Busca por nombre o capacidad. Deja los filtros vacíos para ver todas las aulas."]</p></div></header>
        <FilterPanel Model="filters" Title="@L["Filtrar aulas"]" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>@L["Nombre"]</span><InputText @bind-Value="filters.Name" placeholder="@L["Nombre del aula"]" maxlength="30" /></label>
                    <label class="data-table-field"><span>@L["Capacidad"]</span><InputNumber @bind-Value="filters.Capacity" placeholder="@L["Capacidad exacta"]" min="1" max="1000" /></label>
                    <label class="data-table-field"><span>@L["Estado"]</span>
                        <select @bind="statusFilter"><option value="">@L["Todos"]</option><option value="true">@L["Activas"]</option><option value="false">@L["Deshabilitadas"]</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">@L["Reintentar"]</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? L["Cargando aulas…"] : error is not null ? L["Consulta no disponible"] : I18n.T(total == 1 ? "{0} aula en total" : "{0} aulas en total", total))</p>

        <ListPager Top="true" Label="@L["Paginación de aulas"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="@L["Listado de aulas"]" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">@L["Nombre, capacidad, estado, fecha de creación y acciones de las aulas."]</caption>
                <thead><tr><th scope="col">@L["Nombre"]</th><th scope="col">@L["Capacidad"]</th><th scope="col">@L["Estado"]</th><th scope="col">@L["Creada"]</th><th scope="col" class="data-table-actions-heading">@L["Acciones"]</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="5" class="data-table-empty">@L["Cargando aulas…"]</td></tr>
                    }
                    else
                    {
                        @foreach (var room in classrooms)
                        {
                            <tr @key="room.Id">
                                <th scope="row"><span class="data-table-primary">@room.Name</span></th>
                                <td><span class="data-table-chip">@room.Capacity estudiantes</span></td>
                                <td><StatusPill Active="room.Active" On="Activa" Off="Deshabilitada" /></td>
                                <td><span class="data-table-secondary">@room.CreatedAt.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <RowActions Label="@room.Name" OnEdit="() => editing = room" OnDelete="() => statusClassroom = room" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!room.Active)" DeleteTitle="@(room.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (classrooms.Count == 0 && error is null)
                        {
                            <tr><td colspan="5" class="data-table-empty"><strong>@L["No se encontraron aulas"]</strong><p>@L["Prueba con otros filtros o crea una nueva."]</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="@L["Listado de aulas"]" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="@L["Cargando aulas…"]" /> }
                else
                {
                    @foreach (var room in classrooms)
                    {
                        <SimpleListCard @key="room.Id" Active="room.Active" ActiveText="Activa" InactiveText="Deshabilitada" Title="@room.Name" BadgeValue="@room.Capacity.ToString()" BadgeCaption="cupos">
                            <Subtitle>@L["Capacidad: {0} estudiantes", room.Capacity]</Subtitle>
                            <Detail>Creada el @room.CreatedAt.ToString("dd/MM/yyyy")</Detail>
                            <Actions><RowActions Label="@room.Name" OnEdit="() => editing = room" OnDelete="() => statusClassroom = room" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!room.Active)" DeleteTitle="@(room.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (classrooms.Count == 0 && error is null) { <ListCardEmpty Title="@L["No se encontraron aulas"]" Hint="@L["Prueba con otros filtros o crea una nueva."]" OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="@L["Paginación de aulas"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <ClassroomFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <ClassroomFormModal @key="editing.Id" Classroom="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusClassroom is not null)
{
    <ModalDialog Title="@(statusClassroom.Active ? L["Deshabilitar aula"] : L["Reactivar aula"])" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="ceti-modal-body">
            @if (statusError is not null) { <div class="ceti-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusClassroom.Active ? "deshabilitar" : "reactivar") el aula <strong>@statusClassroom.Name</strong>?</p>
            <p>@(statusClassroom.Active ? L["El aula se conserva con sus datos y su historial. Podrás reactivarla cuando quieras."] : L["El aula volverá a estar activa."])</p>
        </div>
        <footer class="ceti-modal-footer"><span role="status">@(updatingStatus ? L["Actualizando estado…"] : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusClassroom.Active ? L["Deshabilitar"] : L["Reactivar"])</button></div></footer>
    </ModalDialog>
}
