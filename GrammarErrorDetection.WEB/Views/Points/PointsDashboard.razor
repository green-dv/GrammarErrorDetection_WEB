<section class="points-dashboard" aria-labelledby="points-title">
    <header class="points-heading"><div><p class="portal-eyebrow">@L["CADA PASO CUENTA"]</p><h2 id="points-title">@L["Puntos y niveles"]</h2></div></header>
    @if (loading) { <p class="data-table-message" role="status">@L["Consultando tu progreso…"]</p> }
    @if (error is not null) { <div class="data-table-error" role="alert">@error <button type="button" class="data-table-text-button" disabled="@loading" @onclick="LoadAsync">@L["Reintentar"]</button></div> }
    @if (!loading && total is not null)
    {
        <div class="points-level-card">
            <span class="points-level-icon" aria-hidden="true">★</span>
            <div><span class="points-label">@L["NIVEL DEL ESTUDIANTE"]</span>
                @if (progress?.Current is { } current) { <h3>@L["Nivel {0} · {1}", current.Level, current.Name]</h3> }
                else { <h3>@(progress is null ? L["Nivel no disponible"] : L["Sin nivel alcanzado"])</h3> }
                <p>@L["Sigue aprendiendo y alcanza tu próxima meta."]</p>
            </div>
            @if (progress?.Next is { } next)
            {
                <div class="points-progress"><div><span>@L["Hacia el nivel {0} · {1}", next.Level, next.Name]</span><strong>@progress.Remaining pts restantes</strong></div><progress value="@progress.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" max="100" aria-label="@L["Progreso hacia el siguiente nivel"]">@progress.Percent.ToString("0") %</progress></div>
            }
            else if (progress?.Current is not null) { <p class="points-progress">@L["¡Alcanzaste el nivel máximo!"]</p> }
        </div>
        <div class="points-stats">
            <article><span>@L["Puntos totales"]</span><strong>@total.TotalPoints <small>pts</small></strong><p>@L["Acumulados en tus inscripciones"]</p></article>
            <article><span>@L["Para el siguiente nivel"]</span><strong>@(progress?.Remaining?.ToString() ?? "—") <small>@(progress?.Next is not null ? "pts" : "")</small></strong><p>@(progress?.Next is { } target ? I18n.T("Tu próxima meta: nivel {0}", target.Level) : progress?.Current is not null ? "Nivel máximo alcanzado" : "Sin siguiente nivel disponible")</p></article>
        </div>
    }
    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@L["Historial de puntos"]</h2><p>@L["Fecha, motivo y cantidad de cada movimiento."]</p></div></header>
        @if (historyError is not null) { <div class="data-table-error" role="alert">@historyError <button type="button" class="data-table-text-button" disabled="@historyLoading" @onclick="RetryHistoryAsync">@L["Reintentar historial"]</button></div> }
        @if (historyStatus is not null) { <p class="data-table-message" role="status">@historyStatus</p> }
        <ListPager Top="true" Label="@L["Paginación del historial de puntos"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangeHistorySizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@historyLoading" Page="page" PageOf="@PageOf" Info="@(historyLoading ? L["Consultando…"] : historyError is null ? HistoryRange : "")" PreviousDisabled="@(historyLoading || page <= 1)" NextDisabled="@(historyLoading || !hasNext)" OnPrevious="PreviousHistoryAsync" OnNext="NextHistoryAsync" />
        <div class="data-table-scroll" role="region" aria-label="@L["Historial de puntos"]" aria-busy="@historyLoading.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table data-table-cards"><caption class="data-table-sr-only">@L["Fecha, motivo y cantidad de los movimientos de puntos."]</caption><thead><tr><th scope="col">@L["Fecha"]</th><th scope="col">@L["Motivo"]</th><th scope="col">@L["Puntos"]</th></tr></thead><tbody>
                @if (historyLoading) { <tr><td colspan="3" class="data-table-empty" role="status">@L["Cargando historial…"]</td></tr> }
                else if (historyError is not null) { <tr><td colspan="3" class="data-table-empty">@L["Historial no disponible."]</td></tr> }
                else if (history.Count == 0) { <tr><td colspan="3" class="data-table-empty">@L["Aún no tienes movimientos de puntos registrados."]</td></tr> }
                else
                {
                    @foreach (var entry in history)
                    {
                        <tr @key="entry.Id"><td data-label="@L["Fecha"]"><time datetime="@entry.GrantedAt.ToString("s")">@entry.GrantedAt.ToString("dd/MM/yyyy HH:mm")</time></td><th data-label="@L["Motivo"]" scope="row">@entry.Reason @if (!entry.Active) { <StatusPill Active="false" Off="Inactivo" /> }</th><td data-label="@L["Puntos"]"><span class="points-amount @(entry.Amount < 0 ? "points-amount-negative" : entry.Amount == 0 ? "points-amount-zero" : "")">@(entry.Amount > 0 ? $"+{entry.Amount}" : entry.Amount.ToString())</span></td></tr>
                    }
                }
            </tbody></table>
        </div>
        <ListPager Label="@L["Paginación del historial de puntos"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangeHistorySizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@historyLoading" Page="page" PageOf="@PageOf" Info="@(historyLoading ? L["Consultando…"] : historyError is null ? HistoryRange : "")" PreviousDisabled="@(historyLoading || page <= 1)" NextDisabled="@(historyLoading || !hasNext)" OnPrevious="PreviousHistoryAsync" OnNext="NextHistoryAsync" />
    </div>
</section>
