@page "/register"
@page "/auth/register"
@layout AuthLayout
@using GrammarErrorDetection.WEB.Views.Auth.Components

<PageTitle>@L["Crear cuenta | CETI La Paz"]</PageTitle>
<AuthHeader Title="@L["Crea tu cuenta"]" Subtitle="@L["Completa tus datos y verifica tu correo."]" />

<EditForm EditContext="editContext" OnValidSubmit="SubmitRegistrationAsync" OnInvalidSubmit="ShowValidationErrors" novalidate autocomplete="off" class="auth-register-form" aria-describedby="register-errors">
    <LocalizedValidator />
    @if (!string.IsNullOrEmpty(status) || validationErrors.Count > 0)
    {
        <div id="register-errors" class="auth-errors" role="alert" aria-live="assertive">
            <p class="auth-errors-title">@L["Revisa los datos del registro"]</p>
            <ul>
                @if (!string.IsNullOrEmpty(status))
                {
                    <li>@status</li>
                }
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    <fieldset disabled="@busy" class="auth-register-fields">
        <div>
            <label for="register-first-name" class="auth-label">@L["Nombres"]</label>
            <InputText id="register-first-name" @bind-Value="model.FirstName" autocomplete="given-name" placeholder="@L["Tus nombres"]" class="auth-control px-4" />
        </div>
        <div>
            <label for="register-last-name" class="auth-label">@L["Apellidos"]</label>
            <InputText id="register-last-name" @bind-Value="model.LastName" autocomplete="family-name" placeholder="@L["Tus apellidos"]" class="auth-control px-4" />
        </div>
        <div>
            <label for="register-ci" class="auth-label">@L["CI"]</label>
            <InputText id="register-ci" @bind-Value="model.CI" placeholder="@L["Tu documento de identidad"]" class="auth-control px-4" />
        </div>
        <div>
            <label for="register-phone" class="auth-label">@L["Teléfono"]</label>
            <InputText id="register-phone" type="tel" @bind-Value="model.Phone" autocomplete="tel" placeholder="@L["Tu número de teléfono"]" class="auth-control px-4" />
        </div>
        <div>
            <label for="register-birth-date" class="auth-label">@L["Fecha de nacimiento"]</label>
            <InputDate id="register-birth-date" @bind-Value="model.BirthDate" autocomplete="bday" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="auth-control px-4" />
        </div>
        <div class="auth-register-email">
            <label for="register-email" class="auth-label">@L["Correo electrónico"]</label>
            <InputText id="register-email" name="signup-contact-email" type="email" @bind-Value="model.Email" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="nombre@correo.com" class="auth-control px-4" />
        </div>
        <AuthPasswordField Id="new-password" @bind-Value="model.Password" Autocomplete="new-password" Placeholder="@L["Crea una contraseña"]" Required="false" />
        <AuthPasswordField Id="confirm-password" Label="@L["Confirmar contraseña"]" @bind-Value="model.ConfirmPassword" Autocomplete="new-password" Placeholder="@L["Repite tu contraseña"]" Required="false" />
        <button type="submit" class="auth-submit auth-register-submit" aria-busy="@(busy ? "true" : "false")">
            @(busy ? L["Enviando…"] : L["Enviar código de verificación"])
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
        </button>
    </fieldset>
</EditForm>
<p class="auth-account-switch">@L["¿Ya tienes una cuenta?"] <a href="/auth/login" class="auth-link">@L["Inicia sesión"]</a></p>
