@page "/auth/change-password"
@layout AuthLayout
@using System.Net
@using GrammarErrorDetection.Services.Interfaces
@using GrammarErrorDetection.Services.Services.Auth
@using GrammarErrorDetection.WEB.Views.Auth.Components
@implements IDisposable
@inject PasswordChangeFlowState Flow
@inject IAuthService AuthService
@inject AuthSessionState Session
@inject NavigationManager Navigation

@* Cambio obligatorio de contraseña: cuenta creada por el coordinador o cambio exigido. El JWT llega al completarlo. *@
<PageTitle>Crea tu contraseña | CETI La Paz</PageTitle>
@if (Flow.HasPending)
{
    <AuthHeader Title="Crea tu nueva contraseña" Subtitle="@($"{(Flow.Name is { Length: > 0 } name ? name + ", tu" : "Tu")} cuenta usa una contraseña temporal. Crea una propia para continuar.")" />
    <form class="auth-register-form" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault aria-describedby="password-change-errors">
        @if (errors.Count > 0)
        {
            <div id="password-change-errors" class="auth-errors" role="alert"><ul>@foreach (var error in errors) { <li>@error</li> }</ul></div>
        }
        <fieldset disabled="@busy" class="auth-verification-fields">
            <label for="new-password" class="auth-label">Nueva contraseña</label>
            <input id="new-password" type="password" class="auth-control" autocomplete="new-password" minlength="8" maxlength="72" @bind="password" />
            <label for="confirm-password" class="auth-label">Confirmar contraseña</label>
            <input id="confirm-password" type="password" class="auth-control" autocomplete="new-password" maxlength="72" @bind="confirmation" />
            <p class="auth-verification-note">Mínimo 8 caracteres, con mayúsculas, minúsculas, números y un carácter especial. Debe ser distinta de la temporal.</p>
            <button type="submit" class="auth-submit auth-register-submit">@(busy ? "Guardando…" : "Guardar e iniciar sesión")</button>
        </fieldset>
    </form>
    <p class="auth-verification-note">Tienes hasta las @Flow.Ticket!.ExpiresAt.ToLocalTime().ToString("HH:mm") para completar este paso.</p>
    <button type="button" class="auth-link auth-cancel" @onclick="Cancel" disabled="@busy">Cancelar inicio de sesión</button>
}
else
{
    <AuthHeader Title="Vuelve a iniciar sesión" Subtitle="El cambio de contraseña venció o ya no está disponible." />
    <a href="/auth/login" class="auth-link mt-5 inline-block">Volver al inicio de sesión</a>
}

@code {
    private readonly CancellationTokenSource lifetime = new();
    private List<string> errors = [];
    private string password = string.Empty, confirmation = string.Empty;
    private bool busy;

    internal static List<string> Validate(string password, string confirmation)
    {
        // Misma política que Configuración > Contraseña y que la API.
        return GrammarErrorDetection.Models.Auth.PasswordPolicy.Validate(password, confirmation);
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        errors = Validate(password, confirmation);
        if (errors.Count > 0) return;
        busy = true;
        try
        {
            var email = Flow.Email ?? throw new InvalidOperationException("Vuelve a iniciar sesión.");
            var response = await AuthService.CompletePasswordChangeAsync(Flow.CreateRequest(password), lifetime.Token);
            if (response?.Data is not { RequiresPasswordChange: false } session || string.IsNullOrEmpty(session.AccessToken) || response.Error is { ErrorCode: not 0 })
            {
                errors = ["No se pudo completar el cambio. Vuelve a intentarlo."];
                return;
            }
            Session.SignIn(session, email, Flow.IsTotpEnabled);
            Flow.Clear();
            Navigation.NavigateTo("/home", replace: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            errors = ["La contraseña no es válida o es igual a la temporal. Elige otra."];
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            Flow.Clear();
            errors = ["El paso venció o ya se usó. Vuelve a iniciar sesión."];
        }
        catch (HttpRequestException) { errors = ["No se pudo conectar con la API. Inténtalo de nuevo."]; }
        catch (OperationCanceledException) { if (!lifetime.IsCancellationRequested) errors = ["La solicitud tardó demasiado. Inténtalo de nuevo."]; }
        catch (InvalidOperationException ex) { errors = [ex.Message]; }
        finally
        {
            busy = false;
        }
    }

    private void Cancel()
    {
        Flow.Clear();
        Navigation.NavigateTo("/auth/login");
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
        password = confirmation = string.Empty;
    }
}
