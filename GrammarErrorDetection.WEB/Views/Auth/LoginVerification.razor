@page "/auth/verify"
@layout AuthLayout
@using GrammarErrorDetection.WEB.Views.Auth.Components

<PageTitle>@L["Verificar acceso | CETI La Paz"]</PageTitle>
@if (Flow.HasPendingVerification)
{
    <AuthHeader Title="@(Flow.IsTotpSelected ? L["Abre tu autenticador"] : L["Revisa tu correo"])" Subtitle="@(Flow.IsTotpSelected ? L["Ingresa el código de tu aplicación autenticadora."] : I18n.T("Ingresa el código enviado a {0}.", Flow.PendingEmail))" />
    <EditForm EditContext="editContext" OnValidSubmit="VerifyAsync" OnInvalidSubmit="ShowValidationErrors" novalidate class="auth-register-form" aria-describedby="login-verification-errors">
        <LocalizedValidator />
        @if (!string.IsNullOrEmpty(status) || validationErrors.Count > 0)
        {
            <div id="login-verification-errors" class="auth-errors" role="alert">
                <ul>
                    @if (!string.IsNullOrEmpty(status))
                    {
                        <li>@status</li>
                    }
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <fieldset disabled="@busy" class="auth-verification-fields">
            <label for="login-code" class="auth-label">@L["Código de verificación"]</label>
            <InputText id="login-code" @bind-Value="model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" class="auth-control auth-code-control" />
            <button type="submit" class="auth-submit auth-register-submit">@(busy ? L["Verificando…"] : L["Verificar e iniciar sesión"])</button>
        </fieldset>
    </EditForm>
    @if (Flow.Challenge is { } challenge)
    {
        <p class="auth-verification-note">El código vence a las @challenge.ExpiresAt.ToLocalTime().ToString("HH:mm").</p>
    }
    <button type="button" class="auth-link auth-cancel" @onclick="Cancel" disabled="@busy">@L["Cancelar inicio de sesión"]</button>
}
else
{
    <AuthHeader Title="@L["Vuelve a iniciar sesión"]" Subtitle="@L["La verificación pendiente venció o ya no está disponible."]" />
    <a href="/auth/login" class="auth-link mt-5 inline-block">@L["Volver al inicio de sesión"]</a>
}
