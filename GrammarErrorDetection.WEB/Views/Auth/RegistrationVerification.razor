@page "/auth/register/verification"
@layout AuthLayout
@using GrammarErrorDetection.WEB.Views.Auth.Components

<PageTitle>@L["Verifica tu correo | Grammar Practice"]</PageTitle>
@if (completed)
{
    <AuthHeader Title="@L["Tu cuenta está lista"]" Subtitle="@L["El correo fue verificado y tu cuenta se creó correctamente."]" />
    <a href="/home" class="auth-link mt-5 inline-block">@L["Continuar al inicio"]</a>
}
else if (Flow.Challenge is { } challenge)
{
    <AuthHeader Title="@L["Verifica tu correo"]" Subtitle="@(I18n.T("Ingresa el código enviado a {0}.", challenge.Email))" />
    <EditForm EditContext="editContext" OnValidSubmit="ConfirmRegistrationAsync" OnInvalidSubmit="ShowValidationErrors" novalidate class="auth-register-form" aria-describedby="verification-errors">
        <LocalizedValidator />
        @if (!string.IsNullOrEmpty(status) || validationErrors.Count > 0)
        {
            <div id="verification-errors" class="auth-errors" role="alert">
                <ul>
                    @if (!string.IsNullOrEmpty(status))
                    {
                        <li>@status</li>
                    }
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <fieldset disabled="@busy" class="auth-verification-fields">
            <label for="registration-code" class="auth-label">@L["Código de verificación"]</label>
            <InputText id="registration-code" @bind-Value="model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" class="auth-control auth-code-control" />
            <button type="submit" class="auth-submit auth-register-submit">@(busy ? L["Verificando…"] : L["Verificar y crear cuenta"])</button>
        </fieldset>
    </EditForm>
    <p class="auth-verification-note">El código vence a las @challenge.ExpiresAt.ToLocalTime().ToString("HH:mm").</p>
    <button type="button" class="auth-link auth-cancel" @onclick="Cancel">@L["Cancelar registro"]</button>
}
else
{
    <AuthHeader Title="@L["Vuelve a comenzar"]" Subtitle="@L["El registro pendiente ya no está disponible o el código venció."]" />
    <a href="/auth/register" class="auth-link mt-5 inline-block">@L["Volver al registro"]</a>
}
