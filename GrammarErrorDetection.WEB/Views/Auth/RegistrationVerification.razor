@page "/auth/register/verification"
@layout AuthLayout
@using GrammarErrorDetection.WEB.Views.Auth.Components

<PageTitle>Verifica tu correo | CETI La Paz</PageTitle>
@if (completed)
{
    <AuthHeader Title="Tu cuenta está lista" Subtitle="El correo fue verificado y tu cuenta se creó correctamente." />
    <a href="/home" class="auth-link mt-5 inline-block">Continuar al inicio</a>
}
else if (Flow.Challenge is { } challenge)
{
    <AuthHeader Title="Verifica tu correo" Subtitle="@($"Ingresa el código enviado a {challenge.Email}.")" />
    <EditForm EditContext="editContext" OnValidSubmit="ConfirmRegistrationAsync" OnInvalidSubmit="ShowValidationErrors" novalidate class="auth-register-form" aria-describedby="verification-errors">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrEmpty(status) || validationErrors.Count > 0)
        {
            <div id="verification-errors" class="auth-errors" role="alert">
                <ul>
                    @if (!string.IsNullOrEmpty(status))
                    {
                        <li>@status</li>
                    }
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <fieldset disabled="@busy" class="auth-verification-fields">
            <label for="registration-code" class="auth-label">Código de verificación</label>
            <InputText id="registration-code" @bind-Value="model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" class="auth-control auth-code-control" />
            <button type="submit" class="auth-submit auth-register-submit">@(busy ? "Verificando…" : "Verificar y crear cuenta")</button>
        </fieldset>
    </EditForm>
    <p class="auth-verification-note">El código vence a las @challenge.ExpiresAt.ToLocalTime().ToString("HH:mm").</p>
    <button type="button" class="auth-link auth-cancel" @onclick="Cancel">Cancelar registro</button>
}
else
{
    <AuthHeader Title="Vuelve a comenzar" Subtitle="El registro pendiente ya no está disponible o el código venció." />
    <a href="/auth/register" class="auth-link mt-5 inline-block">Volver al registro</a>
}
