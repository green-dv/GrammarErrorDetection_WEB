@using System.Linq.Expressions

<div>
    <label for="@Id" class="auth-label">@Label</label>
    <div class="relative">
        <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="10" width="16" height="12" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg>
        <input id="@Id" name="@Id" type="@(visible ? "text" : "password")" value="@Value" @oninput="UpdateValue" autocomplete="@Autocomplete" placeholder="@Placeholder" required="@Required" class="auth-control pl-12 pr-14" aria-describedby="@DescribedBy" />
        <button type="button" @onclick="ToggleVisibility" class="absolute inset-y-1 right-1 flex w-12 items-center justify-center rounded-md text-muted transition-colors hover:bg-slate-50 hover:text-brand-blue" aria-label="@(visible ? $"Ocultar {Label.ToLowerInvariant()}" : $"Mostrar {Label.ToLowerInvariant()}")" aria-controls="@Id" aria-pressed="@(visible ? "true" : "false")">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (visible) { <path d="m3 3 18 18"/> }</svg>
        </button>
    </div>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public string Label { get; set; } = "Contraseña";
    [Parameter] public string Placeholder { get; set; } = "Ingresa tu contraseña";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    private bool visible;

    private void ToggleVisibility() => visible = !visible;

    private async Task UpdateValue(ChangeEventArgs args)
    {
        await ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
        if (EditContext is not null && ValueExpression is not null)
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
    }
}
