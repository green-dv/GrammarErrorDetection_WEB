<header>
    <p class="mb-5 text-xs font-bold tracking-[0.25em] text-brand-blue sm:text-sm">PORTAL ACADÉMICO</p>
    <h2 id="auth-title" class="text-3xl font-bold leading-tight tracking-[-0.04em] sm:text-4xl xl:text-[2.65rem]">@Title</h2>
    <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">@Subtitle</p>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;
}
