@using GrammarErrorDetection.Models.Gamification
@using GrammarErrorDetection.Services.Services.Auth
@inject AuthSessionState Session

@if (Allowed)
{
    <section class="users-page gamification-page" aria-labelledby="gamification-title">
        <header class="users-heading">
            <div><p class="users-eyebrow">@L["CETI · MOTIVACIÓN Y APRENDIZAJE"]</p><h1 id="gamification-title">@L["Gamificación"]</h1><p>@L["Consulta los logros, las recompensas y los desafíos de aprendizaje."]</p></div>
            <div class="gamification-header-actions">
                @if (achievementsTab) { <a class="data-table-button" href="/gamification/collections">@L["Colecciones de logros"]</a> }
                @if (CanManage) { <button class="data-table-button data-table-button-primary" disabled="@busy" @onclick="OpenCreate" aria-haspopup="dialog">+ @(achievementsTab ? L["Crear logro"] : L["Crear desafío"])</button> }
            </div>
        </header>
        <div class="gamification-tabs" aria-label="@L["Tipo de contenido"]">
            <button class="@(achievementsTab ? "is-selected" : "")" aria-pressed="@achievementsTab.ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => SwitchAsync(true)">@L["Logros"]</button>
            <button class="@(!achievementsTab ? "is-selected" : "")" aria-pressed="@(!achievementsTab).ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => SwitchAsync(false)">@L["Desafíos"]</button>
        </div>
        <div class="data-table-card">
            <header class="data-table-heading"><div><h2>@(achievementsTab ? L["Catálogo de logros"] : L["Desafíos de aprendizaje"])</h2><p>@(achievementsTab ? L["Configura recompensas, puntos y condiciones para obtenerlas."] : L["Gestiona las instrucciones, la vigencia y la publicación de los retos."])</p></div></header>
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy" class="gamification-filters data-filter-panel data-filter-panel-inset">
                    <div class="data-filter-heading"><span>@L["Filtrar catálogo"]</span><span>@L["Combina los campos que necesites"]</span></div>
                    @if (achievementsTab)
                    {
                        <label class="data-table-field"><span>@L["Nombre del logro"]</span><input @bind="name" placeholder="@L["Buscar por nombre"]" /></label>
                        <label class="data-table-field"><span>@L["Colección"]</span><select @bind="collectionId" disabled="@loadingCollections">
                            <option value="">@(loadingCollections ? L["Cargando colecciones…"] : L["Todas las colecciones"])</option>
                            @foreach (var collection in collections) { <option value="@collection.Id">@collection.Name @(!collection.Active ? "(inactiva)" : "")</option> }
                        </select></label>
                    }
                    else
                    {
                        <label class="data-table-field"><span>@L["Publicación"]</span><select @bind="publication"><option value="">@L["Todos"]</option><option value="Draft">@L["Borrador"]</option><option value="Published">@L["Publicado"]</option></select></label>
                    }
                    <label class="data-table-field"><span>@L["Estado"]</span><select @bind="active"><option value="">@L["Todos"]</option><option value="true">@L["Activo"]</option><option value="false">@L["Inactivo"]</option></select></label>
                    <div class="data-filter-actions"><button type="submit" class="data-table-button data-table-button-primary">@L["Buscar"]</button>
                    <button type="button" class="data-table-button" @onclick="ClearAsync">@L["Limpiar"]</button>
                </div></fieldset>
            </form>
            @if (achievementsTab && collectionsError is not null) { <div class="data-table-error" role="alert">@collectionsError <button type="button" class="data-table-text-button" disabled="@loadingCollections" @onclick="LoadCollectionsAsync">@L["Reintentar colecciones"]</button></div> }
            @if (message is not null) { <p class="data-table-message" role="status">@message</p> }
            @if (error is not null) { <div class="data-table-error" role="alert">@error <button class="data-table-text-button" disabled="@busy" @onclick="() => LoadAsync(page)">@L["Reintentar"]</button></div> }
            <p class="data-table-summary" role="status">@(busy ? L["Cargando…"] : I18n.T(total is null ? "{0} resultados en esta página" : "{0} resultados en total", total ?? RowCount))</p>
            @if (achievementsTab)
            {
                <div class="achievement-catalog-grid" role="region" aria-label="@L["Catálogo de logros"]" aria-busy="@busy.ToString().ToLowerInvariant()">
                    @if (busy) { <p class="achievement-catalog-empty" role="status">@L["Cargando logros…"]</p> }
                    else if (error is null)
                    {
                        @foreach (var item in achievements)
                        {
                            <article class="collection-achievement achievement-catalog-card" @key="item.Id" aria-label="@item.Name">
                                <div class="collection-achievement-image">
                                    @if (SafeIcon(item.IconLink) is { } icon) { <img src="@icon" alt="@L["Imagen del logro {0}", item.Name]" loading="lazy" /> }
                                    else { <span aria-hidden="true"><svg class="achievement-default-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0ZM7 6H4v2a3 3 0 0 0 3 3m10-5h3v2a3 3 0 0 1-3 3"/></svg></span> }
                                    @if (item.TierOrder is { } tier) { <span class="collection-tier">@L["Nivel {0}", tier]</span> }
                                </div>
                                <div class="collection-achievement-content">
                                    <div class="collection-achievement-state"><StatusPill Active="item.Active" On="Activo" Off="Inactivo" />@if (item.IsSecret) { <span class="data-table-chip">@L["Secreto"]</span> }</div>
                                    <h3>@item.Name</h3><p>@item.Description</p>
                                    <dl>
                                        <div><dt>@L["Colección"]</dt><dd>@(item.AchievementCollectionId is { } groupId ? item.AchievementCollectionName ?? collections.FirstOrDefault(collection => collection.Id == groupId)?.Name ?? L["Colección"] : L["Sin colección"])</dd></div>
                                        <div><dt>@L["Categoría"]</dt><dd>@(item.AchievementCategoryName ?? L["Sin categoría informada"])</dd></div>
                                        <div><dt>@(item.Conditions.Count > 1 ? L["Condiciones"] : L["Condición"])</dt><dd>@ConditionConfiguration.Summary(item.Conditions)</dd></div>
                                    </dl>
                                    <div class="achievement-catalog-footer"><strong class="gamification-points">@item.Points puntos</strong><GamificationActions Label="@(I18n.T("logro {0}", item.Name))" ViewHref="@($"/gamification/achievements/{item.Id:D}")" Active="item.Active" Disabled="busy" OnEdit="() => Edit(item)" OnToggleActive="() => OpenStatus(item)" /></div>
                                </div>
                            </article>
                        }
                        @if (achievements.Count == 0) { <div class="achievement-catalog-empty"><strong>@L["No se encontraron logros"]</strong><p>@L["Prueba con otra colección o cambia los filtros."]</p><button type="button" class="data-table-button" @onclick="ClearAsync">@L["Limpiar filtros"]</button></div> }
                    }
                </div>
            }
            else
            {
                <ListPager Top="true" Label="@L["Paginación"]" @bind-PageSize="pageSize" @bind-PageSize:after="SearchAsync" PageSizes="5,10,20" PageSizeLabel="@(achievementsTab ? L["Logros por página"] : L["Filas por página"])" PageSizeDisabled="@busy" Page="page" PageOf="@PageOf" Info="@PagerInfo" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || !hasNext)" OnPrevious="() => LoadAsync(page - 1)" OnNext="() => LoadAsync(page + 1)" />
                <div class="data-table-scroll" tabindex="0" role="region" aria-label="@L["Listado de desafíos"]" aria-busy="@busy.ToString().ToLowerInvariant()">
                    <table class="data-table data-table-cards">
                        <thead><tr><th scope="col">@L["Desafío"]</th><th scope="col">@L["Vigencia"]</th><th scope="col">@L["Puntos"]</th><th scope="col">@L["Estado"]</th><th scope="col">@L["Acciones"]</th></tr></thead>
                        <tbody>
                            @if (busy) { <tr><td colspan="5" class="data-table-empty">@L["Cargando…"]</td></tr> }
                            else if (error is null)
                            {
                            @foreach (var item in challenges)
                            {
                                <tr @key="item.Id">
                                    <th data-label="@L["Desafío"]" scope="row"><span class="data-table-primary">@item.Title</span><span class="data-table-secondary gamification-description">@item.Description</span><span class="data-table-secondary">@item.Difficulty · @(item.Conditions.Count == 0 ? L["Sin condiciones"] : item.Conditions.Count == 1 ? "1 condición" : I18n.T("{0} condiciones", item.Conditions.Count)) · Ronda @item.Round · @item.CompletionCount @(item.CompletionCount == 1 ? L["completó"] : "completaron")</span></th>
                                    <td data-label="@L["Vigencia"]"><span class="data-table-primary">@(item.StartDate?.ToString("dd/MM/yyyy HH:mm") ?? L["Sin fecha de inicio"])</span><span class="data-table-secondary">@(item.EndDate is { } end ? I18n.T("hasta {0:dd/MM/yyyy HH:mm}", end) : L["Sin fecha de fin"])</span></td>
                                    <td data-label="@L["Puntos"]"><span class="gamification-points">@item.Points pts</span></td><td data-label="@L["Estado"]"><span class="data-table-chip">@StatusLabel(item.Status)</span><span class="data-table-secondary">@(item.Active ? L["Activo"] : L["Inactivo"])</span></td>
                                    <td data-label=""><details><summary class="data-table-text-button">@L["Ver instrucciones"]</summary><p class="gamification-detail-description">@item.Instructions</p><p><strong>@L["Se completa con:"]</strong> @ConditionConfiguration.Summary(item.Conditions)</p></details>
                                        <div class="gamification-challenge-actions">
                                            <GamificationActions Label="@(I18n.T("desafío {0}", item.Title))" Disabled="busy" OnEdit="() => Edit(item)" />
                                            @if (CanManage)
                                            {
                                                @if (item.Status is "Published" or "Closed")
                                                {
                                                    <button type="button" class="data-table-text-button" disabled="@busy" title="@L["Abrir una nueva ronda con nuevas fechas"]" @onclick="() => OpenRepeat(item)">@L["Repetir"]</button>
                                                }
                                                <button type="button" class="data-table-text-button" disabled="@busy" title="@L["Crear una copia en borrador"]" @onclick="() => DuplicateAsync(item)">@L["Duplicar"]</button>
                                            }
                                        </div></td>
                                </tr>
                            }
                            }
                            @if (!busy && error is null && challenges.Count == 0) { <tr><td colspan="5" class="data-table-empty"><strong>@L["No se encontraron desafíos"]</strong><p>@L["Prueba con otros filtros."]</p></td></tr> }
                        </tbody>
                    </table>
                </div>
            }
            <ListPager Label="@L["Paginación"]" @bind-PageSize="pageSize" @bind-PageSize:after="SearchAsync" PageSizes="5,10,20" PageSizeLabel="@(achievementsTab ? L["Logros por página"] : L["Filas por página"])" PageSizeDisabled="@busy" Page="page" PageOf="@PageOf" Info="@PagerInfo" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || !hasNext)" OnPrevious="() => LoadAsync(page - 1)" OnNext="() => LoadAsync(page + 1)" />
        </div>
    </section>
    @if (CanManage && showEditor)
    {
        <GamificationEditor IsAchievement="achievementsTab" Achievement="editingAchievement" Challenge="editingChallenge" OnClose="CloseAndRefreshAsync" OnSaved="SavedAsync" />
    }
    @if (CanManage && statusAchievement is not null) { <GamificationStatusModal Achievement="statusAchievement" OnClose="CloseStatusAsync" OnChanged="StatusChangedAsync" /> }
    @if (CanManage && repeatingChallenge is not null) { <ChallengeRepeatModal Challenge="repeatingChallenge" OnClose="() => repeatingChallenge = null" OnRepeated="RepeatedAsync" /> }
}
