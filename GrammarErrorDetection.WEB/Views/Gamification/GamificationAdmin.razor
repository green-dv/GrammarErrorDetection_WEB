@using GrammarErrorDetection.Models.Gamification
@using GrammarErrorDetection.Services.Services.Auth
@inject AuthSessionState Session

@if (Allowed)
{
    <section class="users-page gamification-page" aria-labelledby="gamification-title">
        <header class="users-heading">
            <div><p class="users-eyebrow">CETI · MOTIVACIÓN Y APRENDIZAJE</p><h1 id="gamification-title">Gamificación</h1><p>Consulta los logros, las recompensas y los desafíos de aprendizaje.</p></div>
            <div class="gamification-header-actions">
                @if (achievementsTab) { <a class="data-table-button" href="/gamification/collections">Colecciones de logros</a> }
                @if (CanManage) { <button class="data-table-button data-table-button-primary" disabled="@busy" @onclick="OpenCreate" aria-haspopup="dialog">+ @(achievementsTab ? "Crear logro" : "Crear desafío")</button> }
            </div>
        </header>
        <div class="gamification-tabs" aria-label="Tipo de contenido">
            <button class="@(achievementsTab ? "is-selected" : "")" aria-pressed="@achievementsTab.ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => SwitchAsync(true)">Logros</button>
            <button class="@(!achievementsTab ? "is-selected" : "")" aria-pressed="@(!achievementsTab).ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => SwitchAsync(false)">Desafíos</button>
        </div>
        <div class="data-table-card">
            <header class="data-table-heading"><div><h2>@(achievementsTab ? "Catálogo de logros" : "Desafíos de aprendizaje")</h2><p>@(achievementsTab ? "Configura recompensas, puntos y condiciones para obtenerlas." : "Gestiona las instrucciones, la vigencia y la publicación de los retos.")</p></div></header>
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy" class="gamification-filters data-filter-panel data-filter-panel-inset">
                    <div class="data-filter-heading"><span>Filtrar catálogo</span><span>Combina los campos que necesites</span></div>
                    @if (achievementsTab)
                    {
                        <label class="data-table-field"><span>Nombre del logro</span><input @bind="name" placeholder="Buscar por nombre" /></label>
                        <label class="data-table-field"><span>Colección</span><select @bind="collectionId" disabled="@loadingCollections">
                            <option value="">@(loadingCollections ? "Cargando colecciones…" : "Todas las colecciones")</option>
                            @foreach (var collection in collections) { <option value="@collection.Id">@collection.Name @(!collection.Active ? "(inactiva)" : "")</option> }
                        </select></label>
                    }
                    else
                    {
                        <label class="data-table-field"><span>Publicación</span><select @bind="publication"><option value="">Todos</option><option value="Draft">Borrador</option><option value="Published">Publicado</option></select></label>
                    }
                    <label class="data-table-field"><span>Estado</span><select @bind="active"><option value="">Todos</option><option value="true">Activo</option><option value="false">Inactivo</option></select></label>
                    <div class="data-filter-actions"><button type="submit" class="data-table-button data-table-button-primary">Buscar</button>
                    <button type="button" class="data-table-button" @onclick="ClearAsync">Limpiar</button>
                </div></fieldset>
            </form>
            @if (achievementsTab && collectionsError is not null) { <div class="data-table-error" role="alert">@collectionsError <button type="button" class="data-table-text-button" disabled="@loadingCollections" @onclick="LoadCollectionsAsync">Reintentar colecciones</button></div> }
            @if (message is not null) { <p class="data-table-message" role="status">@message</p> }
            @if (error is not null) { <div class="data-table-error" role="alert">@error <button class="data-table-text-button" disabled="@busy" @onclick="() => LoadAsync(page)">Reintentar</button></div> }
            <p class="data-table-summary" role="status">@(busy ? "Cargando…" : $"{RowCount} resultados en esta página")</p>
            @if (achievementsTab)
            {
                <div class="achievement-catalog-grid" role="region" aria-label="Catálogo de logros" aria-busy="@busy.ToString().ToLowerInvariant()">
                    @if (busy) { <p class="achievement-catalog-empty" role="status">Cargando logros…</p> }
                    else if (error is null)
                    {
                        @foreach (var item in achievements)
                        {
                            <article class="collection-achievement achievement-catalog-card" @key="item.Id" aria-label="@item.Name">
                                <div class="collection-achievement-image">
                                    @if (SafeIcon(item.IconLink) is { } icon) { <img src="@icon" alt="Imagen del logro @item.Name" loading="lazy" /> }
                                    else { <span aria-hidden="true">✦</span> }
                                    @if (item.TierOrder is { } tier) { <span class="collection-tier">Nivel @tier</span> }
                                </div>
                                <div class="collection-achievement-content">
                                    <div class="collection-achievement-state"><span class="data-table-status @(item.Active ? "is-active" : "is-inactive")">@(item.Active ? "Activo" : "Inactivo")</span>@if (item.IsSecret) { <span class="data-table-chip">Secreto</span> }</div>
                                    <h3>@item.Name</h3><p>@item.Description</p>
                                    <dl>
                                        <div><dt>Colección</dt><dd>@(item.AchievementCollectionId is { } groupId ? item.AchievementCollectionName ?? collections.FirstOrDefault(collection => collection.Id == groupId)?.Name ?? "Colección" : "Sin colección")</dd></div>
                                        <div><dt>Categoría</dt><dd>@(item.AchievementCategoryName ?? "Sin categoría informada")</dd></div>
                                        <div><dt>@(item.Conditions.Count > 1 ? "Condiciones" : "Condición")</dt><dd>@ConditionConfiguration.Summary(item.Conditions)</dd></div>
                                    </dl>
                                    <div class="achievement-catalog-footer"><strong class="gamification-points">@item.Points puntos</strong><GamificationActions Label="@($"logro {item.Name}")" ViewHref="@($"/gamification/achievements/{item.Id:D}")" Active="item.Active" Disabled="busy" OnEdit="() => Edit(item)" OnToggleActive="() => OpenStatus(item)" /></div>
                                </div>
                            </article>
                        }
                        @if (achievements.Count == 0) { <div class="achievement-catalog-empty"><strong>No se encontraron logros</strong><p>Prueba con otra colección o cambia los filtros.</p><button type="button" class="data-table-button" @onclick="ClearAsync">Limpiar filtros</button></div> }
                    }
                </div>
            }
            else
            {
                <div class="data-table-scroll" tabindex="0" role="region" aria-label="Listado de desafíos" aria-busy="@busy.ToString().ToLowerInvariant()">
                    <table class="data-table">
                        <thead><tr><th scope="col">Desafío</th><th scope="col">Vigencia</th><th scope="col">Puntos</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                        <tbody>
                            @if (busy) { <tr><td colspan="5" class="data-table-empty">Cargando…</td></tr> }
                            else if (error is null)
                            {
                            @foreach (var item in challenges)
                            {
                                <tr @key="item.Id">
                                    <th scope="row"><span class="data-table-primary">@item.Title</span><span class="data-table-secondary gamification-description">@item.Description</span><span class="data-table-secondary">@item.Difficulty · @(item.Conditions.Count == 0 ? "Sin condiciones" : item.Conditions.Count == 1 ? "1 condición" : $"{item.Conditions.Count} condiciones") · Ronda @item.Round · @item.CompletionCount @(item.CompletionCount == 1 ? "completó" : "completaron")</span></th>
                                    <td><span class="data-table-primary">@(item.StartDate?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha de inicio")</span><span class="data-table-secondary">@(item.EndDate is { } end ? $"hasta {end:dd/MM/yyyy HH:mm}" : "Sin fecha de fin")</span></td>
                                    <td><span class="gamification-points">@item.Points pts</span></td><td><span class="data-table-chip">@StatusLabel(item.Status)</span><span class="data-table-secondary">@(item.Active ? "Activo" : "Inactivo")</span></td>
                                    <td><details><summary class="data-table-text-button">Ver instrucciones</summary><p class="gamification-detail-description">@item.Instructions</p><p><strong>Se completa con:</strong> @ConditionConfiguration.Summary(item.Conditions)</p></details>
                                        <div class="gamification-challenge-actions">
                                            <GamificationActions Label="@($"desafío {item.Title}")" Disabled="busy" OnEdit="() => Edit(item)" />
                                            @if (CanManage)
                                            {
                                                @if (item.Status is "Published" or "Closed")
                                                {
                                                    <button type="button" class="data-table-text-button" disabled="@busy" title="Abrir una nueva ronda con nuevas fechas" @onclick="() => OpenRepeat(item)">Repetir</button>
                                                }
                                                <button type="button" class="data-table-text-button" disabled="@busy" title="Crear una copia en borrador" @onclick="() => DuplicateAsync(item)">Duplicar</button>
                                            }
                                        </div></td>
                                </tr>
                            }
                            }
                            @if (!busy && error is null && challenges.Count == 0) { <tr><td colspan="5" class="data-table-empty"><strong>No se encontraron desafíos</strong><p>Prueba con otros filtros.</p></td></tr> }
                        </tbody>
                    </table>
                </div>
            }
            <footer class="data-table-footer">
                <label class="data-table-page-size">@(achievementsTab ? "Logros por página" : "Filas por página") <select @bind="pageSize" @bind:after="SearchAsync" disabled="@busy"><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></label>
                <span>@(!busy && error is null && RowCount > 0 ? $"Mostrando {(page - 1) * pageSize + 1}–{(page - 1) * pageSize + RowCount}" : "")</span>
                <nav class="data-table-pagination" aria-label="Paginación"><button disabled="@(busy || page <= 1)" @onclick="() => LoadAsync(page - 1)" aria-label="Página anterior">‹</button><span>Página <strong>@(page)</strong></span><button disabled="@(busy || !hasNext)" @onclick="() => LoadAsync(page + 1)" aria-label="Página siguiente">›</button></nav>
            </footer>
        </div>
    </section>
    @if (CanManage && showEditor)
    {
        <GamificationEditor IsAchievement="achievementsTab" Achievement="editingAchievement" Challenge="editingChallenge" OnClose="CloseAndRefreshAsync" OnSaved="SavedAsync" />
    }
    @if (CanManage && statusAchievement is not null) { <GamificationStatusModal Achievement="statusAchievement" OnClose="CloseStatusAsync" OnChanged="StatusChangedAsync" /> }
    @if (CanManage && repeatingChallenge is not null) { <ChallengeRepeatModal Challenge="repeatingChallenge" OnClose="() => repeatingChallenge = null" OnRepeated="RepeatedAsync" /> }
}
