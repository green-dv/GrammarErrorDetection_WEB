@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory levels-page" aria-labelledby="levels-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">CETI · GAMIFICACIÓN</p>
            <h1 id="levels-title">Niveles de puntos</h1>
            <p>Niveles que alcanzan los usuarios al sumar puntos. Los puntos mínimos deben aumentar con el nivel y siempre debe haber un nivel activo con 0 puntos.</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">+ Nuevo nivel</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>Listado de niveles</h2><p>Busca por nombre. Deja los filtros vacíos para ver todos los niveles.</p></div></header>
        <FilterPanel Model="filters" Title="Filtrar niveles" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>Nombre</span><InputText @bind-Value="filters.Name" placeholder="Nombre del nivel" maxlength="50" /></label>
                    <label class="data-table-field"><span>Estado</span>
                        <select @bind="statusFilter"><option value="">Todos</option><option value="true">Activos</option><option value="false">Deshabilitados</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">Reintentar</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? "Cargando niveles…" : error is not null ? "Consulta no disponible" : $"{total} {(total == 1 ? "nivel" : "niveles")} en total")</p>

        <ListPager Top="true" Label="Paginación de niveles" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="Listado de niveles" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">Nombre, número de nivel, puntos mínimos, usuarios, estado y acciones de los niveles.</caption>
                <thead><tr><th scope="col">Nombre</th><th scope="col">Nivel</th><th scope="col">Puntos mínimos</th><th scope="col">Usuarios</th><th scope="col">Estado</th><th scope="col" class="data-table-actions-heading">Acciones</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="6" class="data-table-empty">Cargando niveles…</td></tr>
                    }
                    else
                    {
                        @foreach (var level in levels)
                        {
                            <tr @key="level.Id">
                                <th scope="row"><span class="data-table-primary">@level.Name</span></th>
                                <td><span class="data-table-chip">Nivel @level.Level</span></td>
                                <td><span class="data-table-primary">@level.MinPoints.ToString("N0")</span><span class="data-table-secondary"> puntos</span></td>
                                <td><span class="data-table-secondary">@level.UserCount @(level.UserCount == 1 ? "usuario" : "usuarios")</span></td>
                                <td><StatusPill Active="level.Active" On="Activo" Off="Deshabilitado" /></td>
                                <td>
                                    <RowActions Label="@level.Name" OnEdit="() => editing = level" OnDelete="() => statusLevel = level" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!level.Active)" DeleteTitle="@(level.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (levels.Count == 0 && error is null)
                        {
                            <tr><td colspan="6" class="data-table-empty"><strong>No se encontraron niveles</strong><p>Prueba con otros filtros o crea uno nuevo.</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">Limpiar filtros</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="Listado de niveles" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="Cargando niveles…" /> }
                else
                {
                    @foreach (var level in levels)
                    {
                        <SimpleListCard @key="level.Id" Active="level.Active" ActiveText="Activo" InactiveText="Deshabilitado" Title="@level.Name" BadgeValue="@level.Level.ToString()" BadgeCaption="nivel">
                            <Subtitle>Nivel @level.Level · desde @level.MinPoints.ToString("N0") puntos</Subtitle>
                            <Detail>@level.UserCount @(level.UserCount == 1 ? "usuario" : "usuarios") en este nivel</Detail>
                            <Actions><RowActions Label="@level.Name" OnEdit="() => editing = level" OnDelete="() => statusLevel = level" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!level.Active)" DeleteTitle="@(level.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (levels.Count == 0 && error is null) { <ListCardEmpty Title="No se encontraron niveles" Hint="Prueba con otros filtros o crea uno nuevo." OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="Paginación de niveles" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <UserLevelFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <UserLevelFormModal @key="editing.Id" Level="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusLevel is not null)
{
    <ModalDialog Title="@(statusLevel.Active ? "Deshabilitar nivel" : "Reactivar nivel")" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="ceti-modal-body">
            @if (statusError is not null) { <div class="ceti-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusLevel.Active ? "deshabilitar" : "reactivar") el nivel <strong>@statusLevel.Name</strong>?</p>
            <p>@(statusLevel.Active ? (statusLevel.UserCount > 0 ? $"{statusLevel.UserCount} {(statusLevel.UserCount == 1 ? "usuario pasará" : "usuarios pasarán")} al nivel que les corresponda por sus puntos. " : "") + "El nivel se conserva y podrás reactivarlo cuando quieras. Siempre debe quedar un nivel activo con 0 puntos." : "El nivel volverá a estar activo y se reasignará el nivel de los usuarios según sus puntos.")</p>
        </div>
        <footer class="ceti-modal-footer"><span role="status">@(updatingStatus ? "Actualizando estado…" : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">Cancelar</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusLevel.Active ? "Deshabilitar" : "Reactivar")</button></div></footer>
    </ModalDialog>
}
