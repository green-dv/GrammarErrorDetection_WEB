@using GrammarErrorDetection.Models.Registrations
@using GrammarErrorDetection.Services.Services.Auth
@using GrammarErrorDetection.WEB.Components.Dialogs
@using static GrammarErrorDetection.WEB.Views.Registrations.RegistrationViewSupport

@if (Allowed)
{
    <section class="users-page registrations-page" aria-labelledby="registrations-title">
        <header class="users-heading"><div><p class="users-eyebrow">@L["CETI · PORTAL ACADÉMICO"]</p><h1 id="registrations-title">@Title</h1><p>@(Mine ? L["Consulta tus solicitudes y su estado de aprobación."] : L["Revisa y resuelve las solicitudes de inscripción de los estudiantes."])</p></div>
            @if (Mine && !CoursesOnly)
            {
                <button type="button" class="data-table-button data-table-button-primary" disabled="@(loading || deciding)" @onclick="OpenApply" aria-haspopup="dialog">@L["Solicitar / editar inscripción"]</button>
            }
        </header>
        <div class="data-table-card">
            <header class="data-table-heading"><div><h2>@(CoursesOnly ? L["Cursos con inscripción activa"] : L["Solicitudes de inscripción"])</h2><p>@(CoursesOnly ? L["Las inscripciones rechazadas quedan fuera del curso."] : Mine ? L["Consulta tu historial de inscripciones y su estado."] : L["Consulta el historial por fecha, estudiante, módulo y estado."])</p></div></header>
            @if (!Mine)
            {
            <EditForm Model="filters" OnValidSubmit="SearchAsync" novalidate>
                <LocalizedValidator />
                <fieldset class="data-filter-panel data-filter-panel-inset" disabled="@(loading || deciding)">
                <div class="data-filter-heading"><span>@L["Filtrar inscripciones"]</span><span>@L["Combina los campos que necesites"]</span></div>
                    <div class="data-table-toolbar registration-filters">
                        <label class="data-table-field"><span>@L["Fecha de inscripción"]</span><InputDate @bind-Value="filters.RegistrationDate" /></label>
                        @if (!Mine) { <RegistrationFilterLookup Students="true" @bind-Value="filters.UserId" Disabled="@(loading || deciding)" /> }
                        <RegistrationFilterLookup @bind-Value="filters.ModuleNameId" Disabled="@(loading || deciding)" />
                        <label class="data-table-field"><span>@L["Estado"]</span><InputSelect @bind-Value="filters.Status"><option value="">@L["Todos"]</option><option value="Pending">@L["Pendiente"]</option><option value="Approved">@L["Aprobada"]</option><option value="Rejected">@L["Rechazada"]</option></InputSelect></label>
                    </div>
                    <div class="data-filter-actions"><button type="submit" class="data-table-button data-table-button-primary">@L["Buscar"]</button><button type="button" class="data-table-button" @onclick="ClearAsync">@L["Limpiar filtros"]</button></div>
                </fieldset>
                <div class="data-table-error"><ValidationSummary /></div>
            </EditForm>
            }
            @if (error is not null) { <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@loading">@L["Reintentar"]</button></div> }
            @if (message is not null) { <p class="data-table-message" role="status">@message</p> }
            <p class="data-table-summary" role="status">@(loading ? L["Cargando inscripciones…"] : I18n.T(total is null ? "{0} inscripciones en esta página" : "{0} inscripciones en total", total ?? entries.Count))</p>
            <ListPager Top="true" Label="@L["Paginación de inscripciones"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangeSizeAsync" PageSizes="5,20,50" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@(loading || deciding)" Page="page" PageOf="@PageOf" Info="@PagerInfo" PreviousDisabled="@(loading || deciding || page <= 1)" NextDisabled="@(loading || deciding || !hasNext)" OnPrevious="PreviousAsync" OnNext="NextAsync" />
            <div class="data-table-scroll registrations-table-region" role="region" aria-label="@L["Listado de inscripciones"]" aria-busy="@loading.ToString().ToLowerInvariant()" tabindex="0">
                <table class="data-table registrations-table">
                    <caption class="data-table-sr-only">@L["Fecha de inscripción, nombre, apellido, CIC y teléfono del estudiante, módulo, estado y actualización."]</caption>
                    <thead><tr><th scope="col">@L["Fecha de inscripción"]</th><th scope="col">@L["Nombre"]</th><th scope="col">@L["Apellido"]</th><th scope="col">@L["CIC"]</th><th scope="col">@L["Teléfono"]</th><th scope="col">@L["Módulo"]</th><th scope="col">@L["Estado"]</th><th scope="col">@L["Actualización"]</th></tr></thead>
                    <tbody>
                        @if (loading) { <tr><td colspan="@Columns" class="data-table-empty">@L["Cargando inscripciones…"]</td></tr> }
                        else
                        {
                            @foreach (var item in entries)
                            {
                                <tr @key="item">
                                    <th scope="row">@(item.RegistrationDate?.ToString("dd/MM/yyyy") ?? "—")</th>
                                    <td>@Text(item.FirstName)</td>
                                    <td>@Text(item.LastName)</td>
                                    <td>@Text(item.Ci)</td>
                                    <td>@Text(item.Phone)</td>
                                    <td>@Text(item.ModuleName)</td>
                                    <td><StatusPill Class="@StatusClass(item)" Text="@Status(item)" />
                                        @if (!Mine && IsPending(item))
                                        {
                                            <div class="registration-decision-actions"><button type="button" class="data-table-button data-table-button-primary" disabled="@deciding" @onclick="() => Review(item, true)" aria-label="@L["Aprobar inscripción de {0} {1}", item.FirstName, item.LastName]" aria-haspopup="dialog">@L["Aprobar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@deciding" @onclick="() => Review(item, false)" aria-label="@L["Rechazar inscripción de {0} {1}", item.FirstName, item.LastName]" aria-haspopup="dialog">@L["Rechazar"]</button></div>
                                        }
                                    </td>
                                    <td>@(item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                            @if (entries.Count == 0 && error is null) { <tr><td colspan="@Columns" class="data-table-empty"><strong>@L["No se encontraron inscripciones"]</strong><p>@(Mine ? L["Puedes enviar una solicitud desde Mis inscripciones."] : L["Prueba con otros filtros."])</p></td></tr> }
                        }
                    </tbody>
                </table>
            </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="@L["Inscripciones"]" aria-busy="@loading.ToString().ToLowerInvariant()">
                @if (loading) { <ListCardEmpty Message="@L["Cargando inscripciones…"]" /> }
                else
                {
                    @foreach (var item in entries)
                    {
                        var fullName = $"{Text(item.FirstName)} {Text(item.LastName)}";
                        var pending = IsPending(item);
                        <li class="lcard @(pending ? "is-pending" : "")" @key="item">
                            <div class="lcard-head">
                                @if (Mine)
                                {
                                    <div class="lcard-who"><strong>@Text(item.ModuleName)</strong><span>Inscripción del @(item.RegistrationDate?.ToString("dd/MM/yyyy") ?? "—")</span></div>
                                }
                                else
                                {
                                    <span class="lcard-avatar" aria-hidden="true">@($"{item.FirstName?.FirstOrDefault()}{item.LastName?.FirstOrDefault()}")</span>
                                    <div class="lcard-who"><strong>@fullName</strong><span>@L["CIC {0} · {1}", Text(item.Ci), Text(item.Phone)]</span></div>
                                }
                                <StatusPill Class="@StatusClass(item)" Text="@Status(item)" />
                            </div>
                            @if (!Mine)
                            {
                                <p class="lcard-module"><span>@L["Módulo"]</span><strong>@Text(item.ModuleName)</strong></p>
                            }
                            <dl class="lcard-grid">
                                @if (!Mine) { <div><dt>@L["Inscripción"]</dt><dd>@(item.RegistrationDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div> }
                                <div><dt>@L["Última actualización"]</dt><dd>@(item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
                            </dl>
                            @if (!Mine && pending)
                            {
                                <div class="lcard-actions"><button type="button" class="data-table-button data-table-button-primary" disabled="@deciding" @onclick="() => Review(item, true)" aria-label="@L["Aprobar inscripción de {0} {1}", item.FirstName, item.LastName]" aria-haspopup="dialog">@L["Aprobar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@deciding" @onclick="() => Review(item, false)" aria-label="@L["Rechazar inscripción de {0} {1}", item.FirstName, item.LastName]" aria-haspopup="dialog">@L["Rechazar"]</button></div>
                            }
                        </li>
                    }
                    @if (entries.Count == 0 && error is null) { <ListCardEmpty Title="@L["No se encontraron inscripciones"]" Hint="@(Mine ? L["Puedes enviar una solicitud desde Mis inscripciones."] : L["Prueba con otros filtros."])" /> }
                }
            </ul>
            <ListPager Label="@L["Paginación de inscripciones"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangeSizeAsync" PageSizes="5,20,50" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@(loading || deciding)" Page="page" PageOf="@PageOf" Info="@PagerInfo" PreviousDisabled="@(loading || deciding || page <= 1)" NextDisabled="@(loading || deciding || !hasNext)" OnPrevious="PreviousAsync" OnNext="NextAsync" />
        </div>
    </section>
    @if (reviewing is { } entry && !Mine)
    {
        <ModalDialog Title="@(approving ? L["Aprobar inscripción"] : L["Rechazar inscripción"])" Busy="deciding" OnClose="CloseReview">
            <div class="ceti-modal-body"><p>@L["Estudiante:"] <strong>@Text(entry.FirstName) @Text(entry.LastName)</strong></p><p>@L["CIC: {0} · Teléfono: {1}", Text(entry.Ci), Text(entry.Phone)]</p><p>@L["Módulo:"] <strong>@Text(entry.ModuleName)</strong></p>
                <p>@(approving ? L["Se comprobarán nuevamente la elegibilidad y el cupo. La aprobación bloquea nuevas solicitudes para el mismo periodo."] : L["La inscripción se desactivará. El estudiante dejará de pertenecer al curso y podrá enviar una nueva solicitud."])</p>
                @if (decisionError is not null) { <p class="ceti-modal-errors" role="alert">@decisionError</p> }
            </div>
            <footer class="ceti-modal-footer"><span>@(deciding ? L["Guardando decisión…"] : L["Confirma la decisión sobre esta solicitud."])</span><div><button type="button" class="data-table-button" disabled="@deciding" @onclick="CloseReview">@L["Cancelar"]</button><button type="button" class="data-table-button @(approving ? "data-table-button-primary" : "data-table-button-danger")" disabled="@deciding" @onclick="ConfirmAsync">@(approving ? L["Confirmar aprobación"] : L["Rechazar y desactivar"])</button></div></footer>
        </ModalDialog>
    }
    @if (applying && Mine && !CoursesOnly)
    {
        <ApplyRegistrationModal OnClose="CloseApply" OnSaved="AppliedAsync" />
    }
}



