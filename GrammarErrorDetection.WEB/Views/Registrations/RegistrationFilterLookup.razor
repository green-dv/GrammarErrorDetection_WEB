@using Microsoft.AspNetCore.Components.Web

<div class="data-table-field registration-lookup" @onkeydown="HandleKeyAsync">
    <span id="@(elementId + "-label")">@(Students ? L["Estudiante"] : L["Módulo"])</span>
    <div class="registration-lookup-control">
        <button type="button" class="registration-lookup-toggle" disabled="Disabled" aria-labelledby="@(elementId + "-label")" aria-expanded="@open.ToString().ToLowerInvariant()" aria-haspopup="listbox" @onclick="ToggleAsync">@(selectedLabel ?? (Students ? L["Todos los estudiantes"] : L["Todos los módulos"])) <span aria-hidden="true">⌄</span></button>
        @if (Value is not null) { <button type="button" class="registration-lookup-clear" disabled="Disabled" @onclick="ClearAsync" aria-label="@(Students ? L["Quitar filtro de estudiante"] : L["Quitar filtro de módulo"])">×</button> }
    </div>
    @if (open && !Disabled)
    {
        <button type="button" class="registration-lookup-backdrop" aria-label="@L["Cerrar selector"]" tabindex="-1" @onclick="Close"></button>
        <div class="registration-lookup-panel">
            @if (Students)
            {
                <label class="data-table-field"><span>@L["Buscar por"]</span><select value="@searchField" @onchange="ChangeFieldAsync"><option value="FirstName">@L["Nombre"]</option><option value="LastName">@L["Apellido"]</option><option value="Ci">@L["CIC"]</option><option value="Email">@L["Correo"]</option><option value="Phone">@L["Teléfono"]</option></select></label>
            }
            <label class="data-table-field"><span class="data-table-sr-only">@(Students ? L["Buscar estudiante"] : L["Buscar módulo por nombre"])</span><input @ref="searchInput" type="search" value="@term" @oninput="SearchChangedAsync" maxlength="@MaxLength" placeholder="@(Students ? L["Escribe para buscar…"] : L["Nombre del módulo…"])" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="@elementId" aria-activedescendant="@ActiveOptionId" autocomplete="off" /></label>
            @if (loading) { <p role="status">@L["Buscando…"]</p> }
            @if (error is not null) { <p role="alert">@error</p><button type="button" class="data-table-text-button" @onclick="RetryAsync">@L["Reintentar"]</button> }
            <div id="@elementId" role="listbox" aria-label="@(Students ? L["Estudiantes encontrados"] : L["Módulos encontrados"])" aria-busy="@loading.ToString().ToLowerInvariant()">
                @for (var index = 0; index < options.Count; index++)
                {
                    var option = options[index];
                    <button id="@(elementId + "-" + index)" type="button" role="option" aria-selected="@(Value == option.Id.ToString("D") ? "true" : "false")" class="registration-lookup-option @(activeIndex == index ? "active" : "")" @onclick="() => SelectAsync(option)"><strong>@option.Label</strong>@if (option.Detail is not null) { <small>@option.Detail</small> }</button>
                }
            </div>
            @if (!loading && error is null && options.Count == 0) { <p role="status">@L["Sin resultados para esta búsqueda."]</p> }
            <div class="registration-lookup-footer"><button type="button" class="data-table-button" disabled="@(loading || page <= 1)" @onclick="PreviousAsync" aria-label="@L["Opciones anteriores"]">‹</button><span>@L["Página {0} · hasta 5 opciones", page]</span><button type="button" class="data-table-button" disabled="@(loading || !hasNext)" @onclick="NextAsync" aria-label="@L["Opciones siguientes"]">›</button><button type="button" class="data-table-text-button" @onclick="Close">@L["Cerrar"]</button></div>
        </div>
    }
</div>
