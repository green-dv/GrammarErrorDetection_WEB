@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory conditions-page" aria-labelledby="conditions-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">@L["GAMIFICACIÓN"]</p>
            <h1 id="conditions-title">@L["Tipos de condición"]</h1>
            <p>@L["Condiciones medibles con las que se definen logros y desafíos. El código lo calcula el motor de gamificación y no se puede cambiar."]</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">@L["+ Nuevo tipo"]</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@L["Listado de tipos de condición"]</h2><p>@L["Busca por código o nombre. Deja los filtros vacíos para ver todos los tipos."]</p></div></header>
        <FilterPanel Model="filters" Title="@L["Filtrar tipos"]" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>@L["Código"]</span><InputText @bind-Value="filters.Code" placeholder="@L["Código del tipo"]" maxlength="50" /></label>
                    <label class="data-table-field"><span>@L["Nombre"]</span><InputText @bind-Value="filters.Name" placeholder="@L["Nombre del tipo"]" maxlength="100" /></label>
                    <label class="data-table-field"><span>@L["Estado"]</span>
                        <select @bind="statusFilter"><option value="">@L["Todos"]</option><option value="true">@L["Activos"]</option><option value="false">@L["Deshabilitados"]</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">@L["Reintentar"]</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? L["Cargando tipos de condición…"] : error is not null ? L["Consulta no disponible"] : I18n.T(total == 1 ? "{0} tipo en total" : "{0} tipos en total", total))</p>

        <ListPager Top="true" Label="@L["Paginación de tipos de condición"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll" role="region" aria-label="@L["Listado de tipos de condición"]" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table data-table-cards">
                <caption class="data-table-sr-only">@L["Nombre, código, descripción, condiciones que lo usan, estado y acciones de los tipos de condición."]</caption>
                <thead><tr><th scope="col">@L["Nombre"]</th><th scope="col">@L["Código"]</th><th scope="col">@L["Descripción"]</th><th scope="col">@L["En uso"]</th><th scope="col">@L["Estado"]</th><th scope="col" class="data-table-actions-heading">@L["Acciones"]</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="6" class="data-table-empty">@L["Cargando tipos de condición…"]</td></tr>
                    }
                    else
                    {
                        @foreach (var type in conditionTypes)
                        {
                            <tr @key="type.Id">
                                <th data-label="@L["Nombre"]" scope="row"><span class="data-table-primary">@type.Name</span></th>
                                <td data-label="@L["Código"]"><span class="data-table-chip">@type.Code</span></td>
                                <td data-label="@L["Descripción"]"><span class="data-table-secondary">@(string.IsNullOrWhiteSpace(type.Description) ? L["Sin descripción"] : type.Description)</span></td>
                                <td data-label="@L["En uso"]"><span class="data-table-secondary">@type.UsageCount @(type.UsageCount == 1 ? L["condición"] : "condiciones")</span></td>
                                <td data-label="@L["Estado"]"><StatusPill Active="type.Active" On="Activo" Off="Deshabilitado" /></td>
                                <td data-label="">
                                    <RowActions Label="@type.Name" OnEdit="() => editing = type" OnDelete="() => statusType = type" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!type.Active)" DeleteTitle="@(type.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (conditionTypes.Count == 0 && error is null)
                        {
                            <tr><td colspan="6" class="data-table-empty"><strong>@L["No se encontraron tipos de condición"]</strong><p>@L["Prueba con otros filtros o crea uno nuevo."]</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <ListPager Label="@L["Paginación de tipos de condición"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <ConditionTypeFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <ConditionTypeFormModal @key="editing.Id" Type="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusType is not null)
{
    <ModalDialog Title="@(statusType.Active ? L["Deshabilitar tipo de condición"] : L["Reactivar tipo de condición"])" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="gp-modal-body">
            @if (statusError is not null) { <div class="gp-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusType.Active ? "deshabilitar" : "reactivar") el tipo de condición <strong>@statusType.Name</strong>?</p>
            <p>@(statusType.Active ? (statusType.UsageCount > 0 ? (statusType.UsageCount == 1 ? L["1 condición activa de un logro o desafío usa este tipo y dejará de poder cumplirse mientras esté deshabilitado. "] : L["{0} condiciones activas de logros y desafíos usan este tipo y dejarán de poder cumplirse mientras esté deshabilitado. ", statusType.UsageCount]) : "") + L["El tipo se conserva y podrás reactivarlo cuando quieras."] : L["El tipo volverá a estar activo y las condiciones que lo usan podrán cumplirse de nuevo."])</p>
        </div>
        <footer class="gp-modal-footer"><span role="status">@(updatingStatus ? L["Actualizando estado…"] : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusType.Active ? L["Deshabilitar"] : L["Reactivar"])</button></div></footer>
    </ModalDialog>
}
