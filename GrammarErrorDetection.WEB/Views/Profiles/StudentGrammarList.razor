<section aria-labelledby="student-grammar-title">
    <div class="data-table-card">
        <header class="data-table-heading"><div><h2 id="student-grammar-title">Oraciones subidas</h2><p>Oraciones de los párrafos enviados por el usuario de este perfil.</p></div></header>
        @if (!Allowed)
        {
            <p class="portal-empty">No tienes permiso para consultar las oraciones de este usuario.</p>
        }
        else
        {
            <div class="data-table-toolbar">
                <label class="data-table-field"><span>Categoría del error</span><select @bind="category" @bind:after="FilterChanged" disabled="@(loading || error is not null)"><option value="">Todas las categorías</option>@foreach (var option in Categories) { <option value="@option.Id">@option.Name</option> }</select></label>
                <button type="button" class="data-table-button" disabled="@loading" @onclick="ReloadAsync">Actualizar</button>
            </div>
            @if (error is not null) { <div class="data-table-error" role="alert">@error <button type="button" class="data-table-text-button" disabled="@loading" @onclick="ReloadAsync">Reintentar</button></div> }
            <p class="data-table-summary" role="status">@(loading ? "Cargando los párrafos y sus oraciones…" : error is not null ? "Consulta no disponible" : $"{FilteredRows.Count} oraciones · {paragraphCount} párrafos consultados")</p>
            <div class="data-table-scroll" role="region" aria-label="Oraciones del usuario consultado" aria-busy="@loading.ToString().ToLowerInvariant()" tabindex="0">
                <table class="data-table profile-sentences-table">
                    <caption class="data-table-sr-only">Fecha de envío, oración original, corrección, categorías de error y cantidad total de errores de cada oración.</caption>
                    <thead><tr><th scope="col">Fecha de envío</th><th scope="col">Oración</th><th scope="col">Corrección</th><th scope="col">Categorías</th><th scope="col">Errores</th></tr></thead>
                    <tbody>
                        @if (loading) { <tr><td colspan="5" class="data-table-empty">Cargando oraciones…</td></tr> }
                        else if (error is not null) { <tr><td colspan="5" class="data-table-empty">No se pudo consultar el listado.</td></tr> }
                        else
                        {
                            @foreach (var row in VisibleRows)
                            {
                                <tr @key="(row.ParagraphId, row.Sentence.Id)">
                                    <td><time datetime="@row.SubmissionDate.ToString("s")">@row.SubmissionDate.ToString("dd/MM/yyyy HH:mm")</time><span class="data-table-secondary">Oración @row.Sentence.SentenceIndex</span></td>
                                    <th scope="row" lang="en">@row.Sentence.OriginalSentence</th>
                                    <td lang="en">@if (!string.IsNullOrWhiteSpace(row.Sentence.CorrectedSentence)) { @row.Sentence.CorrectedSentence } else { <span class="data-table-secondary">Sin corrección informada</span> }</td>
                                    <td>@foreach (var item in RowCategories(row.Sentence)) { <span class="data-table-status @(item.Id.ToString() == category ? "is-active" : "")">@item.Name</span> }@if (row.Sentence.Errors.Count == 0) { <span class="data-table-secondary">@(row.Sentence.ErrorCount == 0 ? "Sin errores detectados" : "Sin detalle de categorías")</span> }</td>
                                    <td>@Math.Max(row.Sentence.ErrorCount, row.Sentence.Errors.Count)</td>
                                </tr>
                            }
                            @if (FilteredRows.Count == 0) { <tr><td colspan="5" class="data-table-empty">@(string.IsNullOrEmpty(category) ? "Este usuario aún no tiene oraciones analizadas para mostrar." : "No hay oraciones con errores de esta categoría.")</td></tr> }
                        }
                    </tbody>
                </table>
            </div>
            <footer class="data-table-footer">
                <label class="data-table-page-size">Filas por página <select @bind="pageSize" @bind:after="FilterChanged" disabled="@loading"><option value="5">5</option><option value="20">20</option><option value="50">50</option></select></label>
                <span>El filtro incluye todas las oraciones cargadas de este usuario.</span>
                <nav class="data-table-pagination" aria-label="Paginación de oraciones"><button type="button" disabled="@(loading || page <= 1)" @onclick="PreviousPage" aria-label="Página anterior">‹</button><span>Página <strong>@(page)</strong></span><button type="button" disabled="@(loading || page * pageSize >= FilteredRows.Count)" @onclick="NextPage" aria-label="Página siguiente">›</button></nav>
            </footer>
        }
    </div>
</section>
