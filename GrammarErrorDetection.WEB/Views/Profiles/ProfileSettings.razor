@if (IsOwn)
{
    <div id="profile-account-security" class="settings-content">
        <h2>@L["Configura tu autenticador"]</h2>
        @if (confirmed || Session.IsTotpEnabled == true)
        {
            <p class="settings-status settings-success" role="status">@L["La autenticación TOTP está activada para esta cuenta."]</p>
        }
        else
        {
            <p>@L["Escanea el código QR con tu aplicación de autenticación e ingresa el código de seis dígitos."]</p>
            @if (!string.IsNullOrEmpty(status) || validationErrors.Count > 0)
            {
                <div class="auth-errors" role="alert"><ul>
                    @if (!string.IsNullOrEmpty(status)) { <li>@status</li> }
                    @foreach (var error in validationErrors) { <li>@error</li> }
                </ul></div>
            }
            @if (loading)
            {
                <p class="settings-status" role="status">@L["Preparando tu autenticador…"]</p>
            }
            else if (qrImage is not null)
            {
                <div class="settings-totp-layout">
                    <div>
                        <div class="settings-qr"><img src="@qrImage" alt="@L["Código QR para configurar tu autenticador CETI"]" width="220" height="220" /></div>
                        <details class="settings-manual-key"><summary>@L["¿No puedes escanear el QR?"]</summary><p>@L["Introduce esta clave en tu autenticador:"]</p><code>@manualKey</code></details>
                    </div>
                    <EditForm EditContext="editContext" OnValidSubmit="ConfirmTotpAsync" OnInvalidSubmit="ShowValidationErrors" novalidate class="settings-totp-fields">
                        <LocalizedValidator />
                        <fieldset disabled="@confirming">
                            <span class="settings-step">@L["VERIFICA TU CÓDIGO"]</span>
                            <label for="totp-setup-code" class="portal-field">@L["Código TOTP"]<InputText id="totp-setup-code" @bind-Value="model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" /></label>
                            <p>@L["Usa el código que aparece en tu aplicación."]</p>
                            <button type="submit" class="portal-button">@(confirming ? L["Validando…"] : L["Activar TOTP"])</button>
                        </fieldset>
                    </EditForm>
                </div>
            }
            else
            {
                <button type="button" class="portal-button" @onclick="SetupTotpAsync">@L["Preparar autenticador"]</button>
            }
        }
    </div>
}
