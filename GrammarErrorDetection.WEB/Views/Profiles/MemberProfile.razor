@using GrammarErrorDetection.Models.Gamification
@if (CanView)
{
    <section class="member-profile" aria-label="@L["Información y progreso del usuario"]">
        @if (ShowInformation)
        {
        <div class="member-overview">
            <article class="member-person">
                <span class="member-avatar" aria-hidden="true">@Initials(Name)</span>
                <div><p class="member-eyebrow">@L["PERFIL ACADÉMICO"]</p><h2>@Name</h2><p>@(member?.RoleName ?? (IsOwn ? string.Join(", ", Session.Roles) : L["Consultando información…"]))</p></div>
                @if (member is not null) { <span class="member-status">@(member.Active ? L["Cuenta activa"] : L["Cuenta inactiva"])</span> }
                <dl>
                    @if (CanViewContact)
                    {
                        <div><dt>@L["Correo electrónico"]</dt><dd>@Email</dd></div>
                        <div><dt>@L["Teléfono"]</dt><dd>@(member?.Phone ?? L["No informado"])</dd></div>
                        <div><dt>@L["Documento de identidad"]</dt><dd>@(member?.Ci ?? L["No disponible"])</dd></div>
                    }
                    @if (member is { BirthDate: { } birth } && string.Equals(member.RoleName, "Student", StringComparison.OrdinalIgnoreCase))
                    {
                        <div><dt>@L["Fecha de nacimiento"]</dt><dd>@birth.ToString("dd/MM/yyyy") <span class="member-age">@L["· {0} años", Age(birth)]</span></dd></div>
                    }
                    <div><dt>@L["Miembro desde"]</dt><dd>@(member?.CreatedAt.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                </dl>
                @if (loadingInfo) { <p role="status">@L["Consultando información…"]</p> }
                @if (infoError is not null) { <div class="data-table-error" role="alert">@infoError <button type="button" class="data-table-text-button" @onclick="ReloadAsync">@L["Reintentar"]</button></div> }
            </article>
            <div class="member-stats">
                <article><span class="member-stat-icon" aria-hidden="true">↗</span><div><span>@L["Nivel académico"]</span><strong>@(academicLevel?.ToString() ?? "—")</strong><small>@(academicLevel is null ? L["Sin nivel informado"] : L["Nivel del módulo actual"])</small></div></article>
                <article><span class="member-stat-icon" aria-hidden="true">▤</span><div><span>@L["Módulo actual"]</span><strong>@(member?.CurrentCourse?.ModuleName ?? "—")</strong><small>@(member?.CurrentCourse is { } course ? I18n.T("Bimestre {0} · {1} · Paralelo {2}", course.Bimester, course.Year, course.Parallel ?? "—") : L["Sin curso actual informado"])</small></div></article>
                @if (ShowAchievements)
                {
                    <article><span class="member-stat-icon member-stat-gold" aria-hidden="true"><svg class="achievement-default-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0ZM7 6H4v2a3 3 0 0 0 3 3m10-5h3v2a3 3 0 0 1-3 3"/></svg></span><div><span>@L["Puntos de estas medallas"]</span><strong>@(loadingMedals || medalsError is not null ? "—" : PageAwardPoints?.ToString() ?? "—")</strong><small>@L["Premios obtenidos · página actual"]</small></div></article>
                }
            </div>
        </div>
        }
        @if (ShowCourses)
        {
        @if (!ShowInformation && loadingInfo) { <p class="member-empty" role="status">@L["Consultando cursos…"]</p> }
        @if (!ShowInformation && infoError is not null) { <div class="data-table-error" role="alert">@infoError <button type="button" class="data-table-text-button" @onclick="ReloadAsync">@L["Reintentar"]</button></div> }
        @if (member?.CurrentCourse is { } currentCourse)
        {
            <article class="member-course"><div><p class="member-eyebrow">@L["CURSO ACTUAL"]</p><h3>@currentCourse.ModuleName</h3><p>@(currentCourse.TeacherName ?? L["Docente no informado"]) · @(currentCourse.ClassroomName ?? L["Aula no informada"])</p></div><div><span>@L["Nota final"]</span><strong>@(member.CurrentCourseFinalScore?.ToString("0.##") ?? L["Pendiente"])</strong></div></article>
        }
        else if (!ShowInformation && !loadingInfo && infoError is null) { <p class="member-empty">@L["No hay un curso actual informado para este perfil."]</p> }
        }
        @if (ShowAchievements)
        {
        @if (!ShowInformation)
        {
            <div class="member-achievement-summary"><span>@L["Puntos de estas medallas"]</span><strong>@(loadingMedals || medalsError is not null ? "—" : PageAwardPoints?.ToString() ?? "—")</strong><small>@L["Premios obtenidos · página actual"]</small></div>
        }
        <article class="member-medals-panel">
            <header class="member-panel-heading"><div><p class="member-eyebrow">@L["RECONOCIMIENTOS"]</p><h2>@(IsOwn ? L["Mis medallas"] : L["Medallas"])</h2><p>@L["El mejor nivel alcanzado en cada colección y el próximo objetivo."]</p></div><button type="button" class="data-table-button" disabled="@loadingMedals" @onclick="() => LoadMedalPageAsync(page)">@L["Actualizar"]</button></header>
            @if (loadingMedals) { <p class="member-empty" role="status">@L["Cargando medallas y próximos niveles…"]</p> }
            else if (medalsError is not null) { <div class="data-table-error" role="alert">@medalsError <button class="data-table-text-button" @onclick="() => LoadMedalPageAsync(page)">@L["Reintentar"]</button></div> }
            else if (medals.Count == 0) { <div class="member-empty"><span aria-hidden="true"><svg class="achievement-default-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0ZM7 6H4v2a3 3 0 0 0 3 3m10-5h3v2a3 3 0 0 1-3 3"/></svg></span><h3>@L["Aún no hay medallas para mostrar"]</h3><p>@L["Los reconocimientos del aprendizaje aparecerán aquí."]</p></div> }
            else
            {
                <div class="member-medals">
                    @foreach (var medal in medals)
                    {
                        <article class="member-medal @(medal.IsObtained ? "is-earned" : "is-pending")" @key="medal.Id">
                            <div class="member-medal-top"><span class="member-medal-state">@(medal.IsMaxTier ? L["Nivel máximo"] : medal.IsObtained ? L["Obtenida"] : L["Por obtener"])</span>@if (medal.AchievementCategoryName is { } category) { <small>@category</small> }</div>
                            @if (Icon(medal) is { } icon) { <img class="member-medal-icon" src="@icon" alt="" loading="lazy" /> } else { <div class="member-medal-symbol" aria-hidden="true"><svg class="achievement-default-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0ZM7 6H4v2a3 3 0 0 0 3 3m10-5h3v2a3 3 0 0 1-3 3"/></svg></div> }
                            <p class="member-medal-collection">@(medal.AchievementCollectionName ?? L["Logro individual"])</p><h3>@MedalName(medal)</h3>
                            <p class="member-medal-description">@(medal.IsObtained ? medal.BestAchievement?.Description ?? medal.Description : medal.NextAchievement?.Description ?? medal.Description)</p>
                            @if (medal.TierOrder is { } tier) { <span class="member-tier">@L["Nivel {0}", tier]</span> }
                            @if (medal.IsObtained)
                            {
                                <p class="member-award">@(medal.AwardPoints is { } points ? I18n.T("{0} puntos otorgados por esta medalla", points) : L["Puntos otorgados no informados"])</p>
                                @if (medal.ObtainedAt is { } date) { <small>Obtenida el @date.ToString("dd/MM/yyyy")</small> }
                            }
                            <div class="member-medal-progress">
                                @if (medal.IsMaxTier) { <strong>@L["Completaste todos los niveles"]</strong><progress max="100" value="100" aria-label="@L["Nivel máximo completado"]"></progress> }
                                else if (medal.HasNextAchievement || medal.NextAchievement is not null)
                                {
                                    <div><strong>@(medal.IsObtained ? I18n.T("Siguiente: {0}", medal.NextAchievement?.Name ?? L["próximo nivel"]) : L["Tu primer objetivo"])</strong><span>@(medal.ProgressPercent is { } percent ? $"{percent:0.##} %" : L["Sin progreso informado"])</span></div>
                                    @if (medal.ProgressPercent.HasValue) { <progress max="100" value="@Progress(medal)" aria-label="@L["Progreso hacia {0}", medal.NextAchievement?.Name]"></progress> }
                                    @if (medal.CurrentValue is { } value && medal.NextRequiredValue is { } target) { <p>@value.ToString("0.##") de @target.ToString("0.##") · @ConditionConfiguration.OperatorSymbol(medal.NextComparisonOperator)</p> }
                                    @if (medal.CanReachNext == false) { <p>@L["La siguiente meta no es alcanzable con el valor actual."]</p> }
                                    else if (medal.NextConditionMet == true) { <p>@L["Condición del siguiente nivel cumplida."]</p> }
                                    else if (medal.RemainingValue is { } remaining) { <p>Faltan @remaining.ToString("0.##") para el siguiente objetivo.</p> }
                                }
                            </div>
                        </article>
                    }
                </div>
            }
                <footer class="data-table-footer"><span role="status">@pageMessage</span><nav class="data-table-pagination" aria-label="@L["Paginación de medallas"]"><button disabled="@(loadingMedals || page <= 1)" @onclick="() => LoadMedalPageAsync(page - 1)" aria-label="@L["Página anterior de medallas"]">‹</button><span>@L["Página"] <strong>@(page)</strong></span><button disabled="@(loadingMedals || !hasNext)" @onclick="() => LoadMedalPageAsync(page + 1)" aria-label="@L["Página siguiente de medallas"]">›</button></nav></footer>
        </article>
        }
    </section>
}
