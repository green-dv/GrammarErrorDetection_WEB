@inject IJSRuntime JS

@* Configuración > Apariencia: tema claro, oscuro o el del sistema. La preferencia se guarda en este navegador
   (window.cetiTheme, definido en index.html) y se aplica al instante. *@
<div class="settings-content appearance-settings">
    <h2>Apariencia</h2>
    <p>Elige cómo se ve el portal en este navegador.</p>

    <div class="appearance-options" role="radiogroup" aria-label="Tema">
        @foreach (var option in Options)
        {
            var selected = choice == option.Key;
            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                    class="appearance-option @(selected ? "is-selected" : "")" disabled="@(!ready)" @onclick="() => SetAsync(option.Key)">
                @if (option.Key == "system")
                {
                    <div class="appearance-split" aria-hidden="true">
                        <ThemePreviewMini Dark="false" />
                        <ThemePreviewMini Dark="true" />
                    </div>
                }
                else
                {
                    <ThemePreviewMini Dark="@(option.Key == "dark")" />
                }
                <span class="appearance-label">
                    <span class="appearance-radio" aria-hidden="true"></span>
                    <strong>@option.Label</strong>
                </span>
                <small>@option.Help</small>
            </button>
        }
    </div>
    <p class="settings-status" role="status">@(ready ? $"Tema activo: {(applied == "dark" ? "oscuro" : "claro")}{(choice == "system" ? ", según tu sistema" : "")}." : "Cargando tu preferencia…")</p>
</div>

@code {
    private static readonly (string Key, string Label, string Help)[] Options =
    [
        ("light", "Claro", "Fondo blanco, ideal con mucha luz."),
        ("dark", "Oscuro", "Fondo azul oscuro, descansa la vista de noche."),
        ("system", "Según el sistema", "Cambia solo, igual que tu dispositivo.")
    ];
    private string choice = "system";
    private string applied = "light";
    private bool ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            choice = await JS.InvokeAsync<string>("cetiTheme.get");
            applied = await JS.InvokeAsync<string>("document.documentElement.getAttribute", "data-theme") ?? "light";
        }
        catch (JSException) { }
        ready = true;
        StateHasChanged();
    }

    private async Task SetAsync(string value)
    {
        choice = value;
        try { applied = await JS.InvokeAsync<string>("cetiTheme.set", value); }
        catch (JSException) { }
    }
}
