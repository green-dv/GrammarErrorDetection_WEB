@using System.Net
@using GrammarErrorDetection.Models.Auth
@using GrammarErrorDetection.Services.Interfaces
@implements IDisposable
@inject IUserService UserService

@* Configuración > Contraseña: la actual una vez y la nueva dos veces, con la política de contraseña segura. *@
<div class="settings-content password-settings">
    <h2>Cambiar contraseña</h2>
    <p>Para confirmar que eres tú, escribe primero tu contraseña actual.</p>

    @if (errors.Count > 0)
    {
        <div class="auth-errors" role="alert"><ul>@foreach (var problem in errors) { <li>@problem</li> }</ul></div>
    }
    @if (saved)
    {
        <p class="settings-status settings-success" role="status">Tu contraseña se cambió. Úsala la próxima vez que inicies sesión.</p>
    }

    <form class="password-form" @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
        <fieldset disabled="@busy">
            <label class="portal-field" for="current-password">Contraseña actual
                <span class="password-input">
                    <input id="current-password" type="@(show ? "text" : "password")" autocomplete="current-password" maxlength="72" @bind="current" @bind:event="oninput" />
                </span>
            </label>
            <label class="portal-field" for="new-password">Nueva contraseña
                <span class="password-input">
                    <input id="new-password" type="@(show ? "text" : "password")" autocomplete="new-password" maxlength="72" aria-describedby="password-rules" @bind="next" @bind:event="oninput" />
                </span>
            </label>
            <label class="portal-field" for="confirm-password">Repite la nueva contraseña
                <span class="password-input">
                    <input id="confirm-password" type="@(show ? "text" : "password")" autocomplete="new-password" maxlength="72" @bind="confirmation" @bind:event="oninput" />
                </span>
            </label>
            <label class="password-show"><input type="checkbox" @bind="show" /> Mostrar contraseñas</label>

            <ul id="password-rules" class="password-rules" aria-label="Requisitos de la nueva contraseña">
                @foreach (var (label, met) in PasswordPolicy.Check(next))
                {
                    <li class="@(met ? "is-met" : "")"><span aria-hidden="true">@(met ? "✓" : "•")</span>@label<span class="data-table-sr-only">@(met ? ": cumplido" : ": pendiente")</span></li>
                }
                <li class="@(confirmation.Length > 0 && confirmation == next ? "is-met" : "")"><span aria-hidden="true">@(confirmation.Length > 0 && confirmation == next ? "✓" : "•")</span>Las dos contraseñas nuevas coinciden</li>
                <li class="@(next.Length > 0 && next != current ? "is-met" : "")"><span aria-hidden="true">@(next.Length > 0 && next != current ? "✓" : "•")</span>Es distinta de la actual</li>
            </ul>

            <button type="submit" class="portal-button" disabled="@(busy || !CanSubmit)">@(busy ? "Cambiando…" : "Cambiar contraseña")</button>
        </fieldset>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private string current = string.Empty, next = string.Empty, confirmation = string.Empty;
    private List<string> errors = [];
    private bool busy, saved, show;

    private bool CanSubmit => current.Length > 0 && PasswordPolicy.IsStrong(next) && next == confirmation && next != current;

    private async Task SaveAsync()
    {
        if (busy) return;
        saved = false;
        errors = PasswordPolicy.Validate(next, confirmation);
        if (current.Length == 0) errors.Insert(0, "Escribe tu contraseña actual.");
        if (next.Length > 0 && next == current) errors.Add("La nueva contraseña debe ser distinta de la actual.");
        if (errors.Count > 0) return;

        busy = true;
        try
        {
            await UserService.ChangePasswordAsync(UserId, new() { Password = current, NewPassword = next }, lifetime.Token);
            current = next = confirmation = string.Empty;
            saved = true;
        }
        catch (HttpRequestException ex)
        {
            errors = [ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => ex.Message.Contains("actual", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("contraseña", StringComparison.OrdinalIgnoreCase)
                    ? ex.Message : "Revisa los datos e inténtalo de nuevo.",
                HttpStatusCode.Forbidden => "Solo puedes cambiar tu propia contraseña.",
                HttpStatusCode.Unauthorized => "Tu sesión expiró. Vuelve a iniciar sesión.",
                _ => "No se pudo cambiar la contraseña. Inténtalo de nuevo."
            }];
        }
        catch (OperationCanceledException) { }
        finally { busy = false; }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
