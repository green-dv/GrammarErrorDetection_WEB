@using GrammarErrorDetection.WEB.Views.Users

<section class="users-page course-detail" aria-labelledby="course-detail-title">
    <div class="course-detail-toolbar"><a href="/courses">@L["← Volver a cursos"]</a></div>
    @if (loading)
    {
        <h1 id="course-detail-title">@L["Estudiantes del curso"]</h1><p class="portal-empty" role="status">@L["Cargando información del curso…"]</p>
    }
    else if (error is not null)
    {
        <h1 id="course-detail-title">@L["Estudiantes del curso"]</h1><div class="course-detail-error" role="alert"><p>@error</p><button type="button" class="data-table-button" @onclick="LoadAsync">@L["Reintentar"]</button></div>
    }
    else if (course is not null)
    {
        <header class="users-heading"><div><p class="users-eyebrow">@L["DETALLE ACADÉMICO"]</p><h1 id="course-detail-title">Módulo @Text(course.ModuleName, "no informado")</h1><p>Paralelo @Text(course.Parallel, "—") · Bimestre @course.Bimester · @course.Year</p></div><span class="data-table-badge">@(course.Active ? L["Curso activo"] : L["Curso inactivo"])</span></header>
        <p><a class="data-table-button" href="@($"/courses/{course.Id:D}/grammar-report?courseName={Uri.EscapeDataString(course.ModuleName ?? L["Curso seleccionado"])}")">@L["Reporte gramatical del curso"]</a></p>
        <article class="course-detail-info" aria-label="@L["Datos del curso"]">
            <div class="course-detail-teacher"><span class="data-table-avatar" aria-hidden="true">@TeacherInitials(course.TeacherName)</span><div><span>@L["Profesor del curso"]</span><strong>@Text(course.TeacherName, "Sin profesor asignado")</strong></div></div>
            <dl><div><dt>@L["Nivel"]</dt><dd>@(course.ModuleLevel?.ToString() ?? "—")</dd></div><div><dt>@L["Horario"]</dt><dd>@Hour(course.StartTime) – @Hour(course.EndTime)</dd></div><div><dt>@L["Aula"]</dt><dd>@Text(course.ClassroomName, "Sin aula asignada")<small>Capacidad: @(course.ClassroomCapacity?.ToString() ?? "—")</small></dd></div><div><dt>@L["Fechas"]</dt><dd>@(course.StartDate?.ToString("dd/MM/yyyy") ?? "—")<small>al @(course.EndDate?.ToString("dd/MM/yyyy") ?? "—")</small></dd></div></dl>
        </article>
        <div class="courses-stats course-detail-stats">
            <article><div><p>@L["Estudiantes inscritos"]</p><strong>@(course.StudentCount?.ToString() ?? "—")</strong><span>@L["Total del curso"]</span></div></article>
            <article><div><p>@L["Promedio examen 1"]</p><strong class="@StudentGradeDraft.Color(course.Exam1Average)">@(course.Exam1Average?.ToString("0.##") ?? "—")<small> / 100</small></strong><span>@L["Primer examen"]</span></div></article>
            <article><div><p>@L["Promedio examen 2"]</p><strong class="@StudentGradeDraft.Color(course.Exam2Average)">@(course.Exam2Average?.ToString("0.##") ?? "—")<small> / 100</small></strong><span>@L["Segundo examen"]</span></div></article>
            <article><div><p>@L["Media de ambos exámenes"]</p><strong class="@StudentGradeDraft.Color(ExamsMean)">@(ExamsMean?.ToString("0.##") ?? "—")<small> / 100</small></strong><span>@L["Examen 1: 50 % · Examen 2: 50 %"]</span></div></article>
        </div>
        <UserList @key="course.Id" Course="course" />
    }
</section>
