@using static GrammarErrorDetection.WEB.Views.Courses.CourseDisplay

<section class="users-page courses-page" aria-labelledby="teacher-profile-courses-title">
    <div class="data-table-card">
        <header class="data-table-heading"><div><h2 id="teacher-profile-courses-title">Mis cursos como docente</h2><p>Cursos asignados a tu cuenta, incluidos los de periodos anteriores.</p></div></header>
        @if (!Allowed)
        {
            <p class="portal-empty">No tienes permiso para consultar estos cursos.</p>
        }
        else
        {
            @if (error is not null)
            {
                <div class="data-table-error" role="alert">@error <button type="button" class="data-table-text-button" disabled="@loading" @onclick="RetryAsync">Reintentar</button></div>
            }
            <p class="data-table-summary" role="status">@(loading ? "Cargando tus cursos…" : error is not null ? "Consulta no disponible" : $"{courses.Count} cursos en esta página")</p>
            <div class="data-table-scroll" role="region" aria-label="Cursos impartidos como docente" aria-busy="@loading.ToString().ToLowerInvariant()" tabindex="0">
                <table class="data-table courses-table">
                    <caption class="data-table-sr-only">Módulo, paralelo, periodo, horario, aula, cantidad de estudiantes y promedios del grupo.</caption>
                    <thead><tr><th scope="col">Módulo / paralelo</th><th scope="col">Periodo</th><th scope="col">Horario</th><th scope="col">Aula</th><th scope="col">Estudiantes</th><th scope="col">Promedio examen 1</th><th scope="col">Promedio examen 2</th><th scope="col">Acciones</th></tr></thead>
                    <tbody>
                        @if (loading) { <tr><td colspan="8" class="data-table-empty">Cargando tus cursos…</td></tr> }
                        else
                        {
                            @foreach (var course in courses)
                            {
                                <tr @key="course.Id">
                                    <th scope="row"><span class="data-table-primary">@Text(course.ModuleName, "Módulo sin informar")</span><span class="data-table-secondary">Paralelo @Text(course.Parallel, "—") <span class="data-table-status @(course.Active ? "is-active" : "is-inactive")">@(course.Active ? "Activo" : "Inactivo")</span></span></th>
                                    <td><span class="data-table-primary">@course.Year · Bimestre @course.Bimester</span><span class="data-table-secondary">@(course.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(course.EndDate?.ToString("dd/MM/yyyy") ?? "—")</span></td>
                                    <td>@Hour(course.StartTime) – @Hour(course.EndTime)</td>
                                    <td>@Text(course.ClassroomName, "Sin aula informada")</td>
                                    <td>@(course.StudentCount?.ToString() ?? "—")</td>
                                    <td>@if (course.Exam1Average is { } first) { <span class="data-table-grade">@first.ToString("0.##")</span><span class="data-table-grade-scale"> / 100</span> } else { <span class="data-table-secondary">Pendiente</span> }</td>
                                    <td>@if (course.Exam2Average is { } second) { <span class="data-table-grade">@second.ToString("0.##")</span><span class="data-table-grade-scale"> / 100</span> } else { <span class="data-table-secondary">Pendiente</span> }</td>
                                    <td><a class="data-table-text-button" href="@($"/courses/{course.Id:D}")" aria-label="Ver estudiantes de @course.ModuleName paralelo @course.Parallel">Ver estudiantes</a><br /><a class="data-table-text-button" href="@($"/courses/{course.Id:D}/grammar-report?courseName={Uri.EscapeDataString(course.ModuleName ?? "Curso seleccionado")}")">Reporte gramatical</a></td>
                                </tr>
                            }
                            @if (courses.Count == 0 && error is null) { <tr><td colspan="8" class="data-table-empty">No tienes cursos asignados en esta página.</td></tr> }
                        }
                    </tbody>
                </table>
            </div>
            <footer class="data-table-footer">
                <label class="data-table-page-size">Filas por página <select @bind="pageSize" @bind:after="ChangeSizeAsync" disabled="@loading"><option value="5">5</option><option value="20">20</option><option value="50">50</option></select></label>
                <span>Promedios del grupo · escala de 0 a 100.</span>
                <nav class="data-table-pagination" aria-label="Paginación de cursos impartidos"><button type="button" disabled="@(loading || page <= 1)" @onclick="PreviousAsync" aria-label="Página anterior">‹</button><span>Página <strong>@(page)</strong></span><button type="button" disabled="@(loading || !hasNext)" @onclick="NextAsync" aria-label="Página siguiente">›</button></nav>
            </footer>
        }
    </div>
</section>
