@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory categories-page" aria-labelledby="categories-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">@L["ANÁLISIS GRAMATICAL"]</p>
            <h1 id="categories-title">@L["Categorías de error"]</h1>
            <p>@L["Clasificaciones con las que se agrupan los errores gramaticales detectados en los textos."]</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">@L["+ Nueva categoría"]</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@L["Listado de categorías"]</h2><p>@L["Busca por nombre o descripción. Deja los filtros vacíos para ver todas las categorías."]</p></div></header>
        <FilterPanel Model="filters" Title="@L["Filtrar categorías"]" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>@L["Nombre"]</span><InputText @bind-Value="filters.Name" placeholder="@L["Nombre de la categoría"]" maxlength="100" /></label>
                    <label class="data-table-field"><span>@L["Descripción"]</span><InputText @bind-Value="filters.Description" placeholder="@L["Buscar en la descripción"]" /></label>
                    <label class="data-table-field"><span>@L["Estado"]</span>
                        <select @bind="statusFilter"><option value="">@L["Todas"]</option><option value="true">@L["Activas"]</option><option value="false">@L["Deshabilitadas"]</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">@L["Reintentar"]</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? L["Cargando categorías…"] : error is not null ? L["Consulta no disponible"] : I18n.T(total == 1 ? "{0} categoría en total" : "{0} categorías en total", total))</p>

        <ListPager Top="true" Label="@L["Paginación de categorías"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="@L["Listado de categorías"]" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">@L["Nombre, descripción, estado y acciones de las categorías de error gramatical."]</caption>
                <thead><tr><th scope="col">@L["Nombre"]</th><th scope="col">@L["Descripción"]</th><th scope="col">@L["Estado"]</th><th scope="col">@L["Creada"]</th><th scope="col" class="data-table-actions-heading">@L["Acciones"]</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="5" class="data-table-empty">@L["Cargando categorías…"]</td></tr>
                    }
                    else
                    {
                        @foreach (var category in categories)
                        {
                            <tr @key="category.Id">
                                <th scope="row"><span class="data-table-primary">@category.Name</span></th>
                                <td><span class="data-table-secondary">@(string.IsNullOrWhiteSpace(category.Description) ? L["Sin descripción"] : category.Description)</span></td>
                                <td><StatusPill Active="category.Active" On="Activa" Off="Deshabilitada" /></td>
                                <td><span class="data-table-secondary">@category.CreatedAt.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <RowActions Label="@category.Name" OnEdit="() => editing = category" OnDelete="() => statusCategory = category" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!category.Active)" DeleteTitle="@(category.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (categories.Count == 0 && error is null)
                        {
                            <tr><td colspan="5" class="data-table-empty"><strong>@L["No se encontraron categorías"]</strong><p>@L["Prueba con otros filtros o crea una nueva."]</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="@L["Listado de categorías"]" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="@L["Cargando categorías…"]" /> }
                else
                {
                    @foreach (var category in categories)
                    {
                        <SimpleListCard @key="category.Id" Active="category.Active" ActiveText="Activa" InactiveText="Deshabilitada" Title="@category.Name">
                            <ChildContent><p class="lcard-text">@(string.IsNullOrWhiteSpace(category.Description) ? L["Sin descripción"] : category.Description)</p></ChildContent>
                            <Detail>Creada el @category.CreatedAt.ToString("dd/MM/yyyy")</Detail>
                            <Actions><RowActions Label="@category.Name" OnEdit="() => editing = category" OnDelete="() => statusCategory = category" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!category.Active)" DeleteTitle="@(category.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (categories.Count == 0 && error is null) { <ListCardEmpty Title="@L["No se encontraron categorías"]" Hint="@L["Prueba con otros filtros o crea una nueva."]" OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="@L["Paginación de categorías"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <CategoryFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <CategoryFormModal @key="editing.Id" Category="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusCategory is not null)
{
    <ModalDialog Title="@(statusCategory.Active ? L["Deshabilitar categoría"] : L["Reactivar categoría"])" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="gp-modal-body">
            @if (statusError is not null) { <div class="gp-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusCategory.Active ? "deshabilitar" : "reactivar") la categoría <strong>@statusCategory.Name</strong>?</p>
            <p>@(statusCategory.Active ? L["La categoría se conserva con sus datos, pero dejará de usarse al analizar nuevos textos."] : L["La categoría volverá a estar disponible."])</p>
        </div>
        <footer class="gp-modal-footer"><span role="status">@(updatingStatus ? L["Actualizando estado…"] : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusCategory.Active ? L["Deshabilitar"] : L["Reactivar"])</button></div></footer>
    </ModalDialog>
}
