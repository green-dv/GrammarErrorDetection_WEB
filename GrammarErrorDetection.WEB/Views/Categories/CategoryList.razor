@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory categories-page" aria-labelledby="categories-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">CETI · ANÁLISIS GRAMATICAL</p>
            <h1 id="categories-title">Categorías de error</h1>
            <p>Clasificaciones con las que se agrupan los errores gramaticales detectados en los textos.</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">+ Nueva categoría</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>Listado de categorías</h2><p>Busca por nombre o descripción. Deja los filtros vacíos para ver todas las categorías.</p></div></header>
        <FilterPanel Model="filters" Title="Filtrar categorías" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>Nombre</span><InputText @bind-Value="filters.Name" placeholder="Nombre de la categoría" maxlength="100" /></label>
                    <label class="data-table-field"><span>Descripción</span><InputText @bind-Value="filters.Description" placeholder="Buscar en la descripción" /></label>
                    <label class="data-table-field"><span>Estado</span>
                        <select @bind="statusFilter"><option value="">Todas</option><option value="true">Activas</option><option value="false">Deshabilitadas</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">Reintentar</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? "Cargando categorías…" : error is not null ? "Consulta no disponible" : $"{total} {(total == 1 ? "categoría" : "categorías")} en total")</p>

        <ListPager Top="true" Label="Paginación de categorías" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="Listado de categorías" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">Nombre, descripción, estado y acciones de las categorías de error gramatical.</caption>
                <thead><tr><th scope="col">Nombre</th><th scope="col">Descripción</th><th scope="col">Estado</th><th scope="col">Creada</th><th scope="col" class="data-table-actions-heading">Acciones</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="5" class="data-table-empty">Cargando categorías…</td></tr>
                    }
                    else
                    {
                        @foreach (var category in categories)
                        {
                            <tr @key="category.Id">
                                <th scope="row"><span class="data-table-primary">@category.Name</span></th>
                                <td><span class="data-table-secondary">@(string.IsNullOrWhiteSpace(category.Description) ? "Sin descripción" : category.Description)</span></td>
                                <td><StatusPill Active="category.Active" On="Activa" Off="Deshabilitada" /></td>
                                <td><span class="data-table-secondary">@category.CreatedAt.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <RowActions Label="@category.Name" OnEdit="() => editing = category" OnDelete="() => statusCategory = category" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!category.Active)" DeleteTitle="@(category.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (categories.Count == 0 && error is null)
                        {
                            <tr><td colspan="5" class="data-table-empty"><strong>No se encontraron categorías</strong><p>Prueba con otros filtros o crea una nueva.</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">Limpiar filtros</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="Listado de categorías" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="Cargando categorías…" /> }
                else
                {
                    @foreach (var category in categories)
                    {
                        <SimpleListCard @key="category.Id" Active="category.Active" ActiveText="Activa" InactiveText="Deshabilitada" Title="@category.Name">
                            <ChildContent><p class="lcard-text">@(string.IsNullOrWhiteSpace(category.Description) ? "Sin descripción" : category.Description)</p></ChildContent>
                            <Detail>Creada el @category.CreatedAt.ToString("dd/MM/yyyy")</Detail>
                            <Actions><RowActions Label="@category.Name" OnEdit="() => editing = category" OnDelete="() => statusCategory = category" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!category.Active)" DeleteTitle="@(category.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (categories.Count == 0 && error is null) { <ListCardEmpty Title="No se encontraron categorías" Hint="Prueba con otros filtros o crea una nueva." OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="Paginación de categorías" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <CategoryFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <CategoryFormModal @key="editing.Id" Category="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusCategory is not null)
{
    <ModalDialog Title="@(statusCategory.Active ? "Deshabilitar categoría" : "Reactivar categoría")" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="ceti-modal-body">
            @if (statusError is not null) { <div class="ceti-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusCategory.Active ? "deshabilitar" : "reactivar") la categoría <strong>@statusCategory.Name</strong>?</p>
            <p>@(statusCategory.Active ? "La categoría se conserva con sus datos, pero dejará de usarse al analizar nuevos textos." : "La categoría volverá a estar disponible.")</p>
        </div>
        <footer class="ceti-modal-footer"><span role="status">@(updatingStatus ? "Actualizando estado…" : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">Cancelar</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusCategory.Active ? "Deshabilitar" : "Reactivar")</button></div></footer>
    </ModalDialog>
}
