@using GrammarErrorDetection.WEB.Views.Points
@using GrammarErrorDetection.WEB.Components.Tables
@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page @(IsCourseList ? "course-students-list" : "users-directory")" aria-labelledby="@(IsCourseList ? null : "users-title")" aria-label="@(IsCourseList ? ListTitle : null)">
    @if (!IsCourseList)
    {
        <header class="users-heading">
            <div class="users-heading-content">
                <p class="users-eyebrow">@L["COMUNIDAD ACADÉMICA"]</p>
                <h1 id="users-title">@L["Usuarios"]</h1>
                <p>@L["Datos de contacto y recorrido académico de los estudiantes."]</p>
            </div>
            @if (CanManageUsers)
            {
                <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || loadingCatalogs || roles.Count == 0)" @onclick="() => creatingUser = true" aria-haspopup="dialog">@L["+ Nuevo usuario"]</button>
            }
        </header>
    }
    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@ListTitle</h2><p>@(IsCourseList ? L["Datos de contacto, inscripción y notas de ambos exámenes."] : L["Busca por uno o varios campos. Deja los filtros vacíos para consultar todos los usuarios."])</p></div></header>
        <EditForm Model="filters" OnValidSubmit="SearchAsync" OnInvalidSubmit="ShowValidationErrors" novalidate>
            <LocalizedValidator />
            <div class="data-filter-panel data-filter-panel-inset">
                @if (!IsCourseList)
                {
                    <div class="data-filter-heading"><span>@L["Filtrar usuarios"]</span><span>@L["Combina los campos que necesites"]</span></div>
                }
                <div class="data-table-toolbar users-filters">
                    <label class="data-table-field"><span>@L["Nombre"]</span><InputText @bind-Value="filters.FirstName" placeholder="@L["Nombre"]" maxlength="50" /></label>
                    <label class="data-table-field"><span>@L["Apellido"]</span><InputText @bind-Value="filters.LastName" placeholder="@L["Apellido"]" maxlength="50" /></label>
                    <label class="data-table-field"><span>@L["Correo"]</span><InputText @bind-Value="filters.Email" placeholder="@L["Buscar correo"]" maxlength="100" /></label>
                    <label class="data-table-field"><span>@L["CI"]</span><InputText @bind-Value="filters.Ci" placeholder="@L["Documento de identidad"]" maxlength="15" /></label>
                    <label class="data-table-field"><span>@L["Teléfono"]</span><InputText @bind-Value="filters.Phone" placeholder="@L["Teléfono"]" maxlength="12" /></label>
                    <label class="data-table-field"><span>@L["Fecha de registro"]</span><InputDate @bind-Value="filters.CreatedAt" /></label>
                    @if (!IsCourseList)
                    {
                        <label class="data-table-field"><span>@L["Rol"]</span><InputSelect @bind-Value="filters.RoleId" disabled="@(loadingCatalogs || roles.Count == 0)"><option value="">@L["Todos los roles"]</option>@foreach (var role in roles) { <option value="@role.Id">@role.Name</option> }</InputSelect></label>
                        <label class="data-table-field"><span>@L["Curso actual"]</span><InputSelect @bind-Value="filters.CurrentModuleNameId" disabled="@(loadingCatalogs || modules.Count == 0)"><option value="">@L["Todos los módulos"]</option>@foreach (var module in modules) { <option value="@module.Id">@module.Name</option> }</InputSelect></label>
                    }
                    <label class="data-table-field"><span>@(IsCourseList ? L["Estado de cuenta"] : L["Estado"])</span><InputSelect @bind-Value="filters.Active"><option value="">@L["Todos"]</option><option value="true">@L["Activo"]</option><option value="false">@L["Inactivo"]</option></InputSelect></label>
                    <div class="data-filter-actions"><button type="submit" class="data-table-button data-table-button-primary" disabled="@busy">@L["Buscar"]</button><button type="button" class="data-table-button" @onclick="ClearFiltersAsync" disabled="@busy">@L["Limpiar filtros"]</button></div>
                </div>
            </div>
        </EditForm>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (catalogError is not null)
        {
            <div class="data-table-error" role="alert"><span>@catalogError</span><button type="button" class="data-table-text-button" @onclick="LoadCatalogsAsync" disabled="@loadingCatalogs">@L["Reintentar filtros"]</button></div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">@L["Reintentar"]</button></div>
        }
        @if (loadingGrades) { <p class="data-table-message" role="status">@L["Cargando evaluaciones…"]</p> }
        @if (gradesError is not null) { <div class="data-table-error" role="alert">@gradesError <button type="button" class="data-table-text-button" disabled="@(busy || loadingGrades)" @onclick="RetryGradesAsync">@L["Reintentar notas"]</button></div> }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? (IsCourseList ? L["Cargando estudiantes…"] : L["Cargando usuarios…"]) : error is not null ? L["Consulta no disponible"] : I18n.T(total is null ? (IsCourseList ? "{0} estudiantes en esta página" : "{0} usuarios en esta página") : (IsCourseList ? "{0} estudiantes en total" : "{0} usuarios en total"), total ?? users.Count))</p>

        <ListPager Top="true" Label="@(IsCourseList ? L["Paginación de estudiantes"] : L["Paginación de usuarios"])" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@PageOf" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || !hasNext)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll users-table-region" role="region" aria-label="@ListTitle" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table users-table @(IsCourseList ? "course-students-table" : "")">
                <caption class="data-table-sr-only">@(IsCourseList ? L["Estudiantes del curso seleccionado, contacto, inscripción, dos exámenes y promedio del curso."] : L["Contacto, curso anterior, curso actual, nota y acciones de los usuarios."])</caption>
                <thead><tr><th scope="col">@(IsCourseList ? L["Estudiante"] : L["Nombre y apellido"])</th><th scope="col">@L["CI / Teléfono"]</th>@if (IsCourseList) { <th scope="col">@L["Inscripción"]</th><th scope="col">@L["Examen 1"]</th><th scope="col">@L["Examen 2"]</th><th scope="col">@L["Promedio"]</th><th scope="col" class="course-grade-actions">@L["Acciones"]</th> } else { <th scope="col">@L["Anterior curso"]</th><th scope="col">@L["Curso actual"]</th><th scope="col">@L["Nota actual"]</th><th scope="col" class="data-table-actions-heading">@L["Acciones"]</th> }</tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="@ColumnCount" class="data-table-empty">@(IsCourseList ? L["Cargando estudiantes…"] : L["Cargando usuarios…"])</td></tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            <tr @key="user.Id">
                                <th scope="row"><div class="data-table-identity"><span class="data-table-avatar" aria-hidden="true">@Initials(user)</span><div><span class="data-table-primary">@FullName(user)</span><span class="data-table-secondary">@user.Email</span><div class="users-identity-tags">@if (!IsCourseList) { <span class="users-role">@(string.IsNullOrWhiteSpace(user.RoleName) ? L["Sin rol informado"] : user.RoleName)</span><StatusPill Active="user.Active" On="Activo" Off="@L["Inactivo"]" /> } else if (!user.Active) { <StatusPill Active="false" Off="@L["Cuenta inactiva"]" /> }</div></div></div></th>
                                <td><span class="data-table-primary">@user.Ci</span><span class="data-table-secondary">@(user.Phone ?? L["Sin teléfono"])</span></td>
                                @if (IsCourseList)
                                {
                                    <td><span class="data-table-chip">@RegistrationStatus(user)</span></td>
                                    @for (var exam = 0; exam < 2; exam++)
                                    {
                                        var score = GradeFor(user).Total(exam);
                                        <td><strong class="@StudentGradeDraft.Color(score)">@(score?.ToString("0.##") ?? "—")</strong><span class="data-table-grade-scale"> / 100</span></td>
                                    }
                                    <td><strong class="@StudentGradeDraft.Color(GradeFor(user).Average)">@(GradeFor(user).Average?.ToString("0.##") ?? "—")</strong><span class="data-table-grade-scale"> / 100</span><span class="data-table-secondary">@StudentGradeDraft.Result(GradeFor(user).Average)</span></td>
                                    <td class="course-grade-actions"><button type="button" class="data-table-row-button grade-register-button" disabled="@(!CanOpenGrades || loadingGrades || (CanRegisterGrades && (gradesError is not null || !gradeRegistrations.ContainsKey(user.Id))))" @onclick="() => OpenGrades(user)" title="@(!loadingGrades && !gradeRegistrations.ContainsKey(user.Id) ? L["No se recibió una inscripción válida para este módulo."] : L["Registrar notas"])" aria-label="@L["Registrar notas de {0}", FullName(user)]" aria-haspopup="dialog">@L["Registrar notas"]</button>@if (CanAssignPoints) { <button type="button" class="data-table-button data-table-row-button points-assign-button" disabled="@resolvingPoints" @onclick="() => OpenPoints(user)" aria-label="@L["Asignar puntos a {0}", FullName(user)]" aria-haspopup="dialog">@L["+ Asignar puntos"]</button> }</td>
                                }
                                else
                                {
                                    <td><span class="data-table-chip">@PreviousCourse(user)</span></td>
                                    <td><span class="data-table-primary">@CurrentCourse(user)</span><span class="data-table-secondary">@Schedule(user)</span></td>
                                    <td><span class="data-table-grade">@(user.CurrentCourseFinalScore?.ToString("0.##") ?? "—")</span>@if (user.CurrentCourseFinalScore is not null) { <span class="data-table-grade-scale"> / 100</span> }</td>
                                    <td><div class="points-user-actions"><RowActions Label="@FullName(user)" OnView="() => ViewProfile(user)" OnEdit="() => OpenEdit(user)" OnDelete="() => OpenStatus(user)" EditDisabled="@updatingStatus" DeleteDisabled="@updatingStatus" Restore="@(!user.Active)" DeleteTitle="@(user.Active ? L["Desactivar"] : L["Reactivar"])" />@if (CanManageUsers && user.Active && user.Id != Session.Current?.User?.Id) { <button type="button" class="data-table-button data-table-row-button" disabled="@resending" @onclick="() => resendUser = user" aria-label="@L["Reenviar credenciales a {0}", FullName(user)]" aria-haspopup="dialog">@L["Reenviar credenciales"]</button> }@if (CanAssignPoints) { <button type="button" class="data-table-button data-table-row-button points-assign-button" disabled="@resolvingPoints" @onclick="() => OpenPoints(user)" aria-label="@L["Asignar puntos a {0}", FullName(user)]" aria-haspopup="dialog">@L["+ Asignar puntos"]</button> }</div></td>
                                }
                            </tr>
                        }
                        @if (users.Count == 0 && error is null)
                        {
                            <tr><td colspan="@ColumnCount" class="data-table-empty"><strong>@(IsCourseList ? L["No se encontraron estudiantes en este curso"] : L["No se encontraron usuarios"])</strong><p>@L["Prueba con otros filtros."]</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
        <ul class="lcards" aria-label="@ListTitle" aria-busy="@busy.ToString().ToLowerInvariant()">
            @if (busy) { <li class="lcard-empty">@(IsCourseList ? L["Cargando estudiantes…"] : L["Cargando usuarios…"])</li> }
            else
            {
                @foreach (var user in users)
                {
                    var grade = GradeFor(user);
                    <li class="lcard @(user.Active ? "" : "is-inactive")" @key="user.Id">
                        <div class="lcard-head">
                            <span class="lcard-avatar" aria-hidden="true">@Initials(user)</span>
                            <div class="lcard-who"><strong>@FullName(user)</strong><span>@user.Email</span></div>
                            @if (!IsCourseList) { <StatusPill Active="user.Active" On="Activo" Off="@L["Inactivo"]" /> }
                            else if (!user.Active) { <StatusPill Active="false" Off="@L["Cuenta inactiva"]" /> }
                        </div>
                        <p class="lcard-tags">
                            @if (!IsCourseList) { <span class="users-role">@(string.IsNullOrWhiteSpace(user.RoleName) ? L["Sin rol informado"] : user.RoleName)</span> }
                            else { <span class="data-table-chip">@RegistrationStatus(user)</span> }
                            <span>@L["CI {0}", user.Ci]</span><span>@(user.Phone ?? L["Sin teléfono"])</span>
                        </p>
                        @if (IsCourseList)
                        {
                            <div class="lcard-grades">
                                @for (var exam = 0; exam < 2; exam++)
                                {
                                    var score = grade.Total(exam);
                                    <div><span>@L["Examen {0}", exam + 1]</span><strong class="@StudentGradeDraft.Color(score)">@(score?.ToString("0.##") ?? "—")</strong></div>
                                }
                                <div class="is-average"><span>@L["Promedio"]</span><strong class="@StudentGradeDraft.Color(grade.Average)">@(grade.Average?.ToString("0.##") ?? "—")</strong><small>@StudentGradeDraft.Result(grade.Average)</small></div>
                            </div>
                            <div class="lcard-actions">
                                <button type="button" class="data-table-button data-table-row-button grade-register-button" disabled="@(!CanOpenGrades || loadingGrades || (CanRegisterGrades && (gradesError is not null || !gradeRegistrations.ContainsKey(user.Id))))" @onclick="() => OpenGrades(user)" aria-label="@L["Registrar notas de {0}", FullName(user)]" aria-haspopup="dialog">@L["Registrar notas"]</button>
                                @if (CanAssignPoints) { <button type="button" class="data-table-button data-table-row-button points-assign-button" disabled="@resolvingPoints" @onclick="() => OpenPoints(user)" aria-label="@L["Asignar puntos a {0}", FullName(user)]" aria-haspopup="dialog">@L["+ Asignar puntos"]</button> }
                            </div>
                        }
                        else
                        {
                            <dl class="lcard-grid">
                                <div class="lcard-wide"><dt>@L["Curso actual"]</dt><dd>@CurrentCourse(user)<small>@Schedule(user)</small></dd></div>
                                <div><dt>@L["Curso anterior"]</dt><dd>@PreviousCourse(user)</dd></div>
                                <div><dt>@L["Nota actual"]</dt><dd class="lcard-score">@(user.CurrentCourseFinalScore?.ToString("0.##") ?? "—")@if (user.CurrentCourseFinalScore is not null) { <span> / 100</span> }</dd></div>
                            </dl>
                            <div class="lcard-actions">
                                <div class="points-user-actions"><RowActions Label="@FullName(user)" OnView="() => ViewProfile(user)" OnEdit="() => OpenEdit(user)" OnDelete="() => OpenStatus(user)" EditDisabled="@updatingStatus" DeleteDisabled="@updatingStatus" Restore="@(!user.Active)" DeleteTitle="@(user.Active ? L["Desactivar"] : L["Reactivar"])" />@if (CanManageUsers && user.Active && user.Id != Session.Current?.User?.Id) { <button type="button" class="data-table-button data-table-row-button" disabled="@resending" @onclick="() => resendUser = user" aria-label="@L["Reenviar credenciales a {0}", FullName(user)]" aria-haspopup="dialog">@L["Reenviar credenciales"]</button> }@if (CanAssignPoints) { <button type="button" class="data-table-button data-table-row-button points-assign-button" disabled="@resolvingPoints" @onclick="() => OpenPoints(user)" aria-label="@L["Asignar puntos a {0}", FullName(user)]" aria-haspopup="dialog">@L["+ Asignar puntos"]</button> }</div>
                            </div>
                        }
                    </li>
                }
                @if (users.Count == 0 && error is null) { <ListCardEmpty Title="@(IsCourseList ? L["No se encontraron estudiantes en este curso"] : L["No se encontraron usuarios"])" Hint="@L["Prueba con otros filtros."]" OnClear="ClearFiltersAsync" /> }
            }
        </ul>
        <ListPager Label="@(IsCourseList ? L["Paginación de estudiantes"] : L["Paginación de usuarios"])" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@PageOf" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || !hasNext)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (CanManageUsers && creatingUser)
{
    <UserCreateModal Roles="roles" OnClose="() => creatingUser = false" OnCreated="UserCreatedAsync" />
}
@if (CanManageUsers && resendUser is not null)
{
    <ModalDialog Title="@L["Reenviar credenciales"]" Busy="@resending" OnClose="() => { if (!resending) resendUser = null; }">
        <div class="gp-modal-body">
            @if (resendError is not null) { <div class="gp-modal-errors" role="alert"><p>@resendError</p></div> }
            <p>@L["Se generará una nueva contraseña temporal para"] <strong>@FullName(resendUser)</strong> @L["y se enviará a"] <strong>@resendUser.Email</strong>.</p>
            <p>@L["La contraseña actual dejará de funcionar y deberá crear una nueva al iniciar sesión."]</p>
        </div>
        <footer class="gp-modal-footer"><span role="status">@(resending ? L["Enviando…"] : "")</span><div><button type="button" class="data-table-button" disabled="@resending" @onclick="() => resendUser = null">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-primary" disabled="@resending" @onclick="ConfirmResendAsync">@L["Generar y enviar"]</button></div></footer>
    </ModalDialog>
}
@if (CanManageUsers && editingUser is not null)
{
    <UserEditModal @key="editingUser.Id" User="editingUser" Roles="roles" IsSelf="@(editingUser.Id == Session.Current?.User?.Id)" OnClose="CloseEdit" OnSaved="UserSavedAsync" />
}
@if (CanManageUsers && statusUser is not null)
{
    <ModalDialog Title="@(statusUser.Active ? L["Desactivar usuario"] : L["Reactivar usuario"])" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="gp-modal-body">
            @if (statusError is not null) { <div class="gp-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusUser.Active ? "desactivar" : "reactivar") a <strong>@FullName(statusUser)</strong>?</p>
            <p>@(statusUser.Active ? L["El usuario quedará inactivo. Sus datos se conservarán."] : L["El usuario volverá a estar activo."])</p>
        </div>
        <footer class="gp-modal-footer"><span role="status">@(updatingStatus ? L["Actualizando estado…"] : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusUser.Active ? L["Desactivar"] : L["Reactivar"])</button></div></footer>
    </ModalDialog>
}

@if (CanOpenGrades && gradingUser is not null)
{
    <StudentGradesModal @key="gradingUser.Id" Name="@FullName(gradingUser)" Email="@gradingUser.Email" Initials="@Initials(gradingUser)" Module="@Course!.ModuleName" Parallel="@Course.Parallel" TeacherId="@Course.TeacherId" RegistrationId="@gradeRegistrations.GetValueOrDefault(gradingUser.Id)" Value="@GradeFor(gradingUser)" OnClose="CloseGrades" OnSaved="SaveGrades" />
}

@if (CanAssignPoints && pointsUser is not null)
{
    <AssignPointsModal @key="pointsUser.Id" Name="@FullName(pointsUser)" RegistrationId="pointsRegistrationId" CourseName="@PointsCourseName" OnClose="ClosePoints" OnSaved="PointsSaved" />
}
