@using GrammarErrorDetection.WEB.Components.Dialogs

<ModalDialog Title="@L["Editar usuario"]" Busy="@saving" OnClose="OnClose">
    <p class="gp-modal-description">@User.FirstName @User.LastName</p>
    <EditForm EditContext="editContext" OnSubmit="SaveAsync" novalidate>
        <LocalizedValidator />
        <div class="gp-modal-body">
            @if (error is not null || validationErrors.Count > 0)
            {
                <div class="gp-modal-errors" role="alert">
                    @if (error is not null) { <p>@error</p> }
                    @foreach (var validationError in validationErrors) { <p>@validationError</p> }
                </div>
            }
            <fieldset disabled="@saving" class="users-edit-fields">
                <div class="users-edit-grid">
                    <label class="data-table-field"><span>@L["Nombre"]</span><input @bind="model.FirstName" @bind:event="oninput" maxlength="50" autofocus /></label>
                    <label class="data-table-field"><span>@L["Apellido"]</span><input @bind="model.LastName" @bind:event="oninput" maxlength="50" /></label>
                    <label class="data-table-field"><span>@L["CI"]</span><input @bind="model.Ci" @bind:event="oninput" maxlength="15" /></label>
                    <label class="data-table-field"><span>@L["Correo"]</span><input type="email" @bind="model.Email" @bind:event="oninput" maxlength="100" /></label>
                    <label class="data-table-field"><span>@L["Teléfono"]</span><input type="tel" @bind="model.Phone" @bind:event="oninput" maxlength="12" /></label>
                    <label class="data-table-field"><span>@L["Fecha de nacimiento"]</span><InputDate @bind-Value="model.BirthDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                    <label class="data-table-field"><span>@L["Rol"]</span>
                        <select value="@(model.RoleId?.ToString() ?? "")" disabled="@(IsSelf || Roles.Count == 0)" aria-describedby="user-role-help"
                                @onchange="args => model.RoleId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : model.RoleId">
                            @foreach (var role in Roles.Where(r => (r.Active && !string.Equals(r.Name, "Coordinator", StringComparison.OrdinalIgnoreCase)) || r.Id == User.RoleId))
                            {
                                <option value="@role.Id">@UserCreateModal.RoleLabel(role.Name)</option>
                            }
                        </select>
                        <small id="user-role-help" class="users-field-help">@(IsSelf ? L["No puedes cambiar tu propio rol."] : model.RoleChanged ? L["El cambio de rol se aplica en su próximo inicio de sesión."] : "")</small>
                    </label>
                </div>
            </fieldset>
        </div>
        <footer class="gp-modal-footer"><span role="status">@(saving ? L["Guardando cambios…"] : HasChanges ? L["Hay cambios pendientes."] : L["No hay cambios para guardar."])</span><div><button type="button" class="data-table-button" disabled="@saving" @onclick="OnClose">@L["Cancelar"]</button><button type="submit" class="data-table-button data-table-button-primary" disabled="@(saving || !HasChanges)">@L["Guardar cambios"]</button></div></footer>
    </EditForm>
</ModalDialog>
