@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory modules-page" aria-labelledby="modules-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">@L["CETI · GESTIÓN ACADÉMICA"]</p>
            <h1 id="modules-title">@L["Módulos"]</h1>
            <p>@L["Niveles del ciclo de cursos y el módulo al que se promueve a los estudiantes."]</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">@L["+ Nuevo módulo"]</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>@L["Listado de módulos"]</h2><p>@L["Busca por nombre o nivel. Deja los filtros vacíos para ver todos los módulos."]</p></div></header>
        <FilterPanel Model="filters" Title="@L["Filtrar módulos"]" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>@L["Nombre"]</span><InputText @bind-Value="filters.Name" placeholder="@L["Nombre del módulo"]" maxlength="30" /></label>
                    <label class="data-table-field"><span>@L["Nivel"]</span><InputNumber @bind-Value="filters.Level" placeholder="@L["Nivel"]" min="1" /></label>
                    <label class="data-table-field"><span>@L["Estado"]</span>
                        <select @bind="statusFilter"><option value="">@L["Todos"]</option><option value="true">@L["Activos"]</option><option value="false">@L["Deshabilitados"]</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">@L["Reintentar"]</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? L["Cargando módulos…"] : error is not null ? L["Consulta no disponible"] : I18n.T(total == 1 ? "{0} módulo en total" : "{0} módulos en total", total))</p>

        <ListPager Top="true" Label="@L["Paginación de módulos"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="@L["Listado de módulos"]" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">@L["Nombre, nivel, módulo siguiente, estado y acciones de los módulos."]</caption>
                <thead><tr><th scope="col">@L["Nombre"]</th><th scope="col">@L["Nivel"]</th><th scope="col">@L["Módulo siguiente"]</th><th scope="col">@L["Estado"]</th><th scope="col" class="data-table-actions-heading">@L["Acciones"]</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="5" class="data-table-empty">@L["Cargando módulos…"]</td></tr>
                    }
                    else
                    {
                        @foreach (var module in modules)
                        {
                            <tr @key="module.Id">
                                <th scope="row"><span class="data-table-primary">@module.Name</span></th>
                                <td><span class="data-table-chip">@L["Nivel {0}", module.Level]</span></td>
                                <td><span class="data-table-secondary">@(string.IsNullOrWhiteSpace(module.NextModuleName) ? L["Sin módulo siguiente"] : module.NextModuleName)</span></td>
                                <td><StatusPill Active="module.Active" On="Activo" Off="Deshabilitado" /></td>
                                <td>
                                    <RowActions Label="@module.Name" OnEdit="() => editing = module" OnDelete="() => statusModule = module" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!module.Active)" DeleteTitle="@(module.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (modules.Count == 0 && error is null)
                        {
                            <tr><td colspan="5" class="data-table-empty"><strong>@L["No se encontraron módulos"]</strong><p>@L["Prueba con otros filtros o crea uno nuevo."]</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">@L["Limpiar filtros"]</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="@L["Listado de módulos"]" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="@L["Cargando módulos…"]" /> }
                else
                {
                    @foreach (var module in modules)
                    {
                        <SimpleListCard @key="module.Id" Active="module.Active" ActiveText="Activo" InactiveText="Deshabilitado" Title="@module.Name" BadgeValue="@module.Level.ToString()" BadgeCaption="nivel">
                            <Subtitle>@L["Nivel {0}", module.Level]</Subtitle>
                            <ChildContent><p class="lcard-module"><span>@L["Módulo siguiente"]</span><strong>@(string.IsNullOrWhiteSpace(module.NextModuleName) ? L["Sin módulo siguiente"] : module.NextModuleName)</strong></p></ChildContent>
                            <Actions><RowActions Label="@module.Name" OnEdit="() => editing = module" OnDelete="() => statusModule = module" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!module.Active)" DeleteTitle="@(module.Active ? L["Deshabilitar"] : L["Reactivar"])" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (modules.Count == 0 && error is null) { <ListCardEmpty Title="@L["No se encontraron módulos"]" Hint="@L["Prueba con otros filtros o crea uno nuevo."]" OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="@L["Paginación de módulos"]" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="@L["Filas por página"]" PageSizeDisabled="@busy" Page="page" PageOf="@(I18n.T(" de {0}", TotalPages))" Info="@(busy ? L["Consultando…"] : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <ModuleFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <ModuleFormModal @key="editing.Id" Module="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusModule is not null)
{
    <ModalDialog Title="@(statusModule.Active ? L["Deshabilitar módulo"] : L["Reactivar módulo"])" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="ceti-modal-body">
            @if (statusError is not null) { <div class="ceti-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusModule.Active ? "deshabilitar" : "reactivar") el módulo <strong>@statusModule.Name</strong>?</p>
            <p>@(statusModule.Active ? L["El módulo se conserva con sus datos y su historial. Podrás reactivarlo cuando quieras."] : L["El módulo volverá a estar activo."])</p>
        </div>
        <footer class="ceti-modal-footer"><span role="status">@(updatingStatus ? L["Actualizando estado…"] : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">@L["Cancelar"]</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusModule.Active ? L["Deshabilitar"] : L["Reactivar"])</button></div></footer>
    </ModalDialog>
}
