@using GrammarErrorDetection.WEB.Components.Dialogs

<section class="users-page users-directory modules-page" aria-labelledby="modules-title">
    <header class="users-heading">
        <div class="users-heading-content">
            <p class="users-eyebrow">CETI · GESTIÓN ACADÉMICA</p>
            <h1 id="modules-title">Módulos</h1>
            <p>Niveles del ciclo de cursos y el módulo al que se promueve a los estudiantes.</p>
        </div>
        <button type="button" class="data-table-button data-table-button-primary" disabled="@(busy || updatingStatus)" @onclick="() => creating = true" aria-haspopup="dialog">+ Nuevo módulo</button>
    </header>

    <div class="data-table-card">
        <header class="data-table-heading"><div><h2>Listado de módulos</h2><p>Busca por nombre o nivel. Deja los filtros vacíos para ver todos los módulos.</p></div></header>
        <FilterPanel Model="filters" Title="Filtrar módulos" Busy="busy" OnSearch="SearchAsync" OnInvalid="ShowValidationErrors" OnClear="ClearFiltersAsync">
                    <label class="data-table-field"><span>Nombre</span><InputText @bind-Value="filters.Name" placeholder="Nombre del módulo" maxlength="30" /></label>
                    <label class="data-table-field"><span>Nivel</span><InputNumber @bind-Value="filters.Level" placeholder="Nivel" min="1" /></label>
                    <label class="data-table-field"><span>Estado</span>
                        <select @bind="statusFilter"><option value="">Todos</option><option value="true">Activos</option><option value="false">Deshabilitados</option></select>
                    </label>
        </FilterPanel>
        @if (validationErrors.Count > 0)
        {
            <div class="data-table-error" role="alert">@foreach (var validationError in validationErrors) { <p>@validationError</p> }</div>
        }
        @if (error is not null)
        {
            <div class="data-table-error" role="alert"><span>@error</span><button type="button" class="data-table-text-button" @onclick="RetryAsync" disabled="@busy">Reintentar</button></div>
        }
        @if (status is not null) { <p class="data-table-message" role="status">@status</p> }
        <p class="data-table-summary" role="status">@(busy ? "Cargando módulos…" : error is not null ? "Consulta no disponible" : $"{total} {(total == 1 ? "módulo" : "módulos")} en total")</p>

        <ListPager Top="true" Label="Paginación de módulos" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
        <div class="data-table-scroll simple-table-region" role="region" aria-label="Listado de módulos" aria-busy="@busy.ToString().ToLowerInvariant()" tabindex="0">
            <table class="data-table">
                <caption class="data-table-sr-only">Nombre, nivel, módulo siguiente, estado y acciones de los módulos.</caption>
                <thead><tr><th scope="col">Nombre</th><th scope="col">Nivel</th><th scope="col">Módulo siguiente</th><th scope="col">Estado</th><th scope="col" class="data-table-actions-heading">Acciones</th></tr></thead>
                <tbody>
                    @if (busy)
                    {
                        <tr><td colspan="5" class="data-table-empty">Cargando módulos…</td></tr>
                    }
                    else
                    {
                        @foreach (var module in modules)
                        {
                            <tr @key="module.Id">
                                <th scope="row"><span class="data-table-primary">@module.Name</span></th>
                                <td><span class="data-table-chip">Nivel @module.Level</span></td>
                                <td><span class="data-table-secondary">@(string.IsNullOrWhiteSpace(module.NextModuleName) ? "Sin módulo siguiente" : module.NextModuleName)</span></td>
                                <td><StatusPill Active="module.Active" On="Activo" Off="Deshabilitado" /></td>
                                <td>
                                    <RowActions Label="@module.Name" OnEdit="() => editing = module" OnDelete="() => statusModule = module" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!module.Active)" DeleteTitle="@(module.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" />
                                </td>
                            </tr>
                        }
                        @if (modules.Count == 0 && error is null)
                        {
                            <tr><td colspan="5" class="data-table-empty"><strong>No se encontraron módulos</strong><p>Prueba con otros filtros o crea uno nuevo.</p><button type="button" class="data-table-button" @onclick="ClearFiltersAsync">Limpiar filtros</button></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            @* Celular (≤640px): fichas en lugar de la tabla. En escritorio quedan ocultas por CSS. *@
            <ul class="lcards" aria-label="Listado de módulos" aria-busy="@busy.ToString().ToLowerInvariant()">
                @if (busy) { <ListCardEmpty Message="Cargando módulos…" /> }
                else
                {
                    @foreach (var module in modules)
                    {
                        <SimpleListCard @key="module.Id" Active="module.Active" ActiveText="Activo" InactiveText="Deshabilitado" Title="@module.Name" BadgeValue="@module.Level.ToString()" BadgeCaption="nivel">
                            <Subtitle>Nivel @module.Level</Subtitle>
                            <ChildContent><p class="lcard-module"><span>Módulo siguiente</span><strong>@(string.IsNullOrWhiteSpace(module.NextModuleName) ? "Sin módulo siguiente" : module.NextModuleName)</strong></p></ChildContent>
                            <Actions><RowActions Label="@module.Name" OnEdit="() => editing = module" OnDelete="() => statusModule = module" EditDisabled="updatingStatus" DeleteDisabled="updatingStatus" Restore="@(!module.Active)" DeleteTitle="@(module.Active ? "Deshabilitar" : "Reactivar")" DisableIcon="true" /></Actions>
                        </SimpleListCard>
                    }
                    @if (modules.Count == 0 && error is null) { <ListCardEmpty Title="No se encontraron módulos" Hint="Prueba con otros filtros o crea uno nuevo." OnClear="ClearFiltersAsync" /> }
                }
            </ul>
        <ListPager Label="Paginación de módulos" @bind-PageSize="pageSize" @bind-PageSize:after="ChangePageSizeAsync" PageSizes="5,10,20" PageSizeLabel="Filas por página" PageSizeDisabled="@busy" Page="page" PageOf="@($" de {TotalPages}")" Info="@(busy ? "Consultando…" : error is null ? ResultRange : "")" PreviousDisabled="@(busy || page <= 1)" NextDisabled="@(busy || page >= TotalPages)" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
    </div>
</section>

@if (creating)
{
    <ModuleFormModal OnClose="() => creating = false" OnSaved="CreatedAsync" />
}
@if (editing is not null)
{
    <ModuleFormModal @key="editing.Id" Module="editing" OnClose="() => editing = null" OnSaved="EditedAsync" />
}
@if (statusModule is not null)
{
    <ModalDialog Title="@(statusModule.Active ? "Deshabilitar módulo" : "Reactivar módulo")" Busy="@updatingStatus" OnClose="CloseStatus">
        <div class="ceti-modal-body">
            @if (statusError is not null) { <div class="ceti-modal-errors" role="alert"><p>@statusError</p></div> }
            <p>¿Quieres @(statusModule.Active ? "deshabilitar" : "reactivar") el módulo <strong>@statusModule.Name</strong>?</p>
            <p>@(statusModule.Active ? "El módulo se conserva con sus datos y su historial. Podrás reactivarlo cuando quieras." : "El módulo volverá a estar activo.")</p>
        </div>
        <footer class="ceti-modal-footer"><span role="status">@(updatingStatus ? "Actualizando estado…" : "")</span><div><button type="button" class="data-table-button" disabled="@updatingStatus" @onclick="CloseStatus">Cancelar</button><button type="button" class="data-table-button data-table-button-danger" disabled="@updatingStatus" @onclick="ConfirmStatusAsync">@(statusModule.Active ? "Deshabilitar" : "Reactivar")</button></div></footer>
    </ModalDialog>
}
