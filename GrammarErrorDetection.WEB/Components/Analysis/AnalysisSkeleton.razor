@* Esqueleto de carga: ocupa el lugar de la lista mientras se verifica el vocabulario. *@
<div class="an-skeleton" role="status" aria-live="polite">
    <span class="ceti-sr-only">@Message</span>
    @for (var row = 0; row < Rows; row++)
    {
        <div class="an-sk-row" aria-hidden="true"><i></i><i></i><i></i></div>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = I18n.T("Cargando…");
    [Parameter] public int Rows { get; set; } = 3;
}
