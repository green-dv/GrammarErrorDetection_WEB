@* Panel de análisis de un párrafo procesado: el párrafo completo con todas las marcas, las pestañas (errores gramaticales / vocabulary),
   el filtro y el plegado de oraciones, y el contenido de la pestaña. *@
@using GrammarErrorDetection.Models.Texts
@using GrammarErrorDetection.Models.Vocabulary
@using GrammarErrorDetection.WEB.Components.Vocabulary

<div class="an">
    <header class="an-head">
        <h2 id="nlp-analysis-title">@L["Análisis"]</h2>
        <span class="an-status">@Analysis.Status</span>
    </header>

    <ParagraphOverview Analysis="Analysis" Vocabulary="Vocabulary" Loading="VocabularyLoading" Error="@VocabularyError" Unavailable="@VocabularyUnavailable" OnRetry="OnRetryVocabulary" QuietStatus="@(View == AnalysisView.Vocabulary)" />

    <div class="an-tabs" role="tablist" aria-label="@L["Tipo de análisis"]">
        <button type="button" role="tab" id="an-tab-grammar" class="an-tab" aria-selected="@Selected(AnalysisView.Grammar)" aria-controls="an-panel"
                tabindex="@(View == AnalysisView.Grammar ? 0 : -1)" @ref="grammarTab" @onclick="() => SelectAsync(AnalysisView.Grammar)" @onkeydown="KeyDownAsync">
            <span>@L["Errores gramaticales"]</span><span class="an-count @(GrammarCount == 0 ? "is-zero" : "")">@GrammarCount</span>
        </button>
        <button type="button" role="tab" id="an-tab-vocabulary" class="an-tab" aria-selected="@Selected(AnalysisView.Vocabulary)" aria-controls="an-panel"
                tabindex="@(View == AnalysisView.Vocabulary ? 0 : -1)" @ref="vocabularyTab" @onclick="() => SelectAsync(AnalysisView.Vocabulary)" @onkeydown="KeyDownAsync">
            <span>@L["Vocabulary"]</span>
            @if (Vocabulary is not null) { <span class="an-count @(Vocabulary.IssueCount == 0 && Vocabulary.UncheckedCount == 0 ? "is-zero" : "is-vocab")">@Vocabulary.IssueCount</span> }
        </button>
    </div>

    <p class="ceti-sr-only" role="status" aria-live="polite">@LiveMessage</p>
    <div id="an-panel" class="an-panel" role="tabpanel" tabindex="0" aria-labelledby="@(View == AnalysisView.Grammar ? "an-tab-grammar" : "an-tab-vocabulary")">
        @if (View == AnalysisView.Grammar)
        {
            <GrammarFeedback Analysis="Analysis" OnlyIssues="@FilterActive" ShowReinforcement="ShowReinforcement" Toolbar="ToolbarContent"
                             Collapsed="collapsed" OnToggle="ToggleSentence" />
        }
        else
        {
            <VocabularyRecommendations Analysis="Vocabulary" Loading="VocabularyLoading" Error="@VocabularyError" Unavailable="@VocabularyUnavailable" OnRetry="OnRetryVocabulary" OnlyIssues="@FilterActive"
                                       Toolbar="ToolbarContent" Collapsed="collapsed" OnToggle="ToggleSentence" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TextResponse Analysis { get; set; } = default!;
    [Parameter] public AnalysisView View { get; set; }
    [Parameter] public EventCallback<AnalysisView> ViewChanged { get; set; }
    [Parameter] public VocabularyAnalysisResponse? Vocabulary { get; set; }
    [Parameter] public bool VocabularyLoading { get; set; }
    [Parameter] public string? VocabularyError { get; set; }
    // Motivo por el que el vocabulario no se verifica (p. ej. el análisis no se completó); no es un error reintentable.
    [Parameter] public string? VocabularyUnavailable { get; set; }
    [Parameter] public EventCallback OnRetryVocabulary { get; set; }
    /// <summary>Estudiantes: la pestaña de errores gramaticales enlaza al material de apoyo.</summary>
    [Parameter] public bool ShowReinforcement { get; set; }

    private ElementReference grammarTab, vocabularyTab;
    private bool onlyIssues;
    // Oraciones con el detalle plegado: se conserva al cambiar de pestaña o de filtro.
    private readonly HashSet<Guid> collapsed = [];

    private int GrammarCount => AnalysisFormat.ErrorCount(Analysis);

    // Oraciones con errores de la pestaña visible; el vocabulario solo se conoce una vez cargado.
    private int IssueSentences => View == AnalysisView.Grammar
        ? AnalysisFormat.SentencesWithErrors(Analysis)
        : Vocabulary?.Sentences.Count(sentence => sentence.Issues.Count > 0) ?? 0;

    // Oraciones de la pestaña visible que tienen detalle que plegar.
    private List<Guid> BodyIds => View == AnalysisView.Grammar
        ? Analysis.Sentences.Where(sentence => Math.Max(sentence.ErrorCount, sentence.Errors.Count) > 0).Select(sentence => sentence.Id).ToList()
        : Vocabulary?.Sentences.Where(sentence => sentence.Issues.Count > 0).Select(sentence => sentence.SentenceId).ToList() ?? [];
    private bool AllCollapsed => BodyIds.Count > 0 && BodyIds.All(collapsed.Contains);

    // El filtro solo tiene sentido si hay oraciones con y sin errores.
    private bool ShowFilter => (View == AnalysisView.Grammar || (Vocabulary is not null && !VocabularyLoading))
        && IssueSentences > 0 && IssueSentences < Analysis.Sentences.Count;
    private bool FilterActive => ShowFilter && onlyIssues;

    private void ToggleSentence(Guid id)
    {
        if (!collapsed.Remove(id)) collapsed.Add(id);
    }

    private void ToggleAll()
    {
        var ids = BodyIds;
        if (AllCollapsed) foreach (var id in ids) collapsed.Remove(id);
        else foreach (var id in ids) collapsed.Add(id);
    }

    // La barra (filtro y plegar todo) la ubica cada vista, después del resumen y justo antes de la lista.
    private RenderFragment ToolbarContent => __builder =>
    {
        if (!ShowFilter && BodyIds.Count == 0) return;
        <div class="an-toolbar">
            @if (ShowFilter)
            {
                <div class="an-filter" role="group" aria-label="@L["Filtrar oraciones"]">
                    <button type="button" class="an-chip" aria-pressed="@(onlyIssues ? "false" : "true")" @onclick="() => onlyIssues = false">Todas <span>@Analysis.Sentences.Count</span></button>
                    <button type="button" class="an-chip" aria-pressed="@(onlyIssues ? "true" : "false")" @onclick="() => onlyIssues = true">Con errores <span>@IssueSentences</span></button>
                </div>
            }
            @if (BodyIds.Count > 0)
            {
                <button type="button" class="an-collapse-all" @onclick="ToggleAll"><AnalysisIcon Name="chevron" Class="@(AllCollapsed ? "" : "an-up")" />@(AllCollapsed ? I18n.T("Mostrar detalles") : I18n.T("Ocultar detalles"))</button>
            }
        </div>
    };

    // Anuncio para lectores de pantalla cuando el filtro cambia la lista.
    private string LiveMessage => !ShowFilter ? "" : FilterActive
        ? I18n.T("Mostrando {0} {1} con errores de {2}.", IssueSentences, AnalysisFormat.Plural(IssueSentences, "oración", "oraciones"), Analysis.Sentences.Count)
        : I18n.T("Mostrando todas las oraciones ({0}).", Analysis.Sentences.Count);

    private string Selected(AnalysisView view) => View == view ? "true" : "false";
    private Task SelectAsync(AnalysisView view) => View == view ? Task.CompletedTask : ViewChanged.InvokeAsync(view);

    // Teclado de las pestañas: flechas izquierda/derecha cambian de pestaña y llevan el foco.
    private async Task KeyDownAsync(KeyboardEventArgs args)
    {
        var next = args.Key switch
        {
            "ArrowRight" => AnalysisView.Vocabulary,
            "ArrowLeft" => AnalysisView.Grammar,
            _ => View
        };
        if (next == View) return;
        await SelectAsync(next);
        await (next == AnalysisView.Grammar ? grammarTab : vocabularyTab).FocusAsync();
    }
}
