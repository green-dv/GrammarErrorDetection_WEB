@* Ícono pequeño según la familia de la categoría de error (tiempos, lugar, preguntas, modales, comparación, texto). *@
<svg class="category-glyph" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Kind)
    {
        case "time":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "place":
            <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />
            break;
        case "question":
            <circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7m0 3v.01" />
            break;
        case "modal":
            <path d="M13 2 4 14h7l-1 8 9-12h-7Z" />
            break;
        case "compare":
            <path d="M4 20V10m6 10V4m6 16v-7m4 7H2" />
            break;
        default:
            <path d="M4 19 9 5h1l5 14M6 14h7m4-5c2.5-1.5 5-.5 5 2v8m0-4c-1.5-1-5-1-5 1.5S20 21 22 18" />
            break;
    }
</svg>

@code {
    [Parameter] public string Kind { get; set; } = "text";
}
