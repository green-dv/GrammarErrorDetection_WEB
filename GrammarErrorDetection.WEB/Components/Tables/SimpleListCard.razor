@* Ficha compacta de los listados sencillos (aulas, niveles, módulos, categorías) para celular.
   Cabecera: recuadro opcional + nombre + estado. Cuerpo opcional. Pie: dato de contexto + acciones. *@
<li class="lcard lcard-simple @(Active ? "" : "is-inactive")">
    <div class="lcard-head">
        @if (BadgeValue is not null)
        {
            <span class="lcard-badge" aria-hidden="true"><b>@BadgeValue</b><small>@BadgeCaption</small></span>
        }
        <div class="lcard-who"><strong>@Title</strong>@if (Subtitle is not null) { <span>@Subtitle</span> }</div>
        <StatusPill Active="Active" On="@ActiveText" Off="@InactiveText" />
    </div>
    @ChildContent
    <div class="lcard-foot">
        @if (Detail is not null) { <span class="lcard-meta">@Detail</span> }
        @Actions
    </div>
</li>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public string ActiveText { get; set; } = I18n.T("Activo");
    [Parameter] public string InactiveText { get; set; } = I18n.T("Deshabilitado");
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    /// <summary>Recuadro con un número y su leyenda ("20" + "cupos"). Sin valor, no se dibuja.</summary>
    [Parameter] public string? BadgeValue { get; set; }
    [Parameter] public string? BadgeCaption { get; set; }
    [Parameter] public RenderFragment? Subtitle { get; set; }
    /// <summary>Bloque entre la cabecera y el pie (descripción, módulo siguiente…).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Detail { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
